{
  "name": "kitbash",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "bootstrap": "pnpm install && pnpm --filter @kitbash/container-go run deps",
    "workspace:map": "pnpm -r list --depth -1",
    "storybook": "pnpm --filter @kitbash/ui storybook",
    "build": "pnpm -r --workspace-concurrency=2 --if-present run build",
    "test": "pnpm -r --workspace-concurrency=2 --if-present run test",
    "test:core": "pnpm --filter \"./packages/*\" -r --if-present run test",
    "test:e2e": "pnpm -r --workspace-concurrency=1 --if-present run test:e2e",
    "test:docker": "node --test test-e2e/cloudflare-container-smoke.test.mjs",
    "test:coverage-guard": "pnpm --filter kitbash-recipe-workerd-coverage run test:guard",
    "typecheck": "pnpm -r --workspace-concurrency=2 --if-present run typecheck",
    "lint": "pnpm -r --workspace-concurrency=2 --if-present run lint",
    "validate": "pnpm -r --workspace-concurrency=2 --if-present run validate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate"
  }
}
