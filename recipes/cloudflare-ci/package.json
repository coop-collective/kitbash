{
  "name": "kitbash-recipe-cloudflare-ci",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "wrangler types --env staging && tsc --noEmit",
    "build": "wrangler deploy --dry-run",
    "ci:dry-run": "node scripts/ci-dry-run.mjs",
    "build:staging": "wrangler deploy --dry-run --env staging",
    "build:production": "wrangler deploy --dry-run --env production"
  },
  "devDependencies": {
    "wrangler": "4.137.0",
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  },
  "packageManager": "pnpm@12.14.0"
}
