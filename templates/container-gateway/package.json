{
  "name": "kit-template-container-gateway",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test test/*.test.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:docker": "docker build -t kit-container-gateway:test . && node test/docker-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.1"
  }
}
