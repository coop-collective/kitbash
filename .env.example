# pnpm run setup prompts for these values and writes an ignored, mode-0600 .env.
KIT_BROKER_HOSTNAME=secrets.example.com
CLOUDFLARE_ACCOUNT_ID=
KIT_BROKER_WORKER_NAME=kitbash-secrets-broker
KIT_BROKER_PRINCIPAL=grok-bot
KIT_BROKER_POLICY_FILE=broker.policy.json
KIT_BROKER_GITHUB_REPOSITORY=your-org/your-template-copy
KIT_BROKER_GITHUB_ENVIRONMENT=production
KIT_BROKER_CI_PROVIDER=github
# Optional: defaults to the repository owner. Credentials are private-repository organization settings.
# KIT_BROKER_GITHUB_ORGANIZATION=your-org

# Default CI uses organization secret CLOUDFLARE_API_TOKEN and organization
# variable CLOUDFLARE_ACCOUNT_ID. No application secrets go to GitHub.
# Existing organization credentials are reused; local deployment uses Wrangler login.
# Initial setup may accept CLOUDFLARE_API_TOKEN or create a deployment token using
# CLOUDFLARE_TOKEN_PROVISIONING_TOKEN. Neither token is saved to this file.
# pnpm run setup --skip-ci deploys locally without configuring GitHub credentials.

# Optional legacy CI vault (only with KIT_BROKER_CI_PROVIDER=infisical).
# KIT_BROKER_CI_PROJECT_ID=
# KIT_BROKER_CI_PROJECT_SLUG=
# KIT_BROKER_CI_DOMAIN=https://app.infisical.com
# KIT_BROKER_CI_ENVIRONMENT=production
# KIT_BROKER_CI_SECRET_PATH=/ci/kitbash-secrets-broker

# Cloudflare Secrets Store policy: separate runtime credential with Secrets Store Write.
# No Infisical identity is needed when every project uses cloudflare-secrets-store.
# KIT_BROKER_SECRETS_API_TOKEN=

# Optional Infisical application backend. Use Universal Auth, or set INFISICAL_TOKEN instead.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# INFISICAL_TOKEN=
# Optional separate operator identity with project role/identity/OIDC management
# and CI folder access. These credentials stay local and are not deployed.
# KIT_SETUP_INFISICAL_CLIENT_ID=
# KIT_SETUP_INFISICAL_CLIENT_SECRET=
# KIT_SETUP_INFISICAL_TOKEN=
# Needed only when policy enables GitHub Actions provisioning.
# GITHUB_TOKEN=
# Optional application deployment/sync credentials, separate from the broker's token.
# KIT_BROKER_APP_CLOUDFLARE_ACCOUNT_ID=
# KIT_BROKER_APP_CLOUDFLARE_API_TOKEN=
