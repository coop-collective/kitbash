  "dependencies": [
    "@cloudflare/containers@0.3.7"
  ],
  "devDependencies": [],
  "registryDependencies": [],
  "envVars": {},
  "env": [],
  "secrets": [],
  "bindings": [
    {
      "type": "durable_object",
      "name": "HASH_CONTAINER",
      "required": true,
      "note": "Declared in the block dedicated Wrangler config; tenant-scoped container routing."
    },
    {
      "type": "service",
      "name": "AUTH",
      "required": true,
      "note": "Existing authorization service; no credentials are forwarded to the container."
    }
  ],
  "migrations": [],
  "tables": [],
  "routes": [
    {
      "method": "POST",
      "path": "{{kit.routePath}}",
      "auth": "bearer",
      "description": "Dedicated Worker endpoint; authorize and hash up to 1 MiB."
    }
  ],
  "exports": [
    {
      "symbol": "HashContainer",
      "from": "shared/src/lib/cloudflare-container/worker.ts",
      "kind": "durable-object"
    },
    {
      "symbol": "gateway",
      "from": "shared/src/lib/cloudflare-container/gateway.ts",
      "kind": "function"
    }
  ],
  "ui": [],
  "tests": [
    {
      "file": "shared/test/gateway.test.mjs",
      "runner": "node",
      "covers": [
        "authorization",
        "tenant-routing",
        "actual-byte-bounds",
        "narrow-exposure",
        "credential-stripping"
      ]
    },
    {
      "file": "shared/test/docker-smoke.mjs",
      "runner": "node-docker",
      "covers": [
        "amd64-image",
        "non-root",
        "read-only",
        "tmpfs",
        "scratch-cleanup",
        "shutdown"
      ]
    }
  ],
  "verify": {
    "commands": [
      "node --test {{paths.tests}}/{{kit.serviceName}}-gateway.test.mjs",
      "npx tsc --noEmit"
    ],
    "expect": "all pass; native and Docker checks are explicit additional adoption commands"
  },
  "docs": "docs/README.md",
  "skill": "SKILL.md",
  "agent": {
    "summary": "One installable runtime block with Bun, Go and Rust variants. Dedicated Wrangler config exposes one authorized tenant-scoped operation. Ships native sources, private package tasks, non-root Dockerfile, bounded scratch and tests. Host main is unchanged.",
    "when_to_use": [
      "A Worker needs a Linux process or native tool behind an authenticated narrow interface."
    ],
    "when_not_to_use": [
      "Pure Worker code is sufficient.",
      "A public arbitrary path/port proxy or an untrusted code execution sandbox is required."
    ],
    "adapt": [
      {
        "id": "auth-service",
        "required": true,
        "title": "Connect the operation authorization service",
        "where": "container.{{kit.serviceName}}.wrangler.jsonc",
        "do": "The AUTH service must validate credentials and permission for this operation and return {tenantId}. Return a non-2xx status to deny. Do not accept a tenant from caller-controlled headers.",
        "check": "Unauthorized calls never start or reach a container."
      },
      {
        "id": "runtime",
        "required": true,
        "title": "Install native dependencies and run runtime checks",
        "where": "containers/{{kit.serviceName}}",
        "do": "Run pnpm install and pnpm test/typecheck/build here. Use Node22.18+, Go1.26.4 or Rust1.96.0 as selected; pnpm manages the pinned Bun runtime. Commit the generated standalone pnpm lockfile. Run the installed Docker smoke explicitly with a working Docker engine.",
        "check": "Native tests, amd64 image smoke and dedicated Wrangler dry-run pass."
      },
      {
        "id": "deploy-config",
        "required": true,
        "title": "Use the dedicated Wrangler configuration",
        "where": "container.{{kit.serviceName}}.wrangler.jsonc",
        "do": "Run wrangler dev or deploy with -c container.{{kit.serviceName}}.wrangler.jsonc. Its main exports the Container class. The host root Worker config is not replaced.",
        "check": "Wrangler reports AUTH and HASH_CONTAINER for this dedicated Worker."
      }
    ],
    "author_notes": "Native payload source is not parameterized: port8080, 1MiB input and two concurrent jobs. Scratch prefers verified Linux tmpfs but falls back to writable ephemeral disk. Docker flags in the smoke are local checks, not promises about Cloudflare mount/rights configuration."
  },
