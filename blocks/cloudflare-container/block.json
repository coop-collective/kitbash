{
  "$schema": "https://kitbash.dev/schema/block.v1.json",
  "name": "cloudflare-container",
  "type": "registry:block",
  "title": "Authenticated Cloudflare Containers in Bun, Go or Rust",
  "description": "Installable Wrangler gateway and non-root Bun/Go/Rust container with tenant routing, bounded input, private temporary jobs, cleanup and runtime tests.",
  "author": "Coop <coop@xavalabs.com>",
  "version": "2.0.0",
  "license": "MIT",
  "categories": [
    "containers",
    "cloudflare",
    "bun",
    "go",
    "rust"
  ],
  "meta": {
    "maturity": "beta",
    "origin": "original",
    "est_hours_saved": 8
  },
  "stack": {
    "runtime": "cloudflare-workers",
    "framework": "hono",
    "db": "d1",
    "ui": "none",
    "lang": "ts",
    "test": "node"
  },
  "compat": {
    "wrangler": ">=4.151.1",
    "node": ">=22.18"
  },
  "variants": [
    {
      "id": "bun",
      "default": true,
      "root": "variants/bun",
      "stack": {
        "framework": "hono"
      }
    },
    {
      "id": "go",
      "default": false,
      "root": "variants/go",
      "stack": {
        "framework": "hono"
      }
    },
    {
      "id": "rust",
      "default": false,
      "root": "variants/rust",
      "stack": {
        "framework": "hono"
      }
    }
  ],
  "params": [
    {
      "name": "serviceName",
      "type": "identifier",
      "default": "hash",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "Names the dedicated Worker config, container payload directory and verification files."
    },
    {
      "name": "routePath",
      "type": "path",
      "default": "/hash",
      "pattern": "^/[a-z][a-z0-9-]{0,39}$",
      "description": "The one public POST operation; container path stays /hash."
    },
    {
      "name": "authService",
      "type": "identifier",
      "default": "container-auth",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "Existing Worker service that authorizes this operation and returns a trusted tenantId."
    },
    {
      "name": "maxInstances",
      "type": "integer",
      "default": 5,
      "min": 1,
      "max": 10,
      "description": "Container fleet cap, separate from per-instance job concurrency."
    }
  ],
