{
  "$schema": "https://kitbash.dev/schema/block.v1.json",
  "name": "public-edge-cache",
  "type": "registry:block",
  "title": "Explicit public GET caching behind a Worker gateway",
  "description": "A conservative Cache API fallback with exact route and query policies, credential bypass, response eligibility checks, bounded TTL and streamed background writes.",
  "author": "Coop <coop@xavalabs.com>",
  "version": "1.0.0",
  "license": "MIT",
  "categories": [
    "cache",
    "cloudflare"
  ],
  "meta": {
    "maturity": "beta",
    "origin": "original",
    "est_hours_saved": 3
  },
  "stack": {
    "runtime": "cloudflare-workers",
    "framework": "hono",
    "db": "d1",
    "ui": "none",
    "lang": "ts",
    "test": "vitest-workerd"
  },
  "compat": {
    "hono": ">=4.6",
    "wrangler": ">=4",
    "node": ">=20",
    "typescript": ">=5.4"
  },
  "variants": [
    {
      "id": "hono-d1",
      "default": true,
      "root": "variants/hono-d1",
      "stack": {
        "framework": "hono"
      }
    }
  ],
  "params": [
    {
      "name": "cacheNamespace",
      "type": "identifier",
      "default": "public",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "Namespace in synthetic cache paths."
    },
    {
      "name": "maxTtlSeconds",
      "type": "integer",
      "default": 60,
      "min": 1,
      "max": 86400,
      "description": "Hard upper bound on stored response lifetime."
    }
  ],
  "files": [
    {
      "path": "src/public-edge-cache.ts",
      "type": "registry:lib",
      "target": "{{paths.lib}}/public-edge-cache.ts",
      "role": "service",
      "variant": "hono-d1"
    },
    {
      "path": "test/public-edge-cache.test.ts",
      "type": "registry:file",
      "target": "{{paths.tests}}/public-edge-cache.test.ts",
      "role": "test",
      "variant": "hono-d1"
    },
    {
      "path": "SKILL.md",
      "type": "registry:file",
      "target": ".kit/blocks/public-edge-cache/SKILL.md",
      "role": "doc"
    }
  ],
  "dependencies": [],
  "devDependencies": [],
  "registryDependencies": [],
  "envVars": {},
  "env": [],
  "secrets": [],
