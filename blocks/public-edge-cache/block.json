  "routes": [],
  "exports": [
    {
      "symbol": "publicCacheKey",
      "from": "src/public-edge-cache.ts",
      "kind": "function"
    },
    {
      "symbol": "withPublicEdgeCache",
      "from": "src/public-edge-cache.ts",
      "kind": "function"
    }
  ],
  "ui": [],
  "tests": [
    {
      "file": "test/public-edge-cache.test.ts",
      "runner": "vitest-workerd",
      "covers": [
        "real-cache-api",
        "public-only",
        "key-safety",
        "ttl",
        "failure-fallback"
      ]
    }
  ],
  "verify": {
    "commands": [
      "npx vitest run {{paths.tests}}/public-edge-cache.test.ts",
      "npx tsc --noEmit"
    ],
    "expect": "all pass"
  },
  "docs": "docs/README.md",
  "skill": "SKILL.md",
  "agent": {
    "summary": "Explicit Cache API fallback for public GET responses behind a Worker gateway. Conservative identity and response guards, exact query policies, versioned keys and real workerd tests. Prefer Workers Cache for compatible new applications.",
    "when_to_use": [
      "An existing gateway must execute before every cache lookup and needs explicit local cache control."
    ],
    "when_not_to_use": [
      "Personalized responses or globally consistent invalidation.",
      "New designs that can use current Workers Cache cached inner entrypoints."
    ],
    "adapt": [
      {
        "id": "wire-policy",
        "required": true,
        "title": "Declare public representations after the gateway",
        "where": "Worker fetch handler",
        "do": "Call withPublicEdgeCache after access checks; pass exact public paths, query keys, version and producer.",
        "check": "Credentialed requests bypass; repeated anonymous GETs reuse the representation."
      }
    ],
    "author_notes": "No tiered caching, global purge, SWR or distributed collapse. Header-independent public representation is the application contract."
  },
