import { Hono, type Context, type MiddlewareHandler } from 'hono';

type TeamEnv = { Bindings: Env; Variables: { userId: string; sessionId: string; sessionExpires: number } };
type TC = Context<TeamEnv>;

interface Deps {
  requireAuth: MiddlewareHandler<any>;
  readBounded: (req: Request, limit: number) => Promise<Uint8Array | null>;
  readJson: (c: any) => Promise<Record<string, unknown> | null>;
  maxUpload: number;
}

// The demo application only has these two accounts; membership targets must be one of them.
const KNOWN_USERS = new Set(['user_alice', 'user_bob']);
const ROOM_RE = /^[A-Za-z0-9_-]{1,40}$/;
const LEASE_S = 5 * 60;

export const teamRoutes = (deps: Deps) => {
  const t = new Hono<TeamEnv>();

  t.use('*', deps.requireAuth);

  // Membership is always read from D1 (never cached) so removals take effect immediately.
  const roleOf = async (c: TC, teamId: string): Promise<string | null> => {
    const row = await c.env.DB.prepare('SELECT role FROM team_members WHERE team_id = ? AND user_id = ?')
      .bind(teamId, c.get('userId'))
      .first<{ role: string }>();
    return row?.role ?? null;
  };

  t.post('/', async (c) => {
    const body = await deps.readJson(c);
    if (!body || typeof body.name !== 'string') return c.json({ error: 'invalid name' }, 400);
    const name = body.name.trim();
    if (name.length < 1 || name.length > 80) return c.json({ error: 'invalid name' }, 400);
    const id = crypto.randomUUID();
    const userId = c.get('userId');
    const now = Math.floor(Date.now() / 1000);
    await c.env.DB.batch([
      c.env.DB.prepare('INSERT INTO teams (id, name, owner_id, created_at) VALUES (?, ?, ?, ?)').bind(id, name, userId, now),
      c.env.DB.prepare("INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'owner', ?)").bind(id, userId, now),
    ]);
    return c.json({ id, name }, 201);
  });

  t.get('/', async (c) => {
    const { results } = await c.env.DB.prepare(
      'SELECT t.id, t.name, m.role FROM team_members m JOIN teams t ON t.id = m.team_id WHERE m.user_id = ? ORDER BY t.created_at, t.id',
    )
      .bind(c.get('userId'))
      .all<{ id: string; name: string; role: string }>();
    c.header('Cache-Control', 'private, no-store');
    return c.json({ teams: results });
  });

  // ---- membership (owner only) ----

  type Managed = { res: Response; teamId?: undefined; target?: undefined } | { res?: undefined; teamId: string; target: string };
  const manage = async (c: TC): Promise<Managed> => {
    const teamId = c.req.param('team')!;
    if ((await roleOf(c, teamId)) !== 'owner') return { res: c.json({ error: 'forbidden' }, 403) };
    const target = c.req.param('userId')!;
    if (!KNOWN_USERS.has(target)) return { res: c.json({ error: 'unknown user' }, 400) };
    const owner = await c.env.DB.prepare('SELECT 1 AS x FROM team_members WHERE team_id = ? AND user_id = ? AND role = ?')
      .bind(teamId, target, 'owner')
      .first();
    if (owner) return { res: c.json({ error: 'owner membership is fixed' }, 409) };
    return { teamId, target };
  };

  t.put('/:team/members/:userId', async (c) => {
    const m = await manage(c);
    if (m.res) return m.res;
    const body = await deps.readJson(c);
    if (!body || body.role !== 'member') return c.json({ error: 'invalid role' }, 400);
    await c.env.DB.prepare(
      "INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'member', ?) ON CONFLICT(team_id, user_id) DO UPDATE SET role = 'member' WHERE role <> 'owner'",
    )
      .bind(m.teamId, m.target, Math.floor(Date.now() / 1000))
      .run();
    return c.body(null, 204);
  });

  t.delete('/:team/members/:userId', async (c) => {
    const m = await manage(c);
    if (m.res) return m.res;
    await c.env.DB.prepare("DELETE FROM team_members WHERE team_id = ? AND user_id = ? AND role <> 'owner'").bind(m.teamId, m.target).run();
    return c.body(null, 204);
  });

  // ---- shared uploads ----

  t.post('/:team/uploads', async (c) => {
    const teamId = c.req.param('team');
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const data = await deps.readBounded(c.req.raw, deps.maxUpload);
    if (!data) return c.json({ error: 'too large' }, 413);
    const id = crypto.randomUUID();
    const key = `teams/${teamId}/${id}`;
    await c.env.UPLOADS.put(key, data, { httpMetadata: { contentType: 'application/octet-stream' } });
    try {
      await c.env.DB.prepare(
        'INSERT INTO team_uploads (id, team_id, uploaded_by, object_key, size, content_type, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)',
      )
        .bind(id, teamId, c.get('userId'), key, data.byteLength, 'application/octet-stream', Math.floor(Date.now() / 1000))
        .run();
    } catch (e) {
      await c.env.UPLOADS.delete(key);
      throw e;
    }
    return c.json({ id }, 201);
  });

  const findFile = (c: TC, teamId: string) =>
    c.env.DB.prepare('SELECT id FROM team_uploads WHERE id = ? AND team_id = ?').bind(c.req.param('id'), teamId).first<{ id: string }>();

  t.get('/:team/uploads/:id', async (c) => {
    const teamId = c.req.param('team');
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const row = await findFile(c, teamId);
    // The key is derived from the verified team and the server-generated id, never from client input alone.
    const obj = row ? await c.env.UPLOADS.get(`teams/${teamId}/${row.id}`) : null;
    if (!obj) return c.json({ error: 'not found' }, 404);
    return new Response(obj.body, {
      headers: {
        'Content-Type': 'application/octet-stream',
        'Content-Length': String(obj.size),
        'Content-Disposition': 'attachment; filename="download.bin"',
        'X-Content-Type-Options': 'nosniff',
        'Cache-Control': 'private, no-store',
      },
    });
  });

  t.delete('/:team/uploads/:id', async (c) => {
    const teamId = c.req.param('team');
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const row = await findFile(c, teamId);
    if (!row) return c.json({ error: 'not found' }, 404);
    await c.env.DB.prepare('DELETE FROM team_uploads WHERE id = ? AND team_id = ?').bind(row.id, teamId).run();
    await c.env.UPLOADS.delete(`teams/${teamId}/${row.id}`);
    return c.body(null, 204);
  });

  // ---- room websocket ----

  t.get('/:team/rooms/:room/ws', async (c) => {
    const url = new URL(c.req.url);
    if (c.req.url.includes('?') || url.search) return c.json({ error: 'query not allowed' }, 400);
    const origin = c.req.header('Origin');
    if (!origin || origin !== url.origin) return c.json({ error: 'bad origin' }, 403);
    const teamId = c.req.param('team');
    const room = c.req.param('room');
    if (!ROOM_RE.test(room)) return c.json({ error: 'invalid room' }, 400);
    if (c.req.header('Upgrade')?.toLowerCase() !== 'websocket') return c.json({ error: 'expected websocket' }, 426);
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);

    const now = Math.floor(Date.now() / 1000);
    const leaseExpires = Math.min(now + LEASE_S, c.get('sessionExpires'));
    // Fresh header set: nothing client-supplied is forwarded, so identity headers cannot be spoofed.
    const headers = new Headers({
      Upgrade: 'websocket',
      'X-Room-User': c.get('userId'),
      'X-Room-Session': c.get('sessionId'),
      'X-Room-Team': teamId,
      'X-Room-Lease': String(leaseExpires),
    });
    const stub = c.env.ROOMS.get(c.env.ROOMS.idFromName(`${teamId}:${room}`));
    return stub.fetch('https://room.internal/connect', { headers });
  });

  return t;
};
