import { describe, expect, it } from 'vitest';
import { SELF } from 'cloudflare:test';

const BASE = 'http://localhost';
const post = (path: string, body: unknown, headers: Record<string, string> = {}) =>
  SELF.fetch(BASE + path, { method: 'POST', headers: { Origin: BASE, 'Content-Type': 'application/json', ...headers }, body: JSON.stringify(body) });

async function login(email: string) {
  const r = await post('/api/login', { email, password: 'local-demo-password' });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

const authed = (cookie: string, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, { ...init, headers: { Origin: BASE, Cookie: cookie, ...(init.headers as object) } });

const json = (method: string, body: unknown): RequestInit => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

async function createTeam(cookie: string, name: string) {
  const r = await authed(cookie, '/api/teams', json('POST', { name }));
  expect(r.status).toBe(201);
  return (await r.json()) as { id: string; name: string };
}

const addMember = (cookie: string, team: string, user: string) => authed(cookie, `/api/teams/${team}/members/${user}`, json('PUT', { role: 'member' }));

async function openRoom(cookie: string, team: string, room = 'general', headers: Record<string, string> = {}) {
  const res = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/${room}/ws`, {
    headers: { Upgrade: 'websocket', Origin: BASE, Cookie: cookie, ...headers },
  });
  return res;
}

/** Connect and return a socket plus a queue-based reader for JSON events. */
async function connect(cookie: string, team: string, room = 'general', headers: Record<string, string> = {}) {
  const res = await openRoom(cookie, team, room, headers);
  expect(res.status).toBe(101);
  const ws = res.webSocket!;
  const events: any[] = [];
  const waiters: Array<() => void> = [];
  ws.addEventListener('message', (e) => {
    events.push(JSON.parse(e.data as string));
    waiters.splice(0).forEach((w) => w());
  });
  ws.accept();
  const next = async (pred: (e: any) => boolean = () => true, timeout = 5000) => {
    const start = Date.now();
    for (;;) {
      const i = events.findIndex(pred);
      if (i >= 0) return events.splice(i, 1)[0];
      if (Date.now() - start > timeout) throw new Error('timeout waiting for event');
      await new Promise<void>((r) => {
        waiters.push(r);
        setTimeout(r, 50);
      });
    }
  };
  return { ws, events, next };
}

describe('teams', () => {
  it('requires auth and same origin, validates names, lists only own teams', async () => {
    expect((await SELF.fetch(BASE + '/api/teams')).status).toBe(401);
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    expect((await SELF.fetch(BASE + '/api/teams', { method: 'POST', headers: { Cookie: a }, body: '{"name":"x"}' })).status).toBe(403);
    expect((await authed(a, '/api/teams', json('POST', { name: '   ' }))).status).toBe(400);
    expect((await authed(a, '/api/teams', json('POST', { name: 'x'.repeat(81) }))).status).toBe(400);
    expect((await authed(a, '/api/teams', json('POST', { name: 5 }))).status).toBe(400);
    const t = await createTeam(a, '  Alpha Team  ');
    expect(t.name).toBe('Alpha Team');
    const mine = (await (await authed(a, '/api/teams')).json()) as any;
    expect(mine.teams).toContainEqual({ id: t.id, name: 'Alpha Team', role: 'owner' });
    const theirs = (await (await authed(b, '/api/teams')).json()) as any;
    expect(theirs.teams.find((x: any) => x.id === t.id)).toBeUndefined();
  });

  it('lets only the owner manage membership, and reads are never stale', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const t = await createTeam(a, 'Members');
    const path = (u: string) => `/api/teams/${t.id}/members/${u}`;
    expect((await authed(b, path('user_bob'), json('PUT', { role: 'member' }))).status).toBe(403);
    expect((await authed(a, path('user_mallory'), json('PUT', { role: 'member' }))).status).toBe(400);
    expect((await authed(a, path('user_alice'), json('PUT', { role: 'member' }))).status).toBe(409);
    expect((await authed(a, path('user_alice'), { method: 'DELETE' })).status).toBe(409);
    expect((await authed(a, path('user_bob'), json('PUT', { role: 'admin' }))).status).toBe(400);
    expect((await addMember(a, t.id, 'user_bob')).status).toBe(204);
    expect((await addMember(a, t.id, 'user_bob')).status).toBe(204);
    const bobTeams = (await (await authed(b, '/api/teams')).json()) as any;
    expect(bobTeams.teams).toContainEqual({ id: t.id, name: 'Members', role: 'member' });
    // a member cannot manage
    expect((await authed(b, path('user_bob'), { method: 'DELETE' })).status).toBe(403);
    expect((await authed(a, path('user_bob'), { method: 'DELETE' })).status).toBe(204);
    const after = (await (await authed(b, '/api/teams')).json()) as any;
    expect(after.teams.find((x: any) => x.id === t.id)).toBeUndefined();
  });
});

describe('team uploads', () => {
  it('shares bytes among members only, scoped per team', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const t1 = await createTeam(a, 'Files one');
    const t2 = await createTeam(a, 'Files two');
    const bytes = new Uint8Array([0, 1, 2, 255, 254, 60, 115]);
    const up = (cookie: string, team: string, body: BodyInit) => authed(cookie, `/api/teams/${team}/uploads`, { method: 'POST', headers: { 'Content-Type': 'text/html' }, body });

    expect((await up(b, t1.id, bytes)).status).toBe(403);
    expect((await SELF.fetch(`${BASE}/api/teams/${t1.id}/uploads`, { method: 'POST', headers: { Origin: BASE }, body: bytes })).status).toBe(401);
    await addMember(a, t1.id, 'user_bob');

    const created = await up(a, t1.id, bytes);
    expect(created.status).toBe(201);
    const { id } = (await created.json()) as { id: string };

    const dl = await authed(b, `/api/teams/${t1.id}/uploads/${id}`);
    expect(dl.status).toBe(200);
    expect(new Uint8Array(await dl.arrayBuffer())).toEqual(bytes);
    expect(dl.headers.get('Content-Type')).toBe('application/octet-stream');
    expect(dl.headers.get('Content-Disposition')).toContain('attachment');
    expect(dl.headers.get('X-Content-Type-Options')).toBe('nosniff');
    expect(dl.headers.get('Cache-Control')).toBe('private, no-store');

    // the id is not valid under another team, and cannot be used to delete bytes
    expect((await authed(a, `/api/teams/${t2.id}/uploads/${id}`)).status).toBe(404);
    expect((await authed(a, `/api/teams/${t2.id}/uploads/${id}`, { method: 'DELETE' })).status).toBe(404);
    expect((await authed(a, `/api/teams/${t1.id}/uploads/${id}`)).status).toBe(200);

    // personal uploads stay private and unaffected
    const personal = await authed(a, '/api/uploads', { method: 'POST', body: bytes });
    const pid = ((await personal.json()) as any).id;
    expect((await authed(a, `/api/teams/${t1.id}/uploads/${pid}`)).status).toBe(404);
    expect((await authed(b, `/api/uploads/${pid}`)).status).toBe(404);

    // removed members lose access immediately
    await authed(a, `/api/teams/${t1.id}/members/user_bob`, { method: 'DELETE' });
    expect((await authed(b, `/api/teams/${t1.id}/uploads/${id}`)).status).toBe(403);
    await addMember(a, t1.id, 'user_bob');
    expect((await authed(b, `/api/teams/${t1.id}/uploads/${id}`, { method: 'DELETE' })).status).toBe(204);
    expect((await authed(a, `/api/teams/${t1.id}/uploads/${id}`)).status).toBe(404);
  });

  it('bounds declared and chunked bodies', async () => {
    const a = await login('alice@example.test');
    const t = await createTeam(a, 'Bounded');
    const path = `/api/teams/${t.id}/uploads`;
    expect((await authed(a, path, { method: 'POST', body: new Uint8Array(1024 * 1024) })).status).toBe(201);
    expect((await authed(a, path, { method: 'POST', body: new Uint8Array(1024 * 1024 + 1) })).status).toBe(413);
    const chunk = new Uint8Array(256 * 1024);
    const stream = (n: number) =>
      new ReadableStream({
        pull(controller) {
          if (n-- > 0) controller.enqueue(chunk);
          else controller.close();
        },
      });
    const chunked = await authed(a, path, { method: 'POST', body: stream(5), duplex: 'half' } as RequestInit);
    expect(chunked.status).toBe(413);
    const ok = await authed(a, path, { method: 'POST', body: stream(2), duplex: 'half' } as RequestInit);
    expect(ok.status).toBe(201);
  });
});

describe('room websocket', () => {
  it('rejects unauthenticated, foreign-origin, query, bad-room and non-member handshakes', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const t = await createTeam(a, 'Handshake');
    const url = (room: string, q = '') => `${BASE}/api/teams/${t.id}/rooms/${room}/ws${q}`;
    const h = (extra: Record<string, string> = {}) => ({ Upgrade: 'websocket', Origin: BASE, Cookie: a, ...extra });
    expect((await SELF.fetch(url('general'), { headers: { Upgrade: 'websocket', Origin: BASE } })).status).toBe(401);
    expect((await SELF.fetch(url('general'), { headers: h({ Origin: 'http://evil.test' }) })).status).toBe(403);
    expect((await SELF.fetch(url('general'), { headers: h({ Origin: 'null' }) })).status).toBe(403);
    const noOrigin = h();
    delete (noOrigin as any).Origin;
    expect((await SELF.fetch(url('general'), { headers: noOrigin })).status).toBe(403);
    expect((await SELF.fetch(url('general', '?x=1'), { headers: h() })).status).toBe(400);
    expect((await SELF.fetch(url('bad.room'), { headers: h() })).status).toBe(400);
    expect((await SELF.fetch(url('x'.repeat(41)), { headers: h() })).status).toBe(400);
    expect((await SELF.fetch(url('general'), { headers: h({ Cookie: b }) })).status).toBe(403);
    const ok = await SELF.fetch(url('general'), { headers: h() });
    expect(ok.status).toBe(101);
    ok.webSocket!.accept();
    ok.webSocket!.close();
  });

  it('broadcasts persisted messages with verified identity and snapshots history', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const t = await createTeam(a, 'Chat');
    await addMember(a, t.id, 'user_bob');

    // spoofed identity headers must not change who the sender is
    const ca = await connect(a, t.id, 'review-1', { 'X-User-Id': 'user_bob', 'X-Room-User': 'user_bob', 'X-Room-Team': 'other' });
    expect((await ca.next((e) => e.type === 'snapshot')).messages).toEqual([]);
    const cb = await connect(b, t.id, 'review-1');
    await cb.next((e) => e.type === 'snapshot');

    ca.ws.send(JSON.stringify({ text: 'hello <b>bold</b>' }));
    const m1a = await ca.next((e) => e.type === 'message');
    const m1b = await cb.next((e) => e.type === 'message');
    expect(m1a).toEqual(m1b);
    expect(m1a).toMatchObject({ userId: 'user_alice', text: 'hello <b>bold</b>' });
    expect(m1a.seq).toBeGreaterThan(0);

    // concurrent messages each appear exactly once, in strictly increasing order
    for (let i = 0; i < 10; i++) {
      ca.ws.send(JSON.stringify({ text: `a${i}` }));
      cb.ws.send(JSON.stringify({ text: `b${i}` }));
    }
    const seen: any[] = [];
    for (let i = 0; i < 20; i++) seen.push(await ca.next((e) => e.type === 'message'));
    const seqs = seen.map((m) => m.seq);
    expect(new Set(seqs).size).toBe(20);
    expect([...seqs].sort((x, y) => x - y)).toEqual(seqs);
    expect(seen.filter((m) => m.userId === 'user_bob')).toHaveLength(10);

    // invalid input is rejected and not stored
    for (const bad of ['not json', '[]', '{"text":"   "}', '{"text":5}', JSON.stringify({ text: 'x'.repeat(1001) }), JSON.stringify({ text: 'y', pad: 'z'.repeat(5000) })]) {
      ca.ws.send(bad);
      expect((await ca.next((e) => e.type === 'error')).type).toBe('error');
    }
    ca.ws.send(new Uint8Array([1, 2, 3]));
    await ca.next((e) => e.type === 'error');

    ca.ws.close();
    cb.ws.close();

    const late = await connect(b, t.id, 'review-1');
    const snap = await late.next((e) => e.type === 'snapshot');
    expect(snap.messages).toHaveLength(21);
    expect(snap.messages.map((m: any) => m.seq)).toEqual([...snap.messages.map((m: any) => m.seq)].sort((x: number, y: number) => x - y));
    expect(snap.messages.some((m: any) => m.text === 'y' || m.text.length > 1000)).toBe(false);
    late.ws.close();

    // another room is independent
    const other = await connect(a, t.id, 'review-2');
    expect((await other.next((e) => e.type === 'snapshot')).messages).toEqual([]);
    other.ws.close();
  });

  it('caps the snapshot at 50 and handles a sustained 60-message run', async () => {
    const a = await login('alice@example.test');
    const t = await createTeam(a, 'Long');
    const c = await connect(a, t.id, 'general');
    await c.next((e) => e.type === 'snapshot');
    for (let i = 0; i < 60; i++) {
      c.ws.send(JSON.stringify({ text: `m${i}` }));
      await new Promise((r) => setTimeout(r, 100));
    }
    let last = 0;
    for (let i = 0; i < 60; i++) last = (await c.next((e) => e.type === 'message')).seq;
    expect(last).toBe(60);
    c.ws.close();
    const again = await connect(a, t.id, 'general');
    const snap = await again.next((e) => e.type === 'snapshot');
    expect(snap.messages).toHaveLength(50);
    expect(snap.messages[0].seq).toBe(11);
    expect(snap.messages[49].seq).toBe(60);
    again.ws.close();
  }, 30000);

  it('honors logout and membership removal for new handshakes', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const t = await createTeam(a, 'Revocation');
    await addMember(a, t.id, 'user_bob');
    const live = await connect(b, t.id);
    await live.next((e) => e.type === 'snapshot');
    live.ws.close();

    await authed(a, `/api/teams/${t.id}/members/user_bob`, { method: 'DELETE' });
    expect((await openRoom(b, t.id)).status).toBe(403);
    await addMember(a, t.id, 'user_bob');
    expect((await openRoom(b, t.id)).status).toBe(101);
    expect((await authed(b, '/api/logout', { method: 'POST' })).status).toBe(204);
    expect((await openRoom(b, t.id)).status).toBe(401);
  });

  it('lets an already-authorized socket finish work inside its lease', async () => {
    // Documents the phase-one lease: removal blocks new handshakes (tested above) but an
    // established socket stays valid until its lease (<= 5 min) runs out. Expiry itself is not
    // simulated here because the lease is derived from the wall clock.
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const t = await createTeam(a, 'Lease');
    await addMember(a, t.id, 'user_bob');
    const cb = await connect(b, t.id);
    await cb.next((e) => e.type === 'snapshot');
    await authed(a, `/api/teams/${t.id}/members/user_bob`, { method: 'DELETE' });
    cb.ws.send(JSON.stringify({ text: 'within lease' }));
    expect((await cb.next((e) => e.type === 'message')).text).toBe('within lease');
    cb.ws.close();
    expect((await openRoom(b, t.id)).status).toBe(403);
  });
});
