import { describe, expect, it } from 'vitest';
import { SELF } from 'cloudflare:test';

const BASE = 'http://localhost';
const json = { 'Content-Type': 'application/json' };

async function login(email: string) {
  const r = await SELF.fetch(BASE + '/api/login', { method: 'POST', headers: { Origin: BASE, ...json }, body: JSON.stringify({ email, password: 'local-demo-password' }) });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

const call = (cookie: string | null, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, { ...init, headers: { Origin: BASE, ...(cookie ? { Cookie: cookie } : {}), ...(init.headers as object) } });

const send = (cookie: string | null, method: string, path: string, body?: unknown) =>
  call(cookie, path, { method, headers: json, body: body === undefined ? undefined : JSON.stringify(body) });

async function newTeam(cookie: string, name = 'Reviewers') {
  const r = await send(cookie, 'POST', '/api/teams', { name });
  expect(r.status).toBe(201);
  return ((await r.json()) as { id: string }).id;
}

async function openRoom(cookie: string, team: string, room = 'general', headers: Record<string, string> = {}) {
  const r = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/${room}/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: cookie, ...headers } });
  expect(r.status).toBe(101);
  const ws = r.webSocket!;
  const events: any[] = [];
  ws.addEventListener('message', (e) => { events.push(JSON.parse(e.data as string)); });
  ws.accept();
  return { ws, events };
}

const until = async (cond: () => boolean) => {
  for (let i = 0; i < 200 && !cond(); i++) await new Promise((r) => setTimeout(r, 25));
  expect(cond()).toBe(true);
};

describe('teams and membership', () => {
  it('creates, lists and manages members', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    expect((await send(null, 'POST', '/api/teams', { name: 'x' })).status).toBe(401);
    expect((await send(a, 'POST', '/api/teams', { name: '   ' })).status).toBe(400);
    expect((await send(a, 'POST', '/api/teams', { name: 'n'.repeat(81) })).status).toBe(400);
    const created = await send(a, 'POST', '/api/teams', { name: '  Core  ' });
    expect(created.status).toBe(201);
    const team = (await created.json()) as { id: string; name: string };
    expect(team.name).toBe('Core');

    const list = async (c: string) => ((await (await call(c, '/api/teams')).json()) as any).teams as any[];
    expect(await list(a)).toContainEqual({ id: team.id, name: 'Core', role: 'owner' });
    expect((await list(b)).some((t) => t.id === team.id)).toBe(false);

    const path = `/api/teams/${team.id}/members/user_bob`;
    expect((await send(b, 'PUT', path, { role: 'member' })).status).toBe(403);
    expect((await send(a, 'PUT', `/api/teams/${team.id}/members/user_eve`, { role: 'member' })).status).toBe(400);
    expect((await send(a, 'PUT', `/api/teams/${team.id}/members/user_alice`, { role: 'member' })).status).toBe(409);
    expect((await send(a, 'DELETE', `/api/teams/${team.id}/members/user_alice`)).status).toBe(409);
    expect((await send(a, 'PUT', path, { role: 'member' })).status).toBe(204);
    expect((await send(a, 'PUT', path, { role: 'member' })).status).toBe(204);
    expect(await list(b)).toContainEqual({ id: team.id, name: 'Core', role: 'member' });
    expect((await send(b, 'DELETE', `/api/teams/${team.id}/members/user_alice`)).status).toBe(403);
    expect((await send(a, 'DELETE', path)).status).toBe(204);
    expect((await list(b)).some((t) => t.id === team.id)).toBe(false);
    // Mutations need a same-origin Origin header.
    const r = await SELF.fetch(BASE + '/api/teams', { method: 'POST', headers: { ...json, Cookie: a, Origin: 'http://evil.test' }, body: '{"name":"z"}' });
    expect(r.status).toBe(403);
  });
});

describe('team uploads', () => {
  it('shares files between members and isolates teams', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const t1 = await newTeam(a, 'One');
    const t2 = await newTeam(a, 'Two');
    await send(a, 'PUT', `/api/teams/${t1}/members/user_bob`, { role: 'member' });
    const bytes = new Uint8Array([0, 255, 1, 254, 60, 115]);
    const up = await call(a, `/api/teams/${t1}/uploads`, { method: 'POST', body: bytes });
    expect(up.status).toBe(201);
    const { id } = (await up.json()) as { id: string };

    const dl = await call(b, `/api/teams/${t1}/uploads/${id}`);
    expect(dl.status).toBe(200);
    expect(new Uint8Array(await dl.arrayBuffer())).toEqual(bytes);
    expect(dl.headers.get('Content-Type')).toBe('application/octet-stream');
    expect(dl.headers.get('Content-Disposition')).toContain('attachment');
    expect(dl.headers.get('X-Content-Type-Options')).toBe('nosniff');
    expect(dl.headers.get('Cache-Control')).toBe('private, no-store');

    // Same id under another team, or by a non-member, exposes nothing.
    expect((await call(a, `/api/teams/${t2}/uploads/${id}`)).status).toBe(404);
    expect((await call(a, `/api/teams/${t2}/uploads/${id}`, { method: 'DELETE' })).status).toBe(404);
    expect((await call(b, `/api/teams/${t2}/uploads/${id}`)).status).toBe(403);
    expect((await call(null, `/api/teams/${t1}/uploads/${id}`)).status).toBe(401);
    expect((await call(a, `/api/teams/${t1}/uploads/${id}`)).status).toBe(200);

    // Over-limit bodies are rejected, including chunked ones without Content-Length.
    expect((await call(a, `/api/teams/${t1}/uploads`, { method: 'POST', body: new Uint8Array(1024 * 1024 + 1) })).status).toBe(413);
    const chunked = new ReadableStream({
      start(ctl) {
        for (let i = 0; i < 3; i++) ctl.enqueue(new Uint8Array(400 * 1024));
        ctl.close();
      },
    });
    const big = await call(a, `/api/teams/${t1}/uploads`, { method: 'POST', body: chunked, duplex: 'half' } as RequestInit);
    expect(big.status).toBe(413);

    expect((await call(b, `/api/teams/${t1}/uploads/${id}`, { method: 'DELETE' })).status).toBe(204);
    expect((await call(a, `/api/teams/${t1}/uploads/${id}`)).status).toBe(404);
  });

  it('keeps personal uploads private', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await send(a, 'PUT', `/api/teams/${team}/members/user_bob`, { role: 'member' });
    const { id } = (await (await call(a, '/api/uploads', { method: 'POST', body: new Uint8Array([1]) })).json()) as { id: string };
    expect((await call(b, `/api/uploads/${id}`)).status).toBe(404);
    expect((await call(b, `/api/teams/${team}/uploads/${id}`)).status).toBe(404);
  });
});

describe('rooms', () => {
  it('enforces handshake authorization', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    const url = (room = 'general', q = '') => `${BASE}/api/teams/${team}/rooms/${room}/ws${q}`;
    const up = { Upgrade: 'websocket' };
    expect((await SELF.fetch(url(), { headers: { ...up, Origin: BASE } })).status).toBe(401);
    expect((await SELF.fetch(url(), { headers: { ...up, Origin: BASE, Cookie: b } })).status).toBe(403);
    expect((await SELF.fetch(url(), { headers: { ...up, Cookie: a } })).status).toBe(403);
    expect((await SELF.fetch(url(), { headers: { ...up, Cookie: a, Origin: 'null' } })).status).toBe(403);
    expect((await SELF.fetch(url(), { headers: { ...up, Cookie: a, Origin: 'http://evil.test' } })).status).toBe(403);
    expect((await SELF.fetch(url('general', '?x=1'), { headers: { ...up, Cookie: a, Origin: BASE } })).status).toBe(400);
    expect((await SELF.fetch(url('bad.room'), { headers: { ...up, Cookie: a, Origin: BASE } })).status).toBe(400);
    expect((await SELF.fetch(url('r'.repeat(41)), { headers: { ...up, Cookie: a, Origin: BASE } })).status).toBe(400);
    expect((await SELF.fetch(url(), { headers: { Cookie: a, Origin: BASE } })).status).toBe(426);

    // Spoofed identity headers are replaced with the verified identity.
    const { ws, events } = await openRoom(a, team, 'general', { 'x-room-user': 'user_bob', 'x-room-tenant': 'other', 'x-room-expires': '1' });
    await until(() => events.length === 1);
    ws.send(JSON.stringify({ text: 'hi' }));
    await until(() => events.length === 2);
    expect(events[1]).toMatchObject({ type: 'message', userId: 'user_alice', text: 'hi' });
    ws.close();

    // Handshakes after logout or removal are refused.
    await send(a, 'PUT', `/api/teams/${team}/members/user_bob`, { role: 'member' });
    const live = await openRoom(b, team);
    await until(() => live.events.length === 1);
    live.ws.close();
    await send(a, 'DELETE', `/api/teams/${team}/members/user_bob`);
    expect((await SELF.fetch(url(), { headers: { ...up, Origin: BASE, Cookie: b } })).status).toBe(403);
    expect((await call(a, '/api/logout', { method: 'POST' })).status).toBe(204);
    expect((await SELF.fetch(url(), { headers: { ...up, Origin: BASE, Cookie: a } })).status).toBe(401);
  });

  it('broadcasts, snapshots the latest 50 and keeps seq increasing', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await send(a, 'PUT', `/api/teams/${team}/members/user_bob`, { role: 'member' });
    const one = await openRoom(a, team, 'r1');
    const two = await openRoom(b, team, 'r1');
    const other = await openRoom(b, team, 'r2');
    await until(() => one.events.length === 1 && two.events.length === 1 && other.events.length === 1);
    expect(one.events[0]).toEqual({ type: 'snapshot', messages: [] });

    // Concurrent senders: each message appears exactly once for every connection.
    for (let i = 0; i < 30; i++) {
      one.ws.send(JSON.stringify({ text: `a${i}` }));
      two.ws.send(JSON.stringify({ text: `b${i}` }));
    }
    await until(() => one.events.length === 61 && two.events.length === 61);
    for (const c of [one, two]) {
      const msgs = c.events.slice(1);
      expect(new Set(msgs.map((m) => m.text)).size).toBe(60);
      expect(msgs.map((m) => m.seq)).toEqual(Array.from({ length: 60 }, (_, i) => i + 1));
    }
    expect(other.events.length).toBe(1);

    const late = await openRoom(a, team, 'r1');
    await until(() => late.events.length === 1);
    const snap = late.events[0].messages;
    expect(snap).toHaveLength(50);
    expect(snap[0].seq).toBe(11);
    expect(snap[49].seq).toBe(60);

    // Invalid input is rejected and never stored.
    for (const bad of ['not json', JSON.stringify({ text: '   ' }), JSON.stringify({ text: 'x'.repeat(1001) }), JSON.stringify({ text: 'x', pad: 'y'.repeat(4100) }), JSON.stringify({ text: 5 })]) {
      const c = await openRoom(a, team, 'r3');
      const closed = new Promise<void>((res) => c.ws.addEventListener('close', () => res()));
      c.ws.send(bad);
      await closed;
    }
    const check = await openRoom(a, team, 'r3');
    await until(() => check.events.length === 1);
    expect(check.events[0].messages).toEqual([]);

    // seq keeps increasing after pruning.
    late.ws.send(JSON.stringify({ text: 'after' }));
    await until(() => late.events.length === 2);
    expect(late.events[1].seq).toBe(61);
    for (const c of [one, two, other, late, check]) c.ws.close();
  });
});
