import { describe, expect, it } from 'vitest';
import { SELF } from 'cloudflare:test';

const BASE = 'http://localhost';

async function login(email: string) {
  const r = await SELF.fetch(BASE + '/api/login', {
    method: 'POST',
    headers: { Origin: BASE, 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password: 'local-demo-password' }),
  });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

const call = (cookie: string | null, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, { ...init, headers: { Origin: BASE, ...(cookie ? { Cookie: cookie } : {}), ...(init.headers as object) } });
const json = (method: string, body: unknown): RequestInit => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

async function createTeam(cookie: string, name = 'Review team') {
  const r = await call(cookie, '/api/teams', json('POST', { name }));
  expect(r.status).toBe(201);
  return (await r.json()) as { id: string; name: string };
}
const addMember = (cookie: string, team: string, user: string) => call(cookie, `/api/teams/${team}/members/${user}`, json('PUT', { role: 'member' }));

async function connect(cookie: string, team: string, room = 'general', headers: Record<string, string> = {}) {
  const res = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/${room}/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: cookie, ...headers } });
  return res;
}

// Accepts the socket and records every JSON event it receives.
function listen(res: Response) {
  const ws = res.webSocket!;
  ws.accept();
  const events: any[] = [];
  ws.addEventListener('message', (e) => {
    events.push(JSON.parse(e.data as string));
  });
  return { ws, events };
}

async function until<T>(fn: () => T | undefined | false, ms = 4000): Promise<T> {
  const end = Date.now() + ms;
  for (;;) {
    const v = fn();
    if (v) return v;
    if (Date.now() > end) throw new Error('timed out waiting for condition');
    await new Promise((r) => setTimeout(r, 10));
  }
}

describe('teams api', () => {
  it('creates, validates, lists only own teams and requires auth/origin', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    expect((await call(null, '/api/teams')).status).toBe(401);
    expect((await call(null, '/api/teams', json('POST', { name: 'x' }))).status).toBe(401);
    expect((await call(a, '/api/teams', { ...json('POST', { name: 'x' }), headers: { Origin: 'http://evil.test', 'Content-Type': 'application/json' } })).status).toBe(403);
    expect((await call(a, '/api/teams', json('POST', { name: '   ' }))).status).toBe(400);
    expect((await call(a, '/api/teams', json('POST', { name: 'n'.repeat(81) }))).status).toBe(400);
    expect((await call(a, '/api/teams', json('POST', { name: 5 }))).status).toBe(400);

    const team = await createTeam(a, '  Padded name  ');
    expect(team.name).toBe('Padded name');
    const mine = (await (await call(a, '/api/teams')).json()) as any;
    expect(mine.teams.find((t: any) => t.id === team.id)).toEqual({ id: team.id, name: 'Padded name', role: 'owner' });
    const theirs = (await (await call(b, '/api/teams')).json()) as any;
    expect(theirs.teams.some((t: any) => t.id === team.id)).toBe(false);
  });

  it('lets only the owner manage membership using current authority', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const { id } = await createTeam(a);

    expect((await addMember(b, id, 'user_bob')).status).toBe(403);
    expect((await call(b, `/api/teams/${id}/members/user_bob`, { method: 'DELETE' })).status).toBe(403);
    expect((await addMember(a, id, 'user_mallory')).status).toBe(400);
    expect((await call(a, `/api/teams/${id}/members/user_bob`, json('PUT', { role: 'owner' }))).status).toBe(400);
    expect((await addMember(a, id, 'user_alice')).status).toBe(409);
    expect((await call(a, `/api/teams/${id}/members/user_alice`, { method: 'DELETE' })).status).toBe(409);

    expect((await call(b, `/api/teams/${id}/uploads`, { method: 'POST', body: new Uint8Array(1) })).status).toBe(403);
    expect((await addMember(a, id, 'user_bob')).status).toBe(204);
    expect((await addMember(a, id, 'user_bob')).status).toBe(204);
    const bobTeams = (await (await call(b, '/api/teams')).json()) as any;
    expect(bobTeams.teams.find((t: any) => t.id === id).role).toBe('member');
    expect((await call(b, `/api/teams/${id}/uploads`, { method: 'POST', body: new Uint8Array(1) })).status).toBe(201);

    expect((await call(a, `/api/teams/${id}/members/user_bob`, { method: 'DELETE' })).status).toBe(204);
    expect((await call(b, `/api/teams/${id}/uploads`, { method: 'POST', body: new Uint8Array(1) })).status).toBe(403);
    expect(((await (await call(b, '/api/teams')).json()) as any).teams.some((t: any) => t.id === id)).toBe(false);
  });
});

describe('team uploads', () => {
  it('shares bytes between members, isolates teams and bounds size', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    const other = await createTeam(a, 'Other');
    await addMember(a, team.id, 'user_bob');

    const bytes = new Uint8Array([0, 1, 2, 255, 254, 60, 115]);
    const up = await call(a, `/api/teams/${team.id}/uploads`, { method: 'POST', headers: { 'Content-Type': 'text/html' }, body: bytes });
    expect(up.status).toBe(201);
    const { id } = (await up.json()) as { id: string };

    const dl = await call(b, `/api/teams/${team.id}/uploads/${id}`);
    expect(dl.status).toBe(200);
    expect(new Uint8Array(await dl.arrayBuffer())).toEqual(bytes);
    expect(dl.headers.get('Content-Type')).toBe('application/octet-stream');
    expect(dl.headers.get('Content-Disposition')).toContain('attachment');
    expect(dl.headers.get('X-Content-Type-Options')).toBe('nosniff');
    expect(dl.headers.get('Cache-Control')).toBe('private, no-store');

    // The same id under another team (alice owns it) must not resolve.
    expect((await call(a, `/api/teams/${other.id}/uploads/${id}`)).status).toBe(404);
    expect((await call(a, `/api/teams/${other.id}/uploads/${id}`, { method: 'DELETE' })).status).toBe(404);
    expect((await call(a, `/api/teams/${team.id}/uploads/${id}`)).status).toBe(200);

    // Personal uploads stay private and are not reachable through a team.
    const personal = (await (await call(a, '/api/uploads', { method: 'POST', body: bytes })).json()) as { id: string };
    expect((await call(a, `/api/teams/${team.id}/uploads/${personal.id}`)).status).toBe(404);
    expect((await call(b, `/api/uploads/${id}`)).status).toBe(404);
    expect((await call(a, `/api/uploads/${personal.id}`)).status).toBe(200);

    expect((await call(a, `/api/teams/${team.id}/uploads`, { method: 'POST', body: new Uint8Array(1024 * 1024) })).status).toBe(201);
    expect((await call(a, `/api/teams/${team.id}/uploads`, { method: 'POST', body: new Uint8Array(1024 * 1024 + 1) })).status).toBe(413);

    const chunks = new ReadableStream<Uint8Array>({
      start(ctrl) {
        for (let i = 0; i < 3; i++) ctrl.enqueue(new Uint8Array(512 * 1024));
        ctrl.close();
      },
    });
    const chunked = await call(a, `/api/teams/${team.id}/uploads`, { method: 'POST', body: chunks, duplex: 'half' } as RequestInit);
    expect(chunked.status).toBe(413);

    expect((await call(b, `/api/teams/${team.id}/uploads/${id}`, { method: 'DELETE' })).status).toBe(204);
    expect((await call(a, `/api/teams/${team.id}/uploads/${id}`)).status).toBe(404);
  });
});

describe('room websocket', () => {
  it('rejects unauthenticated, foreign, malformed and non-member handshakes', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const { id } = await createTeam(a);
    const url = (room: string, qs = '') => `${BASE}/api/teams/${id}/rooms/${room}/ws${qs}`;
    const hdr = (extra: Record<string, string> = {}) => ({ Upgrade: 'websocket', Origin: BASE, Cookie: a, ...extra });

    expect((await SELF.fetch(url('general'), { headers: { Upgrade: 'websocket', Origin: BASE } })).status).toBe(401);
    expect((await SELF.fetch(url('general'), { headers: hdr({ Origin: 'http://evil.test' }) })).status).toBe(403);
    expect((await SELF.fetch(url('general'), { headers: hdr({ Origin: 'null' }) })).status).toBe(403);
    const noOrigin = await SELF.fetch(url('general'), { headers: { Upgrade: 'websocket', Cookie: a } });
    expect(noOrigin.status).toBe(403);
    expect((await SELF.fetch(url('general', '?x=1'), { headers: hdr() })).status).toBe(400);
    expect((await SELF.fetch(url('bad.room'), { headers: hdr() })).status).toBe(400);
    expect((await SELF.fetch(url('a'.repeat(41)), { headers: hdr() })).status).toBe(400);
    expect([403, 404]).toContain((await connect(b, id)).status);
    expect((await SELF.fetch(url('general'), { headers: { Origin: BASE, Cookie: a } })).status).toBe(426);
  });

  it('serves snapshots, broadcasts to everyone and ignores spoofed identity', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const { id } = await createTeam(a);
    await addMember(a, id, 'user_bob');

    const alice = listen(await connect(a, id, 'review', { 'X-Verified-User': 'user_bob', 'X-User-Id': 'user_bob' }));
    const first = await until(() => alice.events[0]);
    expect(first).toEqual({ type: 'snapshot', messages: [] });
    const bob = listen(await connect(b, id, 'review'));
    await until(() => bob.events[0]);

    alice.ws.send(JSON.stringify({ text: 'hello <b>there</b>', userId: 'user_bob' }));
    const got = await until(() => bob.events.find((e) => e.type === 'message'));
    expect(got).toMatchObject({ type: 'message', userId: 'user_alice', text: 'hello <b>there</b>' });
    expect(got.seq).toBeGreaterThan(0);
    await until(() => alice.events.find((e) => e.type === 'message' && e.seq === got.seq));

    // Rooms are independent.
    const lobby = listen(await connect(b, id, 'lobby'));
    await until(() => lobby.events[0]);
    expect(lobby.events[0].messages).toEqual([]);

    // Invalid input never enters history.
    alice.ws.send('not json');
    alice.ws.send(JSON.stringify({ text: '   ' }));
    alice.ws.send(JSON.stringify({ text: 'x'.repeat(1001) }));
    alice.ws.send(JSON.stringify({ text: 'y'.repeat(5000) }));
    alice.ws.send(JSON.stringify({ text: 5 }));
    alice.ws.send(new Uint8Array([1, 2, 3]));
    await until(() => alice.events.filter((e) => e.type === 'error').length === 6);
    alice.ws.send(JSON.stringify({ text: 'x'.repeat(1000) }));
    await until(() => alice.events.filter((e) => e.type === 'message').length === 2);

    const late = listen(await connect(b, id, 'review'));
    const snap = await until(() => late.events[0]);
    expect(snap.messages.map((m: any) => m.text)).toEqual(['hello <b>there</b>', 'x'.repeat(1000)]);
    for (const s of [alice, bob, lobby, late]) s.ws.close(1000, 'done');
  });

  it('assigns each concurrent message a unique increasing seq and caps snapshots at 50', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const { id } = await createTeam(a);
    await addMember(a, id, 'user_bob');
    const alice = listen(await connect(a, id, 'busy'));
    const bob = listen(await connect(b, id, 'busy'));
    await until(() => alice.events[0] && bob.events[0]);

    for (let i = 0; i < 30; i++) {
      alice.ws.send(JSON.stringify({ text: `a${i}` }));
      bob.ws.send(JSON.stringify({ text: `b${i}` }));
    }
    const msgs = (s: typeof alice) => s.events.filter((e) => e.type === 'message');
    await until(() => msgs(alice).length === 60 && msgs(bob).length === 60);
    for (const s of [alice, bob]) {
      const seqs = msgs(s).map((m) => m.seq);
      expect(new Set(msgs(s).map((m) => m.text)).size).toBe(60);
      expect(seqs).toEqual([...seqs].sort((x, y) => x - y));
      expect(new Set(seqs).size).toBe(60);
    }

    const late = listen(await connect(a, id, 'busy'));
    const snap = await until(() => late.events[0]);
    expect(snap.messages).toHaveLength(50);
    expect(snap.messages.map((m: any) => m.seq)).toEqual(msgs(alice).slice(10).map((m) => m.seq));
    for (const s of [alice, bob, late]) s.ws.close(1000, 'done');
  });

  it('honors logout and member removal for new handshakes', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const { id } = await createTeam(a);
    await addMember(a, id, 'user_bob');
    const ok = await connect(b, id);
    expect(ok.status).toBe(101);
    ok.webSocket!.accept();
    ok.webSocket!.close(1000, 'done');

    await call(a, `/api/teams/${id}/members/user_bob`, { method: 'DELETE' });
    expect([403, 404]).toContain((await connect(b, id)).status);

    expect((await call(a, '/api/logout', { method: 'POST' })).status).toBe(204);
    expect((await connect(a, id)).status).toBe(401);
  });
});

