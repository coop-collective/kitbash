import { DurableObject } from 'cloudflare:workers';
export type Session = { userId: string; tenantId: string; sessionId: string; grantId: string; expiresAt: number };
// `since` is the highest seq already contained in this connection's snapshot.
type Connection = Session & { tokens: number; updatedAt: number; since: number };
type Message = { seq: number; userId: string; text: string; clientId?: string };
type Role = 'owner' | 'member' | 'viewer';

const CLIENT_ID = /^[A-Za-z0-9_-]{1,80}$/;

export class TeamRoom extends DurableObject<Env> {
  // Serialises message handling so commit and fan-out order matches seq. Not authoritative state:
  // a fresh instance after hibernation starts with an empty chain and everything else lives in SQL.
  private queue: Promise<unknown> = Promise.resolve();

  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    const sql = ctx.storage.sql;
    sql.exec('CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY AUTOINCREMENT, userId TEXT NOT NULL, text TEXT NOT NULL)');
    // Additive upgrade of rooms created by the first release.
    if (!sql.exec<{ name: string }>('PRAGMA table_info(messages)').toArray().some((c) => c.name === 'clientId')) {
      sql.exec('ALTER TABLE messages ADD COLUMN clientId TEXT');
    }
    // Retry records outlive the latest-50 history window.
    sql.exec('CREATE TABLE IF NOT EXISTS dedup (userId TEXT NOT NULL, clientId TEXT NOT NULL, seq INTEGER NOT NULL, text TEXT NOT NULL, PRIMARY KEY (userId, clientId))');
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  private history(): Message[] {
    return this.ctx.storage.sql
      .exec<{ seq: number; userId: string; text: string; clientId: string | null }>(
        'SELECT seq, userId, text, clientId FROM (SELECT seq, userId, text, clientId FROM messages ORDER BY seq DESC LIMIT 50) ORDER BY seq',
      )
      .toArray()
      .map(({ clientId, ...m }) => (clientId ? { ...m, clientId } : m));
  }

  /** Current authority from D1: live session and the same membership grant. Fails closed. */
  private async authority(c: Partial<Connection> | null): Promise<Role | null> {
    if (!c?.sessionId || !c.userId || !c.tenantId) return null;
    try {
      const row = await this.env.DB.prepare(
        'SELECT m.role, m.grant_id FROM sessions s JOIN team_members m ON m.user_id = s.user_id ' +
          'WHERE s.id = ? AND s.user_id = ? AND s.revoked_at IS NULL AND s.expires_at > ? AND m.team_id = ?',
      ).bind(c.sessionId, c.userId, Math.floor(Date.now() / 1000), c.tenantId).first<{ role: Role; grant_id: string }>();
      if (!row || (c.grantId && row.grant_id !== c.grantId)) return null;
      return row.role;
    } catch {
      return null;
    }
  }

  async fetch(request: Request): Promise<Response> {
    if (request.headers.get('upgrade')?.toLowerCase() !== 'websocket') return new Response('Upgrade required', { status: 426 });
    // Only the outer Worker creates these headers. This DO has no public route.
    const userId = request.headers.get('x-room-user'), tenantId = request.headers.get('x-room-tenant');
    const sessionId = request.headers.get('x-room-session'), grantId = request.headers.get('x-room-grant');
    const expiresAt = Number(request.headers.get('x-room-expires'));
    if (!userId || !tenantId || !sessionId || !grantId || expiresAt <= Date.now() || !Number.isFinite(expiresAt)) return new Response('Unauthorized', { status: 401 });
    let active = 0;
    for (const peer of this.ctx.getWebSockets()) {
      const attached = peer.deserializeAttachment() as Connection | null;
      if (!attached || attached.expiresAt <= Date.now()) {
        try { peer.close(1008, 'Session expired'); } catch { /* already closed */ }
      } else if (peer.readyState === WebSocket.OPEN) active++;
    }
    if (active >= 100) return new Response('Room full', { status: 503 });
    const pair = new WebSocketPair();
    this.ctx.acceptWebSocket(pair[1]);
    const messages = this.history();
    pair[1].serializeAttachment({
      userId, tenantId, sessionId, grantId, expiresAt, tokens: 100, updatedAt: Date.now(),
      since: messages.at(-1)?.seq ?? 0,
    } satisfies Connection);
    pair[1].send(JSON.stringify({ type: 'snapshot', messages }));
    return new Response(null, { status: 101, webSocket: pair[0] });
  }

  webSocketMessage(socket: WebSocket, input: string | ArrayBuffer): Promise<void> {
    const run = this.queue.then(() => this.process(socket, input)).catch(() => {
      try { socket.close(1011, 'Internal error'); } catch { /* already closed */ }
    });
    this.queue = run;
    return run;
  }

  private tell(socket: WebSocket, event: object) {
    try { socket.send(JSON.stringify(event)); } catch { /* already closed */ }
  }

  private async process(socket: WebSocket, input: string | ArrayBuffer): Promise<void> {
    // No in-memory socket map: attachment and SQL are authoritative after hibernation.
    const connection = socket.deserializeAttachment() as Connection | null;
    if (!connection || connection.expiresAt <= Date.now()) { socket.close(1008, 'Session expired'); return; }
    if (typeof input !== 'string' || new TextEncoder().encode(input).byteLength > 4096) { socket.close(1009, 'Message too large'); return; }

    // Authorize the sender before anything else (validation detail, dedup lookup, conflict, ack, commit).
    const role = await this.authority(connection);
    if (!role) {
      this.tell(socket, { type: 'error', code: 'unauthorized' });
      try { socket.close(1008, 'Not authorized'); } catch { /* already closed */ }
      return;
    }
    if (role === 'viewer') { this.tell(socket, { type: 'error', code: 'read_only' }); return; }

    let body: { text?: unknown; clientId?: unknown } | null;
    try { body = JSON.parse(input); } catch { socket.close(1008, 'Invalid message'); return; }
    const text = body?.text;
    if (typeof text !== 'string' || !text.trim() || text.length > 1000) { socket.close(1008, 'Invalid text'); return; }
    const clientId = body?.clientId;
    if (clientId !== undefined && (typeof clientId !== 'string' || !CLIENT_ID.test(clientId))) {
      this.tell(socket, { type: 'error', code: 'invalid_client_id' });
      return;
    }

    const now = Date.now();
    connection.tokens = Math.min(100, connection.tokens + Math.max(0, now - connection.updatedAt) / 1000 * 100);
    connection.updatedAt = now;
    if (connection.tokens < 1) { socket.close(1008, 'Rate limit'); return; }
    connection.tokens--;
    socket.serializeAttachment(connection);

    const sql = this.ctx.storage.sql;
    if (clientId !== undefined) {
      const prior = sql.exec<{ seq: number; text: string }>('SELECT seq, text FROM dedup WHERE userId = ? AND clientId = ?', connection.userId, clientId).toArray()[0];
      if (prior) {
        this.tell(socket, prior.text === text ? { type: 'ack', seq: prior.seq, clientId } : { type: 'error', code: 'conflict', clientId });
        return;
      }
    }
    const row = this.ctx.storage.transactionSync((): Message => {
      const inserted = sql.exec<{ seq: number; userId: string; text: string }>(
        'INSERT INTO messages (userId, text, clientId) VALUES (?, ?, ?) RETURNING seq, userId, text', connection.userId, text, clientId ?? null,
      ).one();
      if (clientId !== undefined) sql.exec('INSERT INTO dedup (userId, clientId, seq, text) VALUES (?, ?, ?, ?)', connection.userId, clientId, inserted.seq, text);
      sql.exec('DELETE FROM messages WHERE seq <= ?', inserted.seq - 50);
      return clientId !== undefined ? { ...inserted, clientId } : inserted;
    });

    // Each recipient is authorized against current session and membership for this send.
    const event = JSON.stringify({ type: 'message', ...row });
    const verdicts = new Map<string, Promise<Role | null>>();
    await Promise.all(this.ctx.getWebSockets().map(async (peer) => {
      const att = peer.deserializeAttachment() as Connection | null;
      try {
        if (!att || att.expiresAt <= Date.now()) { peer.close(1008, 'Session expired'); return; }
        const key = JSON.stringify([att.sessionId, att.userId, att.tenantId, att.grantId]);
        if (!verdicts.has(key)) verdicts.set(key, this.authority(att));
        if (!(await verdicts.get(key))) { peer.close(1008, 'Not authorized'); return; }
        if (row.seq > att.since) peer.send(event);
      } catch { try { peer.close(1011, 'Send failed'); } catch { /* already closed */ } }
    }));
  }

  webSocketClose(socket: WebSocket, code: number): void {
    // Reserved codes (1005/1006/1015) cannot be echoed back.
    try { socket.close(code >= 1000 && code <= 4999 && ![1004, 1005, 1006, 1015].includes(code) ? code : 1000, 'Closing'); } catch { /* already closed */ }
  }
  webSocketError(socket: WebSocket): void { try { socket.close(1011, 'Connection error'); } catch { /* already closed */ } }
}
