import { Hono, type Context, type MiddlewareHandler } from 'hono';
import { readBounded } from '../lib/bounded';

type TeamEnv = Env & { SESSION_SECRET?: string; DEMO_PASSWORD?: string };
type Vars = { userId: string; email: string; sessionId: string; role: string };
type Bindings = { Bindings: TeamEnv; Variables: Vars };
type C = Context<Bindings>;

const MAX_TEAM_UPLOAD = 1024 * 1024;
const LEASE_MS = 5 * 60 * 1000;
const ROOM = /^[A-Za-z0-9_-]{1,40}$/;
const now = () => Math.floor(Date.now() / 1000);

async function readJson(c: C): Promise<Record<string, unknown> | null> {
  const body = await readBounded(c.req.raw, 16 * 1024);
  if (!body) return null;
  try {
    const v = JSON.parse(new TextDecoder().decode(body));
    return v && typeof v === 'object' && !Array.isArray(v) ? v : null;
  } catch {
    return null;
  }
}

/** Current authority straight from D1; never cached. */
async function roleOf(db: D1Database, teamId: string, userId: string): Promise<string | null> {
  const row = await db.prepare('SELECT role FROM team_members WHERE team_id = ? AND user_id = ?').bind(teamId, userId).first<{ role: string }>();
  return row?.role ?? null;
}

/**
 * Team routes. `requireAuth` is the host's session middleware and `knownUsers` the set of
 * accounts that may be added to a team.
 */
export function createTeamRoutes(requireAuth: MiddlewareHandler, knownUsers: ReadonlySet<string>) {
  const teams = new Hono<Bindings>();
  teams.use('*', requireAuth);

  teams.post('/', async (c) => {
    const body = await readJson(c);
    const name = typeof body?.name === 'string' ? body.name.trim() : '';
    if (name.length < 1 || name.length > 80) return c.json({ error: 'invalid name' }, 400);
    const id = crypto.randomUUID();
    const userId = c.get('userId');
    const t = now();
    await c.env.DB.batch([
      c.env.DB.prepare('INSERT INTO teams (id, name, owner_id, created_at) VALUES (?, ?, ?, ?)').bind(id, name, userId, t),
      c.env.DB.prepare("INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'owner', ?)").bind(id, userId, t),
    ]);
    return c.json({ id, name }, 201);
  });

  teams.get('/', async (c) => {
    const { results } = await c.env.DB.prepare(
      'SELECT t.id AS id, t.name AS name, m.role AS role FROM team_members m JOIN teams t ON t.id = m.team_id WHERE m.user_id = ? ORDER BY t.created_at, t.id',
    ).bind(c.get('userId')).all<{ id: string; name: string; role: string }>();
    c.header('Cache-Control', 'private, no-store');
    return c.json({ teams: results });
  });

  // ---- membership management (owner only) ----

  const requireOwner = async (c: C, teamId: string): Promise<Response | null> => {
    const role = await roleOf(c.env.DB, teamId, c.get('userId'));
    if (!role) {
      const exists = await c.env.DB.prepare('SELECT 1 AS x FROM teams WHERE id = ?').bind(teamId).first();
      return c.json({ error: exists ? 'forbidden' : 'not found' }, exists ? 403 : 404);
    }
    return role === 'owner' ? null : c.json({ error: 'forbidden' }, 403);
  };

  teams.put('/:team/members/:userId', async (c) => {
    const teamId = c.req.param('team');
    const denied = await requireOwner(c, teamId);
    if (denied) return denied;
    const target = c.req.param('userId');
    if (!knownUsers.has(target)) return c.json({ error: 'unknown account' }, 400);
    const body = await readJson(c);
    if (!body || (body.role !== 'member' && body.role !== 'viewer')) return c.json({ error: 'invalid role' }, 400);
    if ((await roleOf(c.env.DB, teamId, target)) === 'owner') return c.json({ error: 'owner is immutable' }, 409);
    await c.env.DB.prepare(
      "INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, ?, ?) ON CONFLICT(team_id, user_id) DO UPDATE SET role = excluded.role WHERE role <> 'owner'",
    ).bind(teamId, target, body.role, now()).run();
    return c.body(null, 204);
  });

  teams.delete('/:team/members/:userId', async (c) => {
    const teamId = c.req.param('team');
    const denied = await requireOwner(c, teamId);
    if (denied) return denied;
    const target = c.req.param('userId');
    if (!knownUsers.has(target)) return c.json({ error: 'unknown account' }, 400);
    if ((await roleOf(c.env.DB, teamId, target)) === 'owner') return c.json({ error: 'owner is immutable' }, 409);
    await c.env.DB.prepare("DELETE FROM team_members WHERE team_id = ? AND user_id = ? AND role <> 'owner'").bind(teamId, target).run();
    return c.body(null, 204);
  });

  // ---- member-only routes ----

  const requireMember: MiddlewareHandler<Bindings> = async (c, next) => {
    const role = await roleOf(c.env.DB, c.req.param('team') ?? '', c.get('userId'));
    if (!role) return c.json({ error: 'forbidden' }, 403);
    c.set('role', role);
    await next();
  };

  // Viewers are read-only: mutations need the current role to be owner or member.
  const requireWriter: MiddlewareHandler<Bindings> = async (c, next) => {
    if (c.get('role') === 'viewer') return c.json({ error: 'read-only role' }, 403);
    await next();
  };

  // Team files: keys derive from the verified team and a server-generated id.
  const objectKey = (teamId: string, id: string) => `teams/${teamId}/${id}`;

  teams.post('/:team/uploads', requireMember, requireWriter, async (c) => {
    const data = await readBounded(c.req.raw, MAX_TEAM_UPLOAD);
    if (!data) return c.json({ error: 'too large' }, 413);
    const teamId = c.req.param('team');
    const id = crypto.randomUUID();
    const key = objectKey(teamId, id);
    await c.env.UPLOADS.put(key, data, { httpMetadata: { contentType: 'application/octet-stream' } });
    try {
      await c.env.DB.prepare('INSERT INTO team_uploads (id, team_id, uploader_id, object_key, size, created_at) VALUES (?, ?, ?, ?, ?, ?)')
        .bind(id, teamId, c.get('userId'), key, data.byteLength, now())
        .run();
    } catch (err) {
      await c.env.UPLOADS.delete(key);
      throw err;
    }
    return c.json({ id }, 201);
  });

  const findTeamUpload = (c: C) =>
    c.env.DB.prepare('SELECT id FROM team_uploads WHERE id = ? AND team_id = ?').bind(c.req.param('id'), c.req.param('team')).first<{ id: string }>();

  teams.get('/:team/uploads/:id', requireMember, async (c) => {
    const row = await findTeamUpload(c);
    const obj = row ? await c.env.UPLOADS.get(objectKey(c.req.param('team') ?? '', row.id)) : null;
    if (!obj) return c.json({ error: 'not found' }, 404);
    return new Response(obj.body, {
      headers: {
        'Content-Type': 'application/octet-stream',
        'Content-Length': String(obj.size),
        'Content-Disposition': 'attachment; filename="download.bin"',
        'X-Content-Type-Options': 'nosniff',
        'Cache-Control': 'private, no-store',
      },
    });
  });

  teams.delete('/:team/uploads/:id', requireMember, requireWriter, async (c) => {
    const row = await findTeamUpload(c);
    if (!row) return c.json({ error: 'not found' }, 404);
    await c.env.UPLOADS.delete(objectKey(c.req.param('team') ?? '', row.id));
    await c.env.DB.prepare('DELETE FROM team_uploads WHERE id = ? AND team_id = ?').bind(row.id, c.req.param('team')).run();
    return c.body(null, 204);
  });

  // ---- rooms ----

  teams.get('/:team/rooms/:room/ws', requireMember, async (c) => {
    const request = c.req.raw;
    const url = new URL(request.url);
    const teamId = c.req.param('team') ?? '';
    const room = c.req.param('room') ?? '';
    if (url.search) return c.json({ error: 'query not allowed' }, 400);
    if (!ROOM.test(room)) return c.json({ error: 'invalid room' }, 400);
    const origin = request.headers.get('Origin');
    if (!origin || origin !== url.origin) return c.json({ error: 'bad origin' }, 403);
    if (request.headers.get('Upgrade')?.toLowerCase() !== 'websocket') return c.json({ error: 'upgrade required' }, 426);

    const session = await c.env.DB.prepare('SELECT expires_at FROM sessions WHERE id = ? AND revoked_at IS NULL AND expires_at > ?')
      .bind(c.get('sessionId'), now())
      .first<{ expires_at: number }>();
    if (!session) return c.json({ error: 'unauthorized' }, 401);

    // Lease: bounded by five minutes and by the real session expiry. The room additionally
    // re-checks the session and membership in D1 for every send and every delivery.
    const expiresAt = Math.min(session.expires_at * 1000, Date.now() + LEASE_MS);
    // A fresh header set: every client-supplied header (including any x-room-*) is dropped.
    const headers = new Headers({
      upgrade: 'websocket',
      'x-room-user': c.get('userId'),
      'x-room-team': teamId,
      'x-room-session': c.get('sessionId'),
      'x-room-expires': String(expiresAt),
    });
    const stub = c.env.TEAM_ROOMS.getByName(JSON.stringify([teamId, room]));
    return stub.fetch(new Request(request.url, { headers }));
  });

  return teams;
}
