-- Adds the read-only 'viewer' role. SQLite cannot alter a CHECK constraint, so the table is rebuilt.
-- grant_id changes whenever a membership row is (re)created and stays stable across role changes, so an
-- open socket from a revoked membership cannot be revived by re-adding the same user.
CREATE TABLE team_members_v2 (
  team_id TEXT NOT NULL REFERENCES teams(id),
  user_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('owner', 'member', 'viewer')),
  created_at INTEGER NOT NULL,
  grant_id TEXT NOT NULL DEFAULT (lower(hex(randomblob(16)))),
  PRIMARY KEY (team_id, user_id)
);

INSERT INTO team_members_v2 (team_id, user_id, role, created_at)
  SELECT team_id, user_id, role, created_at FROM team_members;

DROP TABLE team_members;
ALTER TABLE team_members_v2 RENAME TO team_members;
CREATE INDEX team_members_user ON team_members(user_id);
