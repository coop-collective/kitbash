import { DurableObject } from 'cloudflare:workers';

const MAX_FRAME_BYTES = 4096;
const MAX_TEXT_CHARS = 1000;
const SNAPSHOT_SIZE = 50;
const KEEP_MESSAGES = 500;
const enc = new TextEncoder();

interface Attachment {
  userId: string;
  leaseExp: number;
}

interface MessageRow extends Record<string, SqlStorageValue> {
  seq: number;
  user_id: string;
  text: string;
}

/**
 * One SQLite-backed Durable Object per team/room. Only the Worker's membership-checked
 * route reaches it (via the namespace binding); identity arrives in headers the Worker
 * builds from scratch after verifying the session and membership.
 */
export class Room extends DurableObject<Env> {
  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    ctx.blockConcurrencyWhile(async () => {
      // AUTOINCREMENT keeps seq monotonic even after old rows are pruned.
      ctx.storage.sql.exec('CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, text TEXT NOT NULL)');
    });
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  async fetch(request: Request): Promise<Response> {
    const userId = request.headers.get('X-Verified-User');
    const lease = Number(request.headers.get('X-Verified-Lease'));
    if (!userId || !Number.isFinite(lease)) return new Response('forbidden', { status: 403 });
    if (request.headers.get('Upgrade')?.toLowerCase() !== 'websocket') return new Response('upgrade required', { status: 426 });

    const pair = new WebSocketPair();
    const [client, server] = Object.values(pair);
    this.ctx.acceptWebSocket(server);
    server.serializeAttachment({ userId, leaseExp: lease } satisfies Attachment);

    const rows = this.ctx.storage.sql
      .exec<MessageRow>('SELECT seq, user_id, text FROM (SELECT seq, user_id, text FROM messages ORDER BY seq DESC LIMIT ?) ORDER BY seq ASC', SNAPSHOT_SIZE)
      .toArray();
    server.send(JSON.stringify({ type: 'snapshot', messages: rows.map((r) => ({ seq: r.seq, userId: r.user_id, text: r.text })) }));
    return new Response(null, { status: 101, webSocket: client });
  }

  private leaseValid(ws: WebSocket): Attachment | null {
    const a = ws.deserializeAttachment() as Attachment | null;
    if (!a || a.leaseExp <= Math.floor(Date.now() / 1000)) return null;
    return a;
  }

  private reject(ws: WebSocket, message: string) {
    ws.send(JSON.stringify({ type: 'error', error: message }));
  }

  webSocketMessage(ws: WebSocket, data: string | ArrayBuffer) {
    const att = this.leaseValid(ws);
    if (!att) {
      ws.close(1008, 'session lease expired');
      return;
    }
    if (typeof data !== 'string') return this.reject(ws, 'text frames only');
    if (enc.encode(data).byteLength > MAX_FRAME_BYTES) {
      ws.close(1009, 'message too big');
      return;
    }
    let parsed: unknown;
    try {
      parsed = JSON.parse(data);
    } catch {
      return this.reject(ws, 'invalid json');
    }
    const text = parsed && typeof parsed === 'object' ? (parsed as { text?: unknown }).text : undefined;
    if (typeof text !== 'string' || text.trim().length === 0 || Array.from(text).length > MAX_TEXT_CHARS) {
      return this.reject(ws, 'invalid text');
    }

    // Persist first (synchronous, single-threaded => unique ordered seq), then broadcast.
    const sql = this.ctx.storage.sql;
    const seq = sql.exec<{ seq: number }>('INSERT INTO messages (user_id, text) VALUES (?, ?) RETURNING seq', att.userId, text).one().seq;
    sql.exec('DELETE FROM messages WHERE seq <= ?', seq - KEEP_MESSAGES);

    const out = JSON.stringify({ type: 'message', seq, userId: att.userId, text });
    for (const peer of this.ctx.getWebSockets()) {
      if (!this.leaseValid(peer)) {
        peer.close(1008, 'session lease expired');
        continue;
      }
      try {
        peer.send(out);
      } catch {
        // peer already gone; nothing to do
      }
    }
  }

  webSocketClose(ws: WebSocket, code: number) {
    // 1005/1006 are reserved and cannot be echoed back.
    try {
      ws.close(code >= 1000 && code < 1005 ? code : 1000);
    } catch {
      // already closed
    }
  }

  webSocketError(ws: WebSocket) {
    try {
      ws.close(1011, 'error');
    } catch {
      // already closed
    }
  }
}
