<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Team review rooms</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 0 auto; padding: 1rem; line-height: 1.4; }
  section { border: 1px solid #ccc; border-radius: 8px; padding: 1rem; margin: 1rem 0; }
  label { display: block; margin: .5rem 0; }
  input:not([type=file]), select { display: block; width: 100%; box-sizing: border-box; padding: .4rem; font: inherit; }
  button { padding: .5rem 1rem; font: inherit; margin-top: .5rem; }
  ul { padding-left: 1.2rem; }
  #room-messages { max-height: 16rem; overflow-y: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
  [hidden] { display: none !important; }
</style>
</head>
<body>
<h1>Team review rooms</h1>
<p><a href="/">Home</a></p>

<p id="signed-out" hidden>You are not signed in. <a href="/">Sign in on the home page</a>, then reload this page.</p>

<div id="app" hidden>
  <p>Signed in as <strong id="who"></strong></p>

  <section>
    <h2>Teams</h2>
    <label>New team name <input data-testid="team-name" maxlength="80"></label>
    <button data-testid="team-create" type="button" disabled>Create team</button>
    <label>Your teams <select data-testid="team-select" disabled></select></label>
    <p id="team-status" role="status"></p>
  </section>

  <section>
    <h2>Room</h2>
    <label>Room <input data-testid="room-name" value="general" maxlength="40"></label>
    <button data-testid="room-connect" type="button" disabled>Connect</button>
    <p data-testid="room-status" role="status">idle</p>
    <ul data-testid="room-messages" aria-live="polite"></ul>
    <label>Message <input data-testid="message-text" maxlength="1000" disabled></label>
    <button data-testid="message-send" type="button" disabled>Send</button>
  </section>

  <section>
    <h2>Team files</h2>
    <label>File (max 1 MiB) <input data-testid="team-upload" type="file" disabled></label>
    <p id="upload-status" role="status"></p>
    <ul data-testid="file-list"></ul>
  </section>
</div>

<script>
const $ = (id) => document.querySelector(`[data-testid="${id}"]`);
const byId = (id) => document.getElementById(id);
const api = (path, opts = {}) => fetch(path, { credentials: 'same-origin', ...opts });
const ROOM = /^[A-Za-z0-9_-]{1,40}$/;

let socket = null;       // the single live connection
let connected = false;   // true once the snapshot arrived on `socket`
let connecting = false;
let busyCreate = false;
let uploading = false;
const seen = new Set();  // seqs rendered for the current connection
const filesByTeam = new Map();

const rolesByTeam = new Map();  // role per team as of the last team load (server re-checks every action)

const currentTeam = () => $('team-select').value;
const canWrite = () => !!currentTeam() && rolesByTeam.get(currentTeam()) !== 'viewer';

function setStatus(text) { $('room-status').textContent = text; }

function refresh() {
  const hasTeam = !!currentTeam();
  $('team-create').disabled = busyCreate || !$('team-name').value.trim();
  $('team-select').disabled = $('team-select').options.length === 0;
  $('room-connect').disabled = !hasTeam || connecting;
  $('team-upload').disabled = !canWrite() || uploading;
  $('message-text').disabled = !connected || !canWrite();
  $('message-send').disabled = !connected || !canWrite();
}

function renderMessage(m) {
  if (seen.has(m.seq)) return;
  seen.add(m.seq);
  const li = document.createElement('li');
  li.textContent = `${m.userId}: ${m.text}`;
  li.dataset.seq = String(m.seq);
  $('room-messages').appendChild(li);
  $('room-messages').scrollTop = $('room-messages').scrollHeight;
}

function disconnect() {
  const old = socket;
  socket = null;
  connected = false;
  connecting = false;
  if (old) { try { old.close(1000, 'Leaving room'); } catch { /* already closed */ } }
}

function connect() {
  const team = currentTeam();
  const room = $('room-name').value.trim();
  if (!team) return;
  if (!ROOM.test(room)) { setStatus('error: room names use letters, digits, _ and - (max 40)'); return; }
  disconnect();
  seen.clear();
  $('room-messages').replaceChildren();
  connecting = true;
  setStatus('connecting');
  refresh();
  const url = new URL(`/api/teams/${encodeURIComponent(team)}/rooms/${encodeURIComponent(room)}/ws`, location.href);
  url.protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
  const ws = new WebSocket(url);
  socket = ws;
  ws.onmessage = ({ data }) => {
    if (socket !== ws) return;
    let ev;
    try { ev = JSON.parse(data); } catch { return; }
    if (ev.type === 'snapshot' && Array.isArray(ev.messages)) {
      seen.clear();
      $('room-messages').replaceChildren();
      ev.messages.forEach(renderMessage);
      connected = true;
      connecting = false;
      setStatus('connected');
      refresh();
    } else if (ev.type === 'message') {
      renderMessage(ev);
    } else if (ev.type === 'error') {
      const why = ev.code === 'forbidden' ? 'not permitted' : String(ev.error);
      setStatus(`${connected ? 'connected' : 'error'} (message rejected: ${why})`);
    }
  };
  ws.onerror = () => { if (socket === ws) setStatus('error: connection failed'); };
  ws.onclose = () => {
    if (socket !== ws) return;
    socket = null;
    connected = false;
    connecting = false;
    if (!$('room-status').textContent.startsWith('error')) setStatus('closed');
    refresh();
  };
}

function renderFiles() {
  const list = $('file-list');
  list.replaceChildren();
  for (const f of filesByTeam.get(currentTeam()) ?? []) {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = f.href;
    a.download = f.name;
    a.textContent = f.name;
    li.appendChild(a);
    list.appendChild(li);
  }
}

async function loadTeams(selectId) {
  const r = await api('/api/teams');
  if (!r.ok) { byId('team-status').textContent = 'Could not load teams'; return; }
  const { teams } = await r.json();
  const select = $('team-select');
  const keep = selectId ?? select.value;
  select.replaceChildren();
  rolesByTeam.clear();
  for (const t of teams) {
    rolesByTeam.set(t.id, t.role);
    const o = document.createElement('option');
    o.value = t.id;
    o.textContent = `${t.name} (${t.role})`;
    select.appendChild(o);
  }
  if (teams.some((t) => t.id === keep)) select.value = keep;
  renderFiles();
  refresh();
}

async function boot() {
  const r = await api('/api/session');
  if (!r.ok) { byId('signed-out').hidden = false; return; }
  byId('who').textContent = (await r.json()).user.email;
  byId('app').hidden = false;
  await loadTeams();
}

$('team-name').addEventListener('input', refresh);
$('team-select').addEventListener('change', () => { disconnect(); setStatus('idle'); renderFiles(); refresh(); });

$('team-create').addEventListener('click', async () => {
  const name = $('team-name').value.trim();
  if (!name) return;
  busyCreate = true;
  refresh();
  try {
    const r = await api('/api/teams', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
    if (!r.ok) { byId('team-status').textContent = r.status === 401 ? 'Please sign in again' : 'Could not create team'; return; }
    const team = await r.json();
    $('team-name').value = '';
    byId('team-status').textContent = `Created ${team.name}`;
    disconnect();
    setStatus('idle');
    await loadTeams(team.id);
  } catch {
    byId('team-status').textContent = 'Could not create team';
  } finally {
    busyCreate = false;
    refresh();
  }
});

$('room-connect').addEventListener('click', connect);

function send() {
  const input = $('message-text');
  const text = input.value;
  if (!connected || !socket || !canWrite() || !text.trim()) return;
  // The id is generated once per send and the UI never resends on reconnect.
  socket.send(JSON.stringify({ text, clientId: crypto.randomUUID() }));
  input.value = '';
}
$('message-send').addEventListener('click', send);
$('message-text').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); send(); } });

$('team-upload').addEventListener('change', async (e) => {
  const input = e.target;
  const file = input.files[0];
  const team = currentTeam();
  const status = byId('upload-status');
  if (!file || !team) return;
  if (file.size > 1024 * 1024) { status.textContent = 'File too large (max 1 MiB)'; input.value = ''; return; }
  uploading = true;
  refresh();
  status.textContent = 'Uploading…';
  try {
    const r = await api(`/api/teams/${encodeURIComponent(team)}/uploads`, { method: 'POST', headers: { 'Content-Type': 'application/octet-stream' }, body: file });
    if (!r.ok) { status.textContent = r.status === 413 ? 'File too large (max 1 MiB)' : r.status === 403 ? 'Not permitted to upload to this team' : 'Upload failed'; return; }
    const { id } = await r.json();
    const files = filesByTeam.get(team) ?? [];
    files.push({ name: file.name, href: `/api/teams/${encodeURIComponent(team)}/uploads/${encodeURIComponent(id)}` });
    filesByTeam.set(team, files);
    status.textContent = 'Uploaded';
    if (currentTeam() === team) renderFiles();
  } catch {
    status.textContent = 'Upload failed';
  } finally {
    input.value = '';
    uploading = false;
    refresh();
  }
});

boot();
</script>
</body>
</html>
