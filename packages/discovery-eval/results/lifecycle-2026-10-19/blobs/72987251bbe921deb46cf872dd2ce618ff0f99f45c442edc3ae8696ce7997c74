import type { Context, Hono, MiddlewareHandler } from 'hono';
import { forwardToRoom, ROOM_NAME } from './routes/team-room';

type Vars = { userId: string; email: string; sessionId: string; sessionExpires: number };
type App = Hono<{ Bindings: Env; Variables: Vars }>;
type C = Context<{ Bindings: Env; Variables: Vars }>;

export interface TeamDeps {
  requireAuth: MiddlewareHandler<{ Bindings: Env; Variables: Vars }>;
  readJson: (c: C) => Promise<Record<string, unknown> | null>;
  readBounded: (req: Request, limit: number) => Promise<Uint8Array | null>;
  knownUsers: string[];
  maxUpload: number;
}

const TEAM_ID = /^[A-Za-z0-9_-]{1,80}$/;
const now = () => Math.floor(Date.now() / 1000);

/** Current membership straight from D1 (no cache). Returns the role or null. */
async function roleOf(env: Env, team: string, userId: string): Promise<string | null> {
  if (!TEAM_ID.test(team)) return null;
  const row = await env.DB.prepare('SELECT role FROM team_members WHERE team_id = ? AND user_id = ?').bind(team, userId).first<{ role: string }>();
  return row?.role ?? null;
}

export function registerTeamRoutes(app: App, deps: TeamDeps) {
  const { requireAuth, readJson, readBounded, knownUsers, maxUpload } = deps;
  const noStore = { 'Cache-Control': 'private, no-store' };

  app.post('/api/teams', requireAuth, async (c) => {
    const body = await readJson(c);
    const name = typeof body?.name === 'string' ? body.name.trim() : '';
    if (name.length < 1 || name.length > 80) return c.json({ error: 'invalid name' }, 400);
    const id = `team_${crypto.randomUUID()}`;
    const userId = c.get('userId');
    await c.env.DB.batch([
      c.env.DB.prepare('INSERT INTO teams (id, name, created_by, created_at) VALUES (?, ?, ?, ?)').bind(id, name, userId, now()),
      c.env.DB.prepare("INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'owner', ?)").bind(id, userId, now()),
    ]);
    return c.json({ id, name }, 201, noStore);
  });

  app.get('/api/teams', requireAuth, async (c) => {
    const { results } = await c.env.DB.prepare(
      'SELECT t.id, t.name, m.role FROM team_members m JOIN teams t ON t.id = m.team_id WHERE m.user_id = ? ORDER BY t.created_at, t.id',
    ).bind(c.get('userId')).all<{ id: string; name: string; role: string }>();
    return c.json({ teams: results }, 200, noStore);
  });

  // Owner-only membership management. Non-members and non-owners both get 403.
  const manage = async (c: C) => {
    const team = c.req.param('team') ?? '';
    if ((await roleOf(c.env, team, c.get('userId'))) !== 'owner') return c.json({ error: 'forbidden' }, 403);
    const target = c.req.param('userId') ?? '';
    if (!knownUsers.includes(target)) return c.json({ error: 'unknown user' }, 400);
    const targetRole = await roleOf(c.env, team, target);
    if (targetRole === 'owner') return c.json({ error: 'owner membership is fixed' }, 409);
    return { team, target };
  };

  app.put('/api/teams/:team/members/:userId', requireAuth, async (c) => {
    const body = await readJson(c);
    if (!body || body.role !== 'member') return c.json({ error: 'invalid role' }, 400);
    const r = await manage(c);
    if (r instanceof Response) return r;
    await c.env.DB.prepare(
      "INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'member', ?) ON CONFLICT(team_id, user_id) DO UPDATE SET role = 'member' WHERE role != 'owner'",
    ).bind(r.team, r.target, now()).run();
    return c.body(null, 204);
  });

  app.delete('/api/teams/:team/members/:userId', requireAuth, async (c) => {
    const r = await manage(c);
    if (r instanceof Response) return r;
    await c.env.DB.prepare("DELETE FROM team_members WHERE team_id = ? AND user_id = ? AND role != 'owner'").bind(r.team, r.target).run();
    return c.body(null, 204);
  });

  // ---- team uploads ----

  const keyFor = (team: string, id: string) => `teams/${team}/${id}`;

  app.post('/api/teams/:team/uploads', requireAuth, async (c) => {
    const team = c.req.param('team');
    if (!(await roleOf(c.env, team, c.get('userId')))) return c.json({ error: 'forbidden' }, 403);
    const data = await readBounded(c.req.raw, maxUpload);
    if (!data) return c.json({ error: 'too large' }, 413);
    const id = crypto.randomUUID();
    const key = keyFor(team, id);
    await c.env.UPLOADS.put(key, data, { httpMetadata: { contentType: 'application/octet-stream' } });
    try {
      await c.env.DB.prepare('INSERT INTO team_uploads (id, team_id, uploaded_by, object_key, size, created_at) VALUES (?, ?, ?, ?, ?, ?)')
        .bind(id, team, c.get('userId'), key, data.byteLength, now()).run();
    } catch (e) {
      await c.env.UPLOADS.delete(key);
      throw e;
    }
    return c.json({ id }, 201, noStore);
  });

  const findTeamUpload = async (c: C) => {
    const team = c.req.param('team') ?? '';
    if (!(await roleOf(c.env, team, c.get('userId')))) return c.json({ error: 'forbidden' }, 403);
    const id = c.req.param('id') ?? '';
    const row = await c.env.DB.prepare('SELECT id FROM team_uploads WHERE id = ? AND team_id = ?').bind(id, team).first<{ id: string }>();
    return row ? { key: keyFor(team, row.id), id: row.id } : c.json({ error: 'not found' }, 404);
  };

  app.get('/api/teams/:team/uploads/:id', requireAuth, async (c) => {
    const f = await findTeamUpload(c);
    if (f instanceof Response) return f;
    const obj = await c.env.UPLOADS.get(f.key);
    if (!obj) return c.json({ error: 'not found' }, 404);
    return new Response(obj.body, {
      headers: {
        'Content-Type': 'application/octet-stream',
        'Content-Length': String(obj.size),
        'Content-Disposition': 'attachment; filename="download.bin"',
        'X-Content-Type-Options': 'nosniff',
        'Cache-Control': 'private, no-store',
      },
    });
  });

  app.delete('/api/teams/:team/uploads/:id', requireAuth, async (c) => {
    const f = await findTeamUpload(c);
    if (f instanceof Response) return f;
    await c.env.UPLOADS.delete(f.key);
    await c.env.DB.prepare('DELETE FROM team_uploads WHERE id = ? AND team_id = ?').bind(f.id, c.req.param('team')).run();
    return c.body(null, 204);
  });

  // ---- rooms ----

  app.get('/api/teams/:team/rooms/:room/ws', requireAuth, async (c) => {
    const url = new URL(c.req.url);
    const team = c.req.param('team');
    const room = c.req.param('room');
    if (!ROOM_NAME.test(room) || url.search) return c.json({ error: 'invalid room' }, 400);
    if (c.req.header('Origin') !== url.origin) return c.json({ error: 'bad origin' }, 403);
    // Membership is read from D1 on every handshake, so removal applies to new connections at once.
    if (!(await roleOf(c.env, team, c.get('userId')))) return c.json({ error: 'forbidden' }, 403);
    if (c.req.header('Upgrade')?.toLowerCase() !== 'websocket') return c.json({ error: 'upgrade required' }, 426);
    return forwardToRoom(c.req.raw, c.env.TEAM_ROOMS, team, room, {
      userId: c.get('userId'),
      tenantId: team,
      expiresAt: c.get('sessionExpires') * 1000,
    });
  });
}
