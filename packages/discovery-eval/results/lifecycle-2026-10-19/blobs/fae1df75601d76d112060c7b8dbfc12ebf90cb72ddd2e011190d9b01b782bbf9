import { describe, expect, it } from 'vitest';
import { SELF } from 'cloudflare:test';

const BASE = 'http://localhost';

async function login(email: string) {
  const r = await SELF.fetch(BASE + '/api/login', {
    method: 'POST',
    headers: { Origin: BASE, 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password: 'local-demo-password' }),
  });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

const call = (cookie: string | null, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, { ...init, headers: { Origin: BASE, ...(cookie ? { Cookie: cookie } : {}), ...(init.headers as object) } });
const json = (method: string, body: unknown): RequestInit => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

async function newTeam(cookie: string) {
  const r = await call(cookie, '/api/teams', json('POST', { name: 'Viewers' }));
  return ((await r.json()) as { id: string }).id;
}
const setRole = (cookie: string, team: string, role: string) => call(cookie, `/api/teams/${team}/members/user_bob`, json('PUT', { role }));

class Client {
  messages: any[] = [];
  constructor(public ws: WebSocket) {
    ws.addEventListener('message', (e) => {
      this.messages.push(JSON.parse(e.data as string));
    });
  }
  of(type: string) {
    return this.messages.filter((m) => m.type === type);
  }
  send(o: unknown) {
    this.ws.send(JSON.stringify(o));
  }
  async waitFor(pred: () => boolean, ms = 4000) {
    const end = Date.now() + ms;
    while (!pred()) {
      if (Date.now() > end) throw new Error('timeout: ' + JSON.stringify(this.messages));
      await sleep(20);
    }
  }
}

async function connect(cookie: string, team: string, room = 'general') {
  const r = await call(cookie, `/api/teams/${team}/rooms/${room}/ws`, { headers: { Upgrade: 'websocket' } });
  if (r.status !== 101) return { status: r.status, client: undefined as unknown as Client };
  const client = new Client(r.webSocket!);
  r.webSocket!.accept();
  await client.waitFor(() => client.messages.length >= 1);
  return { status: 101, client };
}

describe('viewer role over HTTP', () => {
  it('is assignable, listed, read-only for files and cannot manage', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    expect((await call(a, `/api/teams/${team}/members/user_bob`, json('PUT', { role: 'admin' }))).status).toBe(400);
    expect((await setRole(a, team, 'viewer')).status).toBe(204);
    const teams = (await (await call(b, '/api/teams')).json()) as any;
    expect(teams.teams.find((t: any) => t.id === team).role).toBe('viewer');

    const up = await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: new Uint8Array([1, 2, 3]) });
    const { id } = (await up.json()) as { id: string };
    expect((await call(b, `/api/teams/${team}/uploads/${id}`)).status).toBe(200);
    expect((await call(b, `/api/teams/${team}/uploads`, { method: 'POST', body: new Uint8Array([9]) })).status).toBe(403);
    expect((await call(b, `/api/teams/${team}/uploads/${id}`, { method: 'DELETE' })).status).toBe(403);
    expect((await call(b, `/api/teams/${team}/members/user_bob`, json('PUT', { role: 'member' }))).status).toBe(403);
    expect((await call(b, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' })).status).toBe(403);
    expect((await call(a, `/api/teams/${team}/members/user_alice`, json('PUT', { role: 'viewer' }))).status).toBe(409);
    // bytes untouched by the rejected delete
    expect((await call(a, `/api/teams/${team}/uploads/${id}`)).status).toBe(200);

    expect((await setRole(a, team, 'member')).status).toBe(204);
    expect((await call(b, `/api/teams/${team}/uploads`, { method: 'POST', body: new Uint8Array([9]) })).status).toBe(201);
  });
});

describe('open sockets honor current authority', () => {
  it('lets a viewer read but not write, with no commit', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await setRole(a, team, 'viewer');
    const ca = (await connect(a, team)).client;
    const cb = (await connect(b, team)).client;
    cb.send({ text: 'nope', clientId: 'v1' });
    await cb.waitFor(() => cb.of('error').length === 1);
    expect(cb.of('error')[0].code).toBe('forbidden');
    ca.send({ text: 'hello' });
    await cb.waitFor(() => cb.of('message').length === 1);
    expect(ca.of('message').map((m) => m.text)).toEqual(['hello']);
    const fresh = (await connect(a, team)).client;
    expect(fresh.messages[0].messages.map((m: any) => m.text)).toEqual(['hello']);
    for (const c of [ca, cb, fresh]) c.ws.close();
  });

  it('applies downgrade, removal and logout to already-open sockets', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await setRole(a, team, 'member');
    const ca = (await connect(a, team)).client;
    const cb = (await connect(b, team)).client;
    cb.send({ text: 'before' });
    await ca.waitFor(() => ca.of('message').length === 1);

    // downgrade: still receives, can no longer send
    await setRole(a, team, 'viewer');
    cb.send({ text: 'viewer-send' });
    await cb.waitFor(() => cb.of('error').some((e) => e.code === 'forbidden'));
    ca.send({ text: 'to-viewer' });
    await cb.waitFor(() => cb.of('message').some((m) => m.text === 'to-viewer'));

    // removal: neither commits nor receives
    await call(a, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' });
    cb.send({ text: 'removed-send' });
    await cb.waitFor(() => cb.of('error').some((e) => e.code === 'unauthorized'));
    ca.send({ text: 'after-removal' });
    await ca.waitFor(() => ca.of('message').some((m) => m.text === 'after-removal'));
    expect(cb.of('message').some((m) => m.text === 'after-removal')).toBe(false);

    // re-adding allows a new connection; the old socket stays dead
    await setRole(a, team, 'member');
    expect((await connect(b, team)).status).toBe(101);

    // logout revokes the session even though membership is intact
    const b2 = await login('bob@example.test');
    const cb2 = (await connect(b2, team)).client;
    await call(b2, '/api/logout', { method: 'POST' });
    cb2.send({ text: 'logged-out-send' });
    await cb2.waitFor(() => cb2.of('error').some((e) => e.code === 'unauthorized'));
    ca.send({ text: 'after-logout' });
    await ca.waitFor(() => ca.of('message').some((m) => m.text === 'after-logout'));
    expect(cb2.of('message').some((m) => m.text === 'after-logout')).toBe(false);
    expect((await connect(b2, team)).status).toBe(401);

    const texts = (await connect(a, team)).client.messages[0].messages.map((m: any) => m.text);
    expect(texts).toEqual(['before', 'to-viewer', 'after-removal', 'after-logout']);
    ca.ws.close();
  });
});

describe('clientId retries', () => {
  it('acks exact retries, including concurrent ones, and flags conflicts', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await setRole(a, team, 'member');
    const a1 = (await connect(a, team)).client;
    const a2 = (await connect(a, team)).client;
    const cb = (await connect(b, team)).client;

    a1.send({ text: 'once', clientId: 'id-1' });
    a2.send({ text: 'once', clientId: 'id-1' });
    await Promise.all([a1, a2, cb].map((c) => c.waitFor(() => c.of('message').length === 1)));
    await a1.waitFor(() => a1.of('ack').length + a2.of('ack').length === 1);
    await sleep(150);
    for (const c of [a1, a2, cb]) {
      expect(c.of('message')).toHaveLength(1);
      expect(c.of('message')[0].clientId).toBe('id-1');
    }
    expect(a1.of('ack').length + a2.of('ack').length).toBe(1);
    expect(cb.of('ack')).toHaveLength(0);
    const seq = cb.of('message')[0].seq;

    // later retry: ack only to the retrying socket, original seq, no new broadcast
    a1.send({ text: 'once', clientId: 'id-1' });
    await a1.waitFor(() => a1.of('ack').length >= 1);
    expect(a1.of('ack').at(-1)).toEqual({ type: 'ack', seq, clientId: 'id-1' });
    await sleep(100);
    expect(cb.of('message')).toHaveLength(1);

    // different text is a conflict that does not change history
    a1.send({ text: 'different', clientId: 'id-1' });
    await a1.waitFor(() => a1.of('error').some((e) => e.code === 'conflict'));
    expect(a1.of('error').find((e) => e.code === 'conflict').clientId).toBe('id-1');

    // another user may reuse the same ID; bad IDs are rejected
    cb.send({ text: 'bob once', clientId: 'id-1' });
    await cb.waitFor(() => cb.of('message').length === 2);
    expect(cb.of('message')[1].seq).not.toBe(seq);
    a1.send({ text: 'x', clientId: 'bad id!' });
    a1.send({ text: 'x', clientId: 5 });
    await a1.waitFor(() => a1.of('error').filter((e) => e.code === 'invalid').length === 2);

    const snap = (await connect(a, team)).client.messages[0].messages;
    expect(snap.map((m: any) => [m.text, m.clientId])).toEqual([
      ['once', 'id-1'],
      ['bob once', 'id-1'],
    ]);
    for (const c of [a1, a2, cb]) c.ws.close();
  });

  it('keeps dedupe records after history leaves the window and checks authority first', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await setRole(a, team, 'member');
    const ca = (await connect(a, team)).client;
    const cb = (await connect(b, team)).client;
    cb.send({ text: 'first', clientId: 'keep' });
    await cb.waitFor(() => cb.of('message').length === 1);
    for (let i = 0; i < 60; i++) ca.send({ text: `f${i}` });
    await ca.waitFor(() => ca.of('message').length === 61);
    const snap = (await connect(a, team)).client.messages[0].messages;
    expect(snap).toHaveLength(50);
    expect(snap.some((m: any) => m.clientId === 'keep')).toBe(false);

    cb.send({ text: 'first', clientId: 'keep' });
    await cb.waitFor(() => cb.of('ack').length === 1);
    expect(cb.of('ack')[0].seq).toBe(cb.of('message')[0].seq);

    // a previous success grants nothing once the sender is read-only or removed
    await setRole(a, team, 'viewer');
    cb.send({ text: 'first', clientId: 'keep' });
    await cb.waitFor(() => cb.of('error').some((e) => e.code === 'forbidden'));
    expect(cb.of('ack')).toHaveLength(1);
    await call(a, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' });
    cb.send({ text: 'different', clientId: 'keep' });
    await cb.waitFor(() => cb.of('error').some((e) => e.code === 'unauthorized'));
    expect(cb.of('error').some((e) => e.code === 'conflict')).toBe(false);
    expect(cb.of('ack')).toHaveLength(1);
    ca.ws.close();
  }, 20000);
});
