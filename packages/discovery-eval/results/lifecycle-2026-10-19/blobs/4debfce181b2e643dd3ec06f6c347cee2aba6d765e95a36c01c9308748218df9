import { describe, expect, it } from 'vitest';
import { SELF } from 'cloudflare:test';

const BASE = 'http://localhost';
const ALICE = 'user_alice';
const BOB = 'user_bob';

async function login(email: string) {
  const r = await SELF.fetch(BASE + '/api/login', {
    method: 'POST',
    headers: { Origin: BASE, 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password: 'local-demo-password' }),
  });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

const call = (cookie: string | null, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, {
    ...init,
    headers: { Origin: BASE, ...(cookie ? { Cookie: cookie } : {}), ...(init.headers as object) },
  });
const json = (method: string, body: unknown): RequestInit => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

async function createTeam(cookie: string, name = 'Reviewers') {
  const r = await call(cookie, '/api/teams', json('POST', { name }));
  expect(r.status).toBe(201);
  return ((await r.json()) as { id: string }).id;
}
const addMember = (cookie: string, team: string, user: string, role: unknown = 'member') =>
  call(cookie, `/api/teams/${team}/members/${user}`, json('PUT', { role }));

type Sock = { ws: WebSocket; next: () => Promise<any>; closed: Promise<void> };

async function openRoom(cookie: string, team: string, room: string, headers: Record<string, string> = {}): Promise<Sock> {
  const res = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/${room}/ws`, {
    headers: { Upgrade: 'websocket', Origin: BASE, Cookie: cookie, ...headers },
  });
  expect(res.status).toBe(101);
  const ws = res.webSocket!;
  const queue: any[] = [];
  const waiters: ((v: any) => void)[] = [];
  let onClosed!: () => void;
  const closed = new Promise<void>((r) => (onClosed = r));
  ws.addEventListener('message', (e) => {
    const v = JSON.parse(e.data as string);
    const w = waiters.shift();
    if (w) w(v);
    else queue.push(v);
  });
  ws.addEventListener('close', () => onClosed());
  ws.accept();
  return { ws, closed, next: () => (queue.length ? Promise.resolve(queue.shift()) : new Promise((r) => waiters.push(r))) };
}

describe('teams and membership', () => {
  it('creates, lists only own teams, and validates names', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    expect((await call(null, '/api/teams')).status).toBe(401);
    expect((await call(a, '/api/teams', json('POST', { name: '   ' }))).status).toBe(400);
    expect((await call(a, '/api/teams', json('POST', { name: 'x'.repeat(81) }))).status).toBe(400);
    expect((await call(a, '/api/teams', { ...json('POST', { name: 'ok' }), headers: { Origin: 'http://evil.test' } })).status).toBe(403);
    const created = await call(a, '/api/teams', json('POST', { name: '  Padded  ' }));
    expect(created.status).toBe(201);
    const team = (await created.json()) as { id: string; name: string };
    expect(team.name).toBe('Padded');
    const mine = (await (await call(a, '/api/teams')).json()) as { teams: { id: string; name: string; role: string }[] };
    expect(mine.teams).toContainEqual({ id: team.id, name: 'Padded', role: 'owner' });
    const theirs = (await (await call(b, '/api/teams')).json()) as { teams: { id: string }[] };
    expect(theirs.teams.find((t) => t.id === team.id)).toBeUndefined();
  });

  it('lets only the owner manage members and reads current authority', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    expect((await addMember(b, team, BOB)).status).toBe(403);
    expect((await addMember(a, team, 'user_mallory')).status).toBe(400);
    expect((await addMember(a, team, ALICE)).status).toBe(409);
    expect((await call(a, `/api/teams/${team}/members/${ALICE}`, { method: 'DELETE' })).status).toBe(409);
    expect((await addMember(a, team, BOB, 'owner')).status).toBe(400);
    expect((await addMember(a, team, BOB)).status).toBe(204);
    expect((await addMember(a, team, BOB)).status).toBe(204);
    expect(((await (await call(b, '/api/teams')).json()) as any).teams.map((t: any) => [t.id, t.role])).toContainEqual([team, 'member']);
    expect((await call(b, `/api/teams/${team}/members/${BOB}`, { method: 'DELETE' })).status).toBe(403);
    expect((await call(a, `/api/teams/${team}/members/${BOB}`, { method: 'DELETE' })).status).toBe(204);
    expect(((await (await call(b, '/api/teams')).json()) as any).teams.find((t: any) => t.id === team)).toBeUndefined();
    expect((await call(b, `/api/teams/${team}/uploads/x`)).status).toBe(403);
  });
});

describe('team uploads', () => {
  it('shares files within a team, isolates across teams and bounds size', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    const other = await createTeam(b, 'Bob only');
    await addMember(a, team, BOB);
    const bytes = new Uint8Array([0, 1, 2, 255, 254, 60, 115]);
    const up = await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes });
    expect(up.status).toBe(201);
    const { id } = (await up.json()) as { id: string };

    const dl = await call(b, `/api/teams/${team}/uploads/${id}`);
    expect(dl.status).toBe(200);
    expect(new Uint8Array(await dl.arrayBuffer())).toEqual(bytes);
    expect(dl.headers.get('Content-Type')).toBe('application/octet-stream');
    expect(dl.headers.get('Content-Disposition')).toContain('attachment');
    expect(dl.headers.get('X-Content-Type-Options')).toBe('nosniff');
    expect(dl.headers.get('Cache-Control')).toBe('private, no-store');

    // The id belongs to `team`; another team (even one the caller owns) must not see or delete it.
    expect((await call(b, `/api/teams/${other}/uploads/${id}`)).status).toBe(404);
    expect((await call(b, `/api/teams/${other}/uploads/${id}`, { method: 'DELETE' })).status).toBe(404);
    expect((await call(b, `/api/teams/${team}/uploads/${id}`)).status).toBe(200);

    // Personal uploads stay private.
    const personal = (await (await call(a, '/api/uploads', { method: 'POST', body: bytes })).json()) as { id: string };
    expect((await call(b, `/api/teams/${team}/uploads/${personal.id}`)).status).toBe(404);
    expect((await call(b, `/api/uploads/${personal.id}`)).status).toBe(404);

    expect((await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: new Uint8Array(1024 * 1024 + 1) })).status).toBe(413);
    const stream = new ReadableStream({ start(c) { c.enqueue(new Uint8Array(700 * 1024)); c.enqueue(new Uint8Array(400 * 1024)); c.close(); } });
    expect((await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: stream, duplex: 'half' } as RequestInit)).status).toBe(413);
    expect((await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: new Uint8Array(1024 * 1024) })).status).toBe(201);

    expect((await call(b, `/api/teams/${team}/uploads/${id}`, { method: 'DELETE' })).status).toBe(204);
    expect((await call(a, `/api/teams/${team}/uploads/${id}`)).status).toBe(404);
    expect((await call(null, `/api/teams/${team}/uploads/${id}`)).status).toBe(401);
  });
});

describe('rooms', () => {
  it('rejects bad handshakes and strips spoofed identity', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    const url = (room: string, qs = '') => `${BASE}/api/teams/${team}/rooms/${room}/ws${qs}`;
    const hs = (cookie: string | null, room: string, extra: Record<string, string> = {}, qs = '') =>
      SELF.fetch(url(room, qs), { headers: { Upgrade: 'websocket', ...(cookie ? { Cookie: cookie } : {}), ...extra } });

    expect((await hs(null, 'general', { Origin: BASE })).status).toBe(401);
    expect((await hs(b, 'general', { Origin: BASE })).status).toBe(403);
    expect((await hs(a, 'general')).status).toBe(403);
    expect((await hs(a, 'general', { Origin: 'null' })).status).toBe(403);
    expect((await hs(a, 'general', { Origin: 'http://evil.test' })).status).toBe(403);
    expect((await hs(a, 'general', { Origin: BASE }, '?x=1')).status).toBe(400);
    expect((await hs(a, 'bad.room', { Origin: BASE })).status).toBe(400);
    expect((await hs(a, 'x'.repeat(41), { Origin: BASE })).status).toBe(400);
    expect((await call(a, `/api/teams/${team}/rooms/general/ws`)).status).toBe(426);

    // Spoofed identity headers are replaced with the verified session identity.
    const s = await openRoom(a, team, 'spoof', { 'x-room-user': ALICE.replace('alice', 'mallory'), 'x-room-team': 'other', 'x-room-expires': '1' });
    expect((await s.next()).type).toBe('snapshot');
    s.ws.send(JSON.stringify({ text: 'hello' }));
    expect(await s.next()).toMatchObject({ type: 'message', userId: ALICE, text: 'hello' });
    s.ws.close(1000);
  });

  it('broadcasts to every member, snapshots history and rejects invalid input', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    await addMember(a, team, BOB);
    const sa = await openRoom(a, team, 'general');
    const sb = await openRoom(b, team, 'general');
    expect(await sa.next()).toEqual({ type: 'snapshot', messages: [] });
    await sb.next();

    sa.ws.send(JSON.stringify({ text: '<img src=x onerror=alert(1)>' }));
    sb.ws.send(JSON.stringify({ text: 'from bob' }));
    const gotA = [await sa.next(), await sa.next()];
    const gotB = [await sb.next(), await sb.next()];
    expect(gotA).toEqual(gotB);
    expect(gotA.map((m) => m.userId).sort()).toEqual([ALICE, BOB]);
    expect(gotA[1].seq).toBeGreaterThan(gotA[0].seq);

    for (const bad of ['not json', JSON.stringify({ text: '   ' }), JSON.stringify({ text: 5 }), JSON.stringify({ text: 'x'.repeat(1001) }), JSON.stringify(null)]) {
      sa.ws.send(bad);
      expect((await sa.next()).type).toBe('error');
    }
    const big = await openRoom(a, team, 'general');
    await big.next();
    big.ws.send(JSON.stringify({ text: 'x'.repeat(5000) }));
    await big.closed;

    const late = await openRoom(b, team, 'general');
    const snap = await late.next();
    expect(snap.messages.map((m: any) => m.text)).toEqual(gotA.map((m) => m.text));

    // Rooms are independent.
    const other = await openRoom(a, team, 'other');
    expect((await other.next()).messages).toEqual([]);
    for (const s of [sa, sb, late, other]) s.ws.close(1000);
  });

  it('keeps seq increasing across pruning and bounds the snapshot at 50', async () => {
    const a = await login('alice@example.test');
    const team = await createTeam(a);
    const s = await openRoom(a, team, 'busy');
    await s.next();
    let last = 0;
    for (let i = 1; i <= 70; i++) {
      s.ws.send(JSON.stringify({ text: `m${i}` }));
      const m = await s.next();
      expect(m.seq).toBeGreaterThan(last);
      last = m.seq;
    }
    s.ws.close(1000);
    const again = await openRoom(a, team, 'busy');
    const snap = (await again.next()).messages as { seq: number; text: string }[];
    expect(snap).toHaveLength(50);
    expect(snap[0].text).toBe('m21');
    expect(snap[49].text).toBe('m70');
    expect(snap.map((m) => m.seq)).toEqual([...snap.map((m) => m.seq)].sort((x, y) => x - y));
    again.ws.send(JSON.stringify({ text: 'next' }));
    expect((await again.next()).seq).toBeGreaterThan(last);
    again.ws.close(1000);
  });

  it('honors logout and membership removal for new handshakes', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    await addMember(a, team, BOB);
    (await openRoom(b, team, 'general')).ws.close(1000);
    expect((await call(a, `/api/teams/${team}/members/${BOB}`, { method: 'DELETE' })).status).toBe(204);
    const denied = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/general/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: b } });
    expect(denied.status).toBe(403);
    expect((await call(a, '/api/logout', { method: 'POST' })).status).toBe(204);
    const out = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/general/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: a } });
    expect(out.status).toBe(401);
  });
});

