import { DurableObject } from 'cloudflare:workers';

const MAX_TEXT = 1000;
const MAX_FRAME_BYTES = 4096;
const SNAPSHOT_SIZE = 50;
const RETAIN = 1000;
export const LEASE_S = 5 * 60;

// Serialized per-socket (survives hibernation). Set only from the verified Worker handshake.
interface Attachment {
  userId: string;
  teamId: string;
  sessionId: string;
  leaseExpires: number; // epoch seconds, <= session expiry and <= 5 minutes from grant
  sessionExpires: number;
}

const enc = new TextEncoder();
const nowS = () => Math.floor(Date.now() / 1000);

/**
 * One instance per team/room. Reachable only through the Worker's ROOMS binding, which
 * calls it after verifying session, membership, origin and room name. Verified identity
 * is passed in x-room-* headers that the Worker replaces unconditionally.
 */
export class RoomDO extends DurableObject<Env> {
  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    ctx.blockConcurrencyWhile(async () => {
      ctx.storage.sql.exec('CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY, user_id TEXT NOT NULL, text TEXT NOT NULL, created_at INTEGER NOT NULL)');
      ctx.storage.sql.exec('CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v INTEGER NOT NULL)');
    });
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  async fetch(request: Request): Promise<Response> {
    if (request.headers.get('Upgrade')?.toLowerCase() !== 'websocket') return new Response('expected websocket', { status: 426 });
    const userId = request.headers.get('x-room-user');
    const teamId = request.headers.get('x-room-team');
    const sessionId = request.headers.get('x-room-session');
    const sessionExpires = Number(request.headers.get('x-room-session-expires'));
    if (!userId || !teamId || !sessionId || !Number.isFinite(sessionExpires)) return new Response('forbidden', { status: 403 });

    const pair = new WebSocketPair();
    const [client, server] = [pair[0], pair[1]];
    const att: Attachment = { userId, teamId, sessionId, sessionExpires, leaseExpires: Math.min(nowS() + LEASE_S, sessionExpires) };
    this.ctx.acceptWebSocket(server);
    server.serializeAttachment(att);
    server.send(JSON.stringify({ type: 'snapshot', messages: this.snapshot() }));
    return new Response(null, { status: 101, webSocket: client });
  }

  private snapshot() {
    return this.ctx.storage.sql
      .exec(`SELECT seq, user_id AS userId, text FROM (SELECT * FROM messages ORDER BY seq DESC LIMIT ${SNAPSHOT_SIZE}) ORDER BY seq ASC`)
      .toArray();
  }

  private append(userId: string, text: string): number {
    const sql = this.ctx.storage.sql;
    return this.ctx.storage.transactionSync(() => {
      sql.exec("INSERT INTO meta (k, v) VALUES ('seq', 1) ON CONFLICT(k) DO UPDATE SET v = v + 1");
      const seq = sql.exec("SELECT v FROM meta WHERE k = 'seq'").one().v as number;
      sql.exec('INSERT INTO messages (seq, user_id, text, created_at) VALUES (?, ?, ?, ?)', seq, userId, text, Date.now());
      sql.exec('DELETE FROM messages WHERE seq <= ?', seq - RETAIN);
      return seq;
    });
  }

  /** Current authority: session not revoked/expired and still a team member. */
  private async authorized(att: Attachment): Promise<boolean> {
    const row = await this.env.DB.prepare(
      'SELECT 1 AS ok FROM sessions s JOIN team_members m ON m.user_id = s.user_id WHERE s.id = ? AND s.revoked_at IS NULL AND s.expires_at > ? AND m.team_id = ? AND m.user_id = ?',
    )
      .bind(att.sessionId, nowS(), att.teamId, att.userId)
      .first();
    return !!row;
  }

  private fail(ws: WebSocket, message: string, close = false) {
    try {
      ws.send(JSON.stringify({ type: 'error', error: message }));
      if (close) ws.close(1008, message);
    } catch {
      /* socket already gone */
    }
  }

  async webSocketMessage(ws: WebSocket, message: string | ArrayBuffer) {
    const att = ws.deserializeAttachment() as Attachment | null;
    if (!att) return ws.close(1008, 'unauthorized');
    if (typeof message !== 'string') return this.fail(ws, 'text frames only');
    if (enc.encode(message).byteLength > MAX_FRAME_BYTES) return this.fail(ws, 'message too large');

    let body: unknown;
    try {
      body = JSON.parse(message);
    } catch {
      return this.fail(ws, 'invalid json');
    }
    const text = body && typeof body === 'object' && !Array.isArray(body) ? (body as { text?: unknown }).text : undefined;
    if (typeof text !== 'string' || text.trim().length === 0 || text.length > MAX_TEXT) return this.fail(ws, 'invalid text');

    if (!(await this.authorized(att))) return this.fail(ws, 'unauthorized', true);

    const seq = this.append(att.userId, text);
    const frame = JSON.stringify({ type: 'message', seq, userId: att.userId, text });
    await this.broadcast(frame);
  }

  private async broadcast(frame: string) {
    const now = nowS();
    for (const peer of this.ctx.getWebSockets()) {
      const att = peer.deserializeAttachment() as Attachment | null;
      if (!att) continue;
      if (att.leaseExpires <= now) {
        // Lease lapsed: renew only if the member is still authorized.
        if (att.sessionExpires <= now || !(await this.authorized(att))) {
          this.fail(peer, 'unauthorized', true);
          continue;
        }
        peer.serializeAttachment({ ...att, leaseExpires: Math.min(now + LEASE_S, att.sessionExpires) });
      }
      try {
        peer.send(frame);
      } catch {
        /* peer closing */
      }
    }
  }

  webSocketClose(ws: WebSocket, code: number) {
    try {
      ws.close(code === 1005 || code === 1006 ? 1000 : code);
    } catch {
      /* already closed */
    }
  }

  webSocketError(ws: WebSocket) {
    try {
      ws.close(1011, 'error');
    } catch {
      /* already closed */
    }
  }
}
