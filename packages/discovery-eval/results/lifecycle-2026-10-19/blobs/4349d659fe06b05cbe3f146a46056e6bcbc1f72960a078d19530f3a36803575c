export function retryDelay(attempt, random = Math.random) {
  return Math.round(Math.min(5000 * 2 ** attempt, 30000) * (0.85 + random() * 0.3));
}
// `path` is the same-origin WebSocket route, e.g. /api/teams/<team>/rooms/<room>/ws.
export function connectRoom(path, onEvent, onStatus) {
  let socket, timer, ping, stable, stopped = false, attempts = 0;
  const clear = () => { clearTimeout(timer); clearInterval(ping); clearTimeout(stable); };
  function connect() {
    if (stopped) return;
    onStatus('connecting');
    const url = new URL(path, location.href);
    url.protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const current = (socket = new WebSocket(url));
    current.onopen = () => {
      if (stopped || socket !== current) { current.close(1000); return; }
      onStatus('connected');
      stable = setTimeout(() => { attempts = 0; }, 10000);
      ping = setInterval(() => { if (current.readyState === WebSocket.OPEN) current.send('ping'); }, 20000);
    };
    current.onmessage = ({ data }) => {
      if (stopped || socket !== current || data === 'pong') return;
      try { onEvent(JSON.parse(data)); } catch { onStatus('invalid server message'); }
    };
    current.onclose = ({ code }) => {
      if (socket !== current) return;
      clear();
      if (stopped) return;
      if (code === 1000 || code === 1008 || attempts >= 10) { onStatus(code === 1008 ? 'closed: sign in again or wait before reconnecting' : 'closed'); return; }
      onStatus('reconnecting');
      timer = setTimeout(connect, retryDelay(attempts++));
    };
    current.onerror = () => { if (socket === current) onStatus('failed'); };
  }
  connect();
  return {
    // A clientId makes a retry of the same message idempotent on the server; it is never resent automatically.
    send(text, clientId) { if (socket?.readyState !== WebSocket.OPEN) return false; socket.send(JSON.stringify(clientId ? { text, clientId } : { text })); return true; },
    close() { stopped = true; clear(); socket?.close(1000, 'Leaving room'); },
  };
}
