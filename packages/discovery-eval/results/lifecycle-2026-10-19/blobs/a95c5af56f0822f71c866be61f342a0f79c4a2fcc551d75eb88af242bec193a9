import { describe, expect, it } from 'vitest';
import { SELF, env } from 'cloudflare:test';

const BASE = 'http://localhost';

async function login(email: string) {
  const r = await SELF.fetch(BASE + '/api/login', {
    method: 'POST',
    headers: { Origin: BASE, 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password: 'local-demo-password' }),
  });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

const call = (cookie: string | null, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, { ...init, headers: { Origin: BASE, ...(cookie ? { Cookie: cookie } : {}), ...(init.headers as object) } });
const json = (method: string, body: unknown): RequestInit => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

async function newTeam(cookie: string, name = 'Reviewers') {
  const r = await call(cookie, '/api/teams', json('POST', { name }));
  expect(r.status).toBe(201);
  return ((await r.json()) as { id: string }).id;
}

const addBob = (cookie: string, team: string) => call(cookie, `/api/teams/${team}/members/user_bob`, json('PUT', { role: 'member' }));

class Client {
  messages: any[] = [];
  constructor(public ws: WebSocket) {
    ws.addEventListener('message', (e) => {
      this.messages.push(JSON.parse(e.data as string));
    });
  }
  count(type: string) {
    return this.messages.filter((m) => m.type === type);
  }
  async waitFor(pred: (m: any[]) => boolean, ms = 4000) {
    const end = Date.now() + ms;
    while (!pred(this.messages)) {
      if (Date.now() > end) throw new Error('timeout: ' + JSON.stringify(this.messages));
      await new Promise((r) => setTimeout(r, 20));
    }
  }
}

async function connect(cookie: string | null, team: string, room = 'general', headers: Record<string, string> = {}) {
  const r = await call(cookie, `/api/teams/${team}/rooms/${room}/ws`, { headers: { Upgrade: 'websocket', ...headers } });
  if (r.status !== 101) return { status: r.status, client: undefined as unknown as Client };
  const ws = r.webSocket!;
  const client = new Client(ws);
  ws.accept();
  return { status: 101, client };
}

describe('teams', () => {
  it('creates, lists only own teams and validates names', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    expect((await call(null, '/api/teams')).status).toBe(401);
    expect((await call(a, '/api/teams', json('POST', { name: '   ' }))).status).toBe(400);
    expect((await call(a, '/api/teams', json('POST', { name: 'x'.repeat(81) }))).status).toBe(400);
    expect((await call(a, '/api/teams', { ...json('POST', { name: 'Evil' }), headers: { Origin: 'http://evil.test' } })).status).toBe(403);
    const r = await call(a, '/api/teams', json('POST', { name: '  Alpha  ' }));
    expect(r.status).toBe(201);
    const { id, name } = (await r.json()) as any;
    expect(name).toBe('Alpha');
    const mine = (await (await call(a, '/api/teams')).json()) as any;
    expect(mine.teams).toContainEqual({ id, name: 'Alpha', role: 'owner' });
    const theirs = (await (await call(b, '/api/teams')).json()) as any;
    expect(theirs.teams.find((t: any) => t.id === id)).toBeUndefined();
  });

  it('manages membership as owner only', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    expect((await addBob(b, team)).status).toBe(403);
    expect((await call(a, `/api/teams/${team}/members/user_eve`, json('PUT', { role: 'member' }))).status).toBe(400);
    expect((await call(a, `/api/teams/${team}/members/user_alice`, json('PUT', { role: 'member' }))).status).toBe(409);
    expect((await call(a, `/api/teams/${team}/members/user_alice`, { method: 'DELETE' })).status).toBe(409);
    expect((await addBob(a, team)).status).toBe(204);
    expect((await addBob(a, team)).status).toBe(204);
    const bobTeams = (await (await call(b, '/api/teams')).json()) as any;
    expect(bobTeams.teams).toContainEqual({ id: team, name: 'Reviewers', role: 'member' });
    expect((await call(b, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' })).status).toBe(403);
    expect((await call(a, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' })).status).toBe(204);
    expect(((await (await call(b, '/api/teams')).json()) as any).teams.find((t: any) => t.id === team)).toBeUndefined();
  });
});

describe('team uploads', () => {
  it('shares files between members, isolates teams, honors removal and bounds', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    const other = await newTeam(a, 'Other');
    await addBob(a, team);
    const bytes = new Uint8Array([0, 255, 10, 13, 128]);
    const up = await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes });
    expect(up.status).toBe(201);
    const { id } = (await up.json()) as { id: string };

    const dl = await call(b, `/api/teams/${team}/uploads/${id}`);
    expect(dl.status).toBe(200);
    expect(new Uint8Array(await dl.arrayBuffer())).toEqual(bytes);
    expect(dl.headers.get('Content-Type')).toBe('application/octet-stream');
    expect(dl.headers.get('Content-Disposition')).toContain('attachment');
    expect(dl.headers.get('X-Content-Type-Options')).toBe('nosniff');
    expect(dl.headers.get('Cache-Control')).toBe('private, no-store');

    // an ID from another team must not resolve
    expect((await call(a, `/api/teams/${other}/uploads/${id}`)).status).toBe(404);
    expect((await call(a, `/api/teams/${other}/uploads/${id}`, { method: 'DELETE' })).status).toBe(404);
    expect((await call(b, `/api/teams/${other}/uploads/${id}`)).status).toBe(403);
    expect((await call(a, `/api/teams/${team}/uploads/${id}`)).status).toBe(200);

    // size bounds: declared and streamed (chunked) bodies
    expect((await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: new Uint8Array(1024 * 1024 + 1) })).status).toBe(413);
    const chunked = new ReadableStream({
      pull(ctl) {
        ctl.enqueue(new Uint8Array(300 * 1024));
      },
    });
    const big = await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: chunked, duplex: 'half' } as RequestInit);
    expect(big.status).toBe(413);
    expect((await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: new Uint8Array(1024 * 1024) })).status).toBe(201);

    // removed members lose access immediately; personal uploads stay private
    await call(a, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' });
    expect((await call(b, `/api/teams/${team}/uploads/${id}`)).status).toBe(403);
    expect((await call(b, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes })).status).toBe(403);
    expect((await call(b, `/api/uploads/${id}`)).status).toBe(404);

    expect((await call(a, `/api/teams/${team}/uploads/${id}`, { method: 'DELETE' })).status).toBe(204);
    expect((await call(a, `/api/teams/${team}/uploads/${id}`)).status).toBe(404);
    expect((await env.UPLOADS.list({ prefix: `teams/${team}/${id}` })).objects).toHaveLength(0);
  });
});

describe('rooms', () => {
  it('rejects hostile handshakes', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    expect((await connect(null, team)).status).toBe(401);
    expect((await connect(b, team)).status).toBe(403);
    expect((await connect(a, team, 'general', { Origin: 'http://evil.test' })).status).toBe(403);
    expect((await connect(a, team, 'general', { Origin: 'null' })).status).toBe(403);
    expect((await connect(a, team, 'bad.room')).status).toBe(400);
    const q = await call(a, `/api/teams/${team}/rooms/general/ws?x=1`, { headers: { Upgrade: 'websocket' } });
    expect(q.status).toBe(400);
    const noOrigin = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/general/ws`, { headers: { Upgrade: 'websocket', Cookie: a } });
    expect(noOrigin.status).toBe(403);
    // spoofed identity headers are replaced with the verified identity
    const ok = await connect(a, team, 'general', { 'X-Verified-User': 'user_bob', 'X-User-Id': 'user_bob' });
    expect(ok.status).toBe(101);
    const c = ok.client;
    await c.waitFor((m) => m.length === 1);
    c.ws.send(JSON.stringify({ text: 'who am i' }));
    await c.waitFor((m) => m.length === 2);
    expect(c.messages[1].userId).toBe('user_alice');
    c.ws.close();
  });

  it('persists, orders and broadcasts messages, validating input', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await addBob(a, team);
    const ca = (await connect(a, team, 'r1')).client;
    const cb = (await connect(b, team, 'r1')).client;
    await ca.waitFor((m) => m.length === 1);
    await cb.waitFor((m) => m.length === 1);
    expect(ca.messages[0]).toEqual({ type: 'snapshot', messages: [] });

    // invalid inputs never reach history
    ca.ws.send('not json');
    ca.ws.send(JSON.stringify({ text: '   ' }));
    ca.ws.send(JSON.stringify({ text: 'x'.repeat(1001) }));
    ca.ws.send(JSON.stringify({ text: 5 }));
    ca.ws.send(new Uint8Array([1, 2, 3]));
    await ca.waitFor(() => ca.count('error').length === 5);

    // concurrent distinct messages each appear exactly once everywhere
    for (let i = 0; i < 20; i++) {
      ca.ws.send(JSON.stringify({ text: `a${i}` }));
      cb.ws.send(JSON.stringify({ text: `b${i}` }));
    }
    await ca.waitFor(() => ca.count('message').length === 40);
    await cb.waitFor(() => cb.count('message').length === 40);
    for (const c of [ca, cb]) {
      const msgs = c.count('message');
      const seqs = msgs.map((m) => m.seq);
      expect(new Set(msgs.map((m) => m.text)).size).toBe(40);
      expect(seqs).toEqual([...seqs].sort((x, y) => x - y));
      expect(new Set(seqs).size).toBe(40);
      expect(seqs[0]).toBeGreaterThan(0);
    }
    expect(cb.count('message').filter((m) => m.text.startsWith('a')).every((m) => m.userId === 'user_alice')).toBe(true);

    // a fresh connection gets the history ascending (here all 40, under the 50 cap)
    const cc = (await connect(a, team, 'r1')).client;
    await cc.waitFor((m) => m.length === 1);
    expect(cc.messages[0].messages).toHaveLength(40);
    expect(cc.messages[0].messages[39].seq).toBe(ca.count('message')[39].seq);

    // rooms are independent
    const other = (await connect(a, team, 'r2')).client;
    await other.waitFor((m) => m.length === 1);
    expect(other.messages[0].messages).toEqual([]);
    for (const c of [ca, cb, cc, other]) c.ws.close();
  });

  it('accepts sustained traffic at 100ms intervals', async () => {
    const a = await login('alice@example.test');
    const team = await newTeam(a);
    const c = (await connect(a, team)).client;
    await c.waitFor((m) => m.length === 1);
    for (let i = 0; i < 60; i++) {
      c.ws.send(JSON.stringify({ text: `m${i}` }));
      await new Promise((r) => setTimeout(r, 100));
    }
    await c.waitFor(() => c.count('message').length === 60);
    c.ws.close();
  }, 20000);

  it('refuses new handshakes after logout or removal', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await addBob(a, team);
    const first = await connect(b, team);
    expect(first.status).toBe(101);
    first.client.ws.close();
    await call(a, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' });
    expect((await connect(b, team)).status).toBe(403);
    await call(a, '/api/logout', { method: 'POST' });
    expect((await connect(a, team)).status).toBe(401);
  });
});
