import { Hono, type MiddlewareHandler } from 'hono';
import type { AppEnv, C, Vars } from './types';

export interface TeamDeps {
  requireAuth: (c: C, next: () => Promise<void>) => Promise<unknown>;
  readJson: (c: C) => Promise<Record<string, unknown> | null>;
  readBounded: (req: Request, limit: number) => Promise<Uint8Array | null>;
  knownUsers: string[];
  maxUpload: number;
}

const ROOM_RE = /^[A-Za-z0-9_-]{1,40}$/;
// Only these headers are forwarded to the room; everything else from the client is dropped.
const UPGRADE_HEADERS = ['upgrade', 'connection', 'sec-websocket-key', 'sec-websocket-version'];

async function roleOf(env: AppEnv, teamId: string, userId: string) {
  const row = await env.DB.prepare('SELECT role FROM team_members WHERE team_id = ? AND user_id = ?')
    .bind(teamId, userId)
    .first<{ role: 'owner' | 'member' }>();
  return row?.role ?? null;
}

export function teamRoutes(deps: TeamDeps) {
  const t = new Hono<{ Bindings: AppEnv; Variables: Vars }>();
  const now = () => Math.floor(Date.now() / 1000);

  // Authenticate first (401), then require same-origin for every mutation (403).
  const auth: MiddlewareHandler<{ Bindings: AppEnv; Variables: Vars }> = (c, next) =>
    deps.requireAuth(c, next) as Promise<Response | void>;
  t.use('*', auth);
  t.use('*', async (c, next) => {
    if (!['GET', 'HEAD', 'OPTIONS'].includes(c.req.method)) {
      const origin = c.req.header('Origin');
      if (!origin || origin !== new URL(c.req.url).origin) return c.json({ error: 'bad origin' }, 403);
    }
    await next();
    if (c.res.status !== 101) c.header('Cache-Control', 'private, no-store');
  });

  t.post('/', async (c) => {
    const body = await deps.readJson(c);
    const name = typeof body?.name === 'string' ? body.name.trim() : '';
    if (name.length < 1 || name.length > 80) return c.json({ error: 'invalid name' }, 400);
    const id = crypto.randomUUID();
    const userId = c.get('userId');
    await c.env.DB.batch([
      c.env.DB.prepare('INSERT INTO teams (id, name, owner_id, created_at) VALUES (?, ?, ?, ?)').bind(id, name, userId, now()),
      c.env.DB.prepare("INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'owner', ?)").bind(id, userId, now()),
    ]);
    return c.json({ id, name }, 201);
  });

  t.get('/', async (c) => {
    const { results } = await c.env.DB.prepare(
      'SELECT t.id, t.name, m.role FROM team_members m JOIN teams t ON t.id = m.team_id WHERE m.user_id = ? ORDER BY t.created_at, t.rowid',
    )
      .bind(c.get('userId'))
      .all<{ id: string; name: string; role: string }>();
    return c.json({ teams: results });
  });

  // ---- membership (owner only; always reads current D1 state) ----

  t.put('/:team/members/:userId', async (c) => {
    if ((await roleOf(c.env, c.req.param('team'), c.get('userId'))) !== 'owner') return c.json({ error: 'forbidden' }, 403);
    const target = c.req.param('userId');
    if (!deps.knownUsers.includes(target)) return c.json({ error: 'unknown user' }, 400);
    const body = await deps.readJson(c);
    if (!body || body.role !== 'member') return c.json({ error: 'invalid role' }, 400);
    if ((await roleOf(c.env, c.req.param('team'), target)) === 'owner') return c.json({ error: 'owner cannot be changed' }, 409);
    await c.env.DB.prepare(
      "INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'member', ?) ON CONFLICT(team_id, user_id) DO UPDATE SET role = 'member' WHERE role != 'owner'",
    )
      .bind(c.req.param('team'), target, now())
      .run();
    return c.body(null, 204);
  });

  t.delete('/:team/members/:userId', async (c) => {
    if ((await roleOf(c.env, c.req.param('team'), c.get('userId'))) !== 'owner') return c.json({ error: 'forbidden' }, 403);
    const target = c.req.param('userId');
    if (!deps.knownUsers.includes(target)) return c.json({ error: 'unknown user' }, 400);
    if ((await roleOf(c.env, c.req.param('team'), target)) === 'owner') return c.json({ error: 'owner cannot be removed' }, 409);
    await c.env.DB.prepare("DELETE FROM team_members WHERE team_id = ? AND user_id = ? AND role != 'owner'")
      .bind(c.req.param('team'), target)
      .run();
    return c.body(null, 204);
  });

  // ---- team uploads ----

  t.post('/:team/uploads', async (c) => {
    const teamId = c.req.param('team');
    const userId = c.get('userId');
    if (!(await roleOf(c.env, teamId, userId))) return c.json({ error: 'forbidden' }, 403);
    const data = await deps.readBounded(c.req.raw, deps.maxUpload);
    if (!data) return c.json({ error: 'too large' }, 413);
    const id = crypto.randomUUID();
    const key = `teams/${teamId}/uploads/${id}`;
    await c.env.UPLOADS.put(key, data, { httpMetadata: { contentType: 'application/octet-stream' } });
    await c.env.DB.prepare('INSERT INTO team_uploads (id, team_id, object_key, size, content_type, created_by, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)')
      .bind(id, teamId, key, data.byteLength, 'application/octet-stream', userId, now())
      .run();
    return c.json({ id }, 201);
  });

  // Looks the file up by (team, id); the R2 key is rebuilt from the verified team and stored ID.
  const findTeamUpload = async (c: C) => {
    const teamId = c.req.param('team');
    if (!teamId || !(await roleOf(c.env, teamId, c.get('userId')))) return 'forbidden' as const;
    const id = c.req.param('id');
    const row = await c.env.DB.prepare('SELECT id FROM team_uploads WHERE id = ? AND team_id = ?').bind(id, teamId).first<{ id: string }>();
    return row ? { teamId, id: row.id, key: `teams/${teamId}/uploads/${row.id}` } : null;
  };

  t.get('/:team/uploads/:id', async (c) => {
    const found = await findTeamUpload(c);
    if (found === 'forbidden') return c.json({ error: 'forbidden' }, 403);
    const obj = found ? await c.env.UPLOADS.get(found.key) : null;
    if (!obj) return c.json({ error: 'not found' }, 404);
    return new Response(obj.body, {
      headers: {
        'Content-Type': 'application/octet-stream',
        'Content-Length': String(obj.size),
        'Content-Disposition': 'attachment; filename="download.bin"',
        'X-Content-Type-Options': 'nosniff',
        'Cache-Control': 'private, no-store',
      },
    });
  });

  t.delete('/:team/uploads/:id', async (c) => {
    const found = await findTeamUpload(c);
    if (found === 'forbidden') return c.json({ error: 'forbidden' }, 403);
    if (!found) return c.json({ error: 'not found' }, 404);
    await c.env.UPLOADS.delete(found.key);
    await c.env.DB.prepare('DELETE FROM team_uploads WHERE id = ? AND team_id = ?').bind(found.id, found.teamId).run();
    return c.body(null, 204);
  });

  // ---- rooms ----

  t.get('/:team/rooms/:room/ws', async (c) => {
    const teamId = c.req.param('team');
    const room = c.req.param('room');
    if (!ROOM_RE.test(room)) return c.json({ error: 'invalid room' }, 400);
    if (c.req.url.includes('?')) return c.json({ error: 'query not allowed' }, 400);
    const origin = c.req.header('Origin');
    if (!origin || origin !== new URL(c.req.url).origin) return c.json({ error: 'bad origin' }, 403);
    if (!(await roleOf(c.env, teamId, c.get('userId')))) return c.json({ error: 'forbidden' }, 403);
    if (c.req.header('Upgrade')?.toLowerCase() !== 'websocket') return c.json({ error: 'expected websocket' }, 426);

    // Build the forwarded request from scratch: client identity headers can never reach the room.
    const headers = new Headers();
    for (const name of UPGRADE_HEADERS) {
      const v = c.req.header(name);
      if (v) headers.set(name, v);
    }
    headers.set('X-Verified-User', c.get('userId'));
    headers.set('X-Verified-Session', c.get('sessionId'));
    headers.set('X-Verified-Team', teamId);
    headers.set('X-Verified-Session-Expires', String(c.get('sessionExpires') * 1000));
    const stub = c.env.ROOMS.get(c.env.ROOMS.idFromName(`${teamId}:${room}`));
    return stub.fetch(new Request('https://room.internal/connect', { headers }));
  });

  return t;
}
