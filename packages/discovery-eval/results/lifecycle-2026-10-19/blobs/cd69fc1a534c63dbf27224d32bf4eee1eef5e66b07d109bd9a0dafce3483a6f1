import { DurableObject } from 'cloudflare:workers';

const MAX_FRAME_BYTES = 4096;
const MAX_TEXT_CHARS = 1000;
const SNAPSHOT_SIZE = 50;
const KEEP_MESSAGES = 500;
const AUTH_CHUNK = 80;
const CLIENT_ID_RE = /^[A-Za-z0-9_-]{1,80}$/;
const enc = new TextEncoder();

interface Attachment {
  userId: string;
  teamId: string;
  sessionId: string;
  connId: string;
}

interface MessageRow extends Record<string, SqlStorageValue> {
  seq: number;
  user_id: string;
  text: string;
  client_id: string | null;
}

type Role = 'owner' | 'member' | 'viewer';

/**
 * One SQLite-backed Durable Object per team/room. Only the Worker's membership-checked
 * route reaches it (via the namespace binding); identity arrives in headers the Worker
 * builds from scratch after verifying the session and membership.
 *
 * Open sockets are re-authorized against D1 (session + membership) on every send, for the
 * sender before committing and for each recipient before delivery; the attachment holds
 * identity only, never authority.
 */
export class Room extends DurableObject<Env> {
  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    ctx.blockConcurrencyWhile(async () => {
      // AUTOINCREMENT keeps seq monotonic even after old rows are pruned.
      ctx.storage.sql.exec('CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, text TEXT NOT NULL)');
      // Deduplication records outlive history pruning; additive, so pre-existing rooms keep their rows.
      ctx.storage.sql.exec(
        'CREATE TABLE IF NOT EXISTS client_ids (user_id TEXT NOT NULL, client_id TEXT NOT NULL, text TEXT NOT NULL, seq INTEGER NOT NULL, PRIMARY KEY (user_id, client_id))',
      );
      ctx.storage.sql.exec('CREATE INDEX IF NOT EXISTS client_ids_seq ON client_ids (seq)');
    });
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  async fetch(request: Request): Promise<Response> {
    const userId = request.headers.get('X-Verified-User');
    const teamId = request.headers.get('X-Verified-Team');
    const sessionId = request.headers.get('X-Verified-Session');
    if (!userId || !teamId || !sessionId) return new Response('forbidden', { status: 403 });
    if (request.headers.get('Upgrade')?.toLowerCase() !== 'websocket') return new Response('upgrade required', { status: 426 });

    const pair = new WebSocketPair();
    const [client, server] = Object.values(pair);
    this.ctx.acceptWebSocket(server);
    server.serializeAttachment({ userId, teamId, sessionId, connId: crypto.randomUUID() } satisfies Attachment);

    const rows = this.ctx.storage.sql
      .exec<MessageRow>(
        'SELECT m.seq, m.user_id, m.text, c.client_id FROM (SELECT seq, user_id, text FROM messages ORDER BY seq DESC LIMIT ?) m LEFT JOIN client_ids c ON c.seq = m.seq ORDER BY m.seq ASC',
        SNAPSHOT_SIZE,
      )
      .toArray();
    server.send(
      JSON.stringify({
        type: 'snapshot',
        messages: rows.map((r) => ({ seq: r.seq, userId: r.user_id, text: r.text, ...(r.client_id ? { clientId: r.client_id } : {}) })),
      }),
    );
    return new Response(null, { status: 101, webSocket: client });
  }

  private attachment(ws: WebSocket): Attachment | null {
    const a = ws.deserializeAttachment() as Partial<Attachment> | null;
    // Sockets from before per-send authorization carry no session; they must reconnect.
    return a && a.userId && a.teamId && a.sessionId && a.connId ? (a as Attachment) : null;
  }

  private reject(ws: WebSocket, code: string, message: string, extra: Record<string, unknown> = {}) {
    try {
      ws.send(JSON.stringify({ type: 'error', code, error: message, ...extra }));
    } catch {
      // socket already gone
    }
  }

  private closeQuietly(ws: WebSocket, code: number, reason: string) {
    try {
      ws.close(code, reason);
    } catch {
      // already closed
    }
  }

  /** Current role per session id, straight from D1 (no cache). Sessions without authority are absent. */
  private async roles(atts: Attachment[]): Promise<Map<string, Role>> {
    const out = new Map<string, Role>();
    const bySession = new Map<string, Attachment>();
    for (const a of atts) bySession.set(a.sessionId, a);
    const ids = [...bySession.keys()];
    const now = Math.floor(Date.now() / 1000);
    for (let i = 0; i < ids.length; i += AUTH_CHUNK) {
      const chunk = ids.slice(i, i + AUTH_CHUNK);
      const teamId = bySession.get(chunk[0])!.teamId;
      const { results } = await this.env.DB.prepare(
        `SELECT s.id AS sid, s.user_id AS uid, m.role AS role FROM sessions s JOIN team_members m ON m.user_id = s.user_id AND m.team_id = ? WHERE s.revoked_at IS NULL AND s.expires_at > ? AND s.id IN (${chunk.map(() => '?').join(',')})`,
      )
        .bind(teamId, now, ...chunk)
        .all<{ sid: string; uid: string; role: Role }>();
      for (const r of results) {
        const a = bySession.get(r.sid);
        if (a && a.userId === r.uid && a.teamId === teamId) out.set(r.sid, r.role);
      }
    }
    return out;
  }

  async webSocketMessage(ws: WebSocket, data: string | ArrayBuffer) {
    const att = this.attachment(ws);
    if (!att) {
      this.closeQuietly(ws, 1008, 'reconnect required');
      return;
    }
    if (typeof data !== 'string') return this.reject(ws, 'invalid', 'text frames only');
    if (enc.encode(data).byteLength > MAX_FRAME_BYTES) {
      this.closeQuietly(ws, 1009, 'message too big');
      return;
    }
    let parsed: unknown;
    try {
      parsed = JSON.parse(data);
    } catch {
      return this.reject(ws, 'invalid', 'invalid json');
    }
    const body = parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? (parsed as { text?: unknown; clientId?: unknown }) : {};
    const text = body.text;
    if (typeof text !== 'string' || text.trim().length === 0 || Array.from(text).length > MAX_TEXT_CHARS) {
      return this.reject(ws, 'invalid', 'invalid text');
    }
    const clientId = body.clientId;
    if (clientId !== undefined && (typeof clientId !== 'string' || !CLIENT_ID_RE.test(clientId))) {
      return this.reject(ws, 'invalid', 'invalid clientId');
    }

    // Authorize sender and every recipient against current D1 state before anything is committed.
    const peers = this.ctx.getWebSockets();
    const peerAtts = new Map<string, Attachment>();
    for (const p of peers) {
      const a = this.attachment(p);
      if (a) peerAtts.set(a.connId, a);
    }
    let roles: Map<string, Role>;
    try {
      roles = await this.roles([att, ...peerAtts.values()]);
    } catch {
      return this.reject(ws, 'unavailable', 'authorization unavailable', clientId ? { clientId } : {});
    }
    const senderRole = roles.get(att.sessionId);
    if (!senderRole) {
      this.reject(ws, 'unauthorized', 'not authorized');
      this.closeQuietly(ws, 1008, 'not authorized');
      return;
    }
    if (senderRole === 'viewer') {
      return this.reject(ws, 'forbidden', 'read-only', clientId ? { clientId } : {});
    }

    // From here on everything is synchronous: dedupe lookup, commit and fanout cannot interleave.
    const sql = this.ctx.storage.sql;
    if (clientId !== undefined) {
      const prior = sql.exec<{ seq: number; text: string }>('SELECT seq, text FROM client_ids WHERE user_id = ? AND client_id = ?', att.userId, clientId).toArray()[0];
      if (prior) {
        if (prior.text === text) ws.send(JSON.stringify({ type: 'ack', seq: prior.seq, clientId }));
        else this.reject(ws, 'conflict', 'clientId reused with different text', { clientId });
        return;
      }
    }
    let seq = 0;
    this.ctx.storage.transactionSync(() => {
      seq = sql.exec<{ seq: number }>('INSERT INTO messages (user_id, text) VALUES (?, ?) RETURNING seq', att.userId, text).one().seq;
      if (clientId !== undefined) sql.exec('INSERT INTO client_ids (user_id, client_id, text, seq) VALUES (?, ?, ?, ?)', att.userId, clientId, text, seq);
      sql.exec('DELETE FROM messages WHERE seq <= ?', seq - KEEP_MESSAGES);
    });

    const out = JSON.stringify({ type: 'message', seq, userId: att.userId, text, ...(clientId !== undefined ? { clientId } : {}) });
    for (const peer of peers) {
      const a = this.attachment(peer);
      if (!a) {
        this.closeQuietly(peer, 1008, 'reconnect required');
        continue;
      }
      // Sockets that connected while authorization was in flight were verified by their handshake.
      const known = peerAtts.has(a.connId);
      if (known && !roles.has(a.sessionId)) {
        this.closeQuietly(peer, 1008, 'not authorized');
        continue;
      }
      try {
        peer.send(out);
      } catch {
        // peer already gone; nothing to do
      }
    }
  }

  webSocketClose(ws: WebSocket, code: number) {
    // 1005/1006 are reserved and cannot be echoed back.
    try {
      ws.close(code >= 1000 && code < 1005 ? code : 1000);
    } catch {
      // already closed
    }
  }

  webSocketError(ws: WebSocket) {
    try {
      ws.close(1011, 'error');
    } catch {
      // already closed
    }
  }
}
