import { DurableObject } from 'cloudflare:workers';
import type { AppEnv } from './types';

const MAX_TEXT_CHARS = 1000;
const MAX_FRAME_BYTES = 4096;
const SNAPSHOT_SIZE = 50;
const RETAIN = 1000;
const CLIENT_ID_RE = /^[A-Za-z0-9_-]{1,80}$/;
const enc = new TextEncoder();

// Serializable per-connection state kept via serializeAttachment so it survives hibernation.
// leaseExpires is only written by the previous release; it is ignored now that every send re-checks D1.
interface Attachment {
  userId: string;
  sessionId: string;
  teamId: string;
  sessionExpires: number;
  grantId?: string | null;
  leaseExpires?: number;
}

type Role = 'owner' | 'member' | 'viewer';

/**
 * One instance per team/room. Only reachable through the Worker binding, which has already
 * verified session, Origin and membership and replaced all identity headers.
 */
export class TeamRoom extends DurableObject<AppEnv> {
  // Not authoritative: it only orders message handling, which is re-derived from SQLite on every wake-up.
  private queue: Promise<void> = Promise.resolve();

  constructor(ctx: DurableObjectState, env: AppEnv) {
    super(ctx, env);
    const sql = ctx.storage.sql;
    // AUTOINCREMENT keeps seq strictly increasing even after old rows are pruned.
    sql.exec(
      'CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, text TEXT NOT NULL, created_at INTEGER NOT NULL)',
    );
    // Rooms created before retry support lack client_id; add it in place so old history stays readable.
    if (!sql.exec('PRAGMA table_info(messages)').toArray().some((col) => col.name === 'client_id')) {
      sql.exec('ALTER TABLE messages ADD COLUMN client_id TEXT');
    }
    // Deduplication records outlive the latest-N message window.
    sql.exec(
      'CREATE TABLE IF NOT EXISTS client_ids (user_id TEXT NOT NULL, client_id TEXT NOT NULL, seq INTEGER NOT NULL, text TEXT NOT NULL, PRIMARY KEY (user_id, client_id))',
    );
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  async fetch(request: Request): Promise<Response> {
    if (request.headers.get('Upgrade')?.toLowerCase() !== 'websocket') return new Response('expected websocket', { status: 426 });
    const userId = request.headers.get('X-Verified-User');
    const sessionId = request.headers.get('X-Verified-Session');
    const teamId = request.headers.get('X-Verified-Team');
    const sessionExpires = Number(request.headers.get('X-Verified-Session-Expires'));
    if (!userId || !sessionId || !teamId || !Number.isFinite(sessionExpires)) return new Response('missing identity', { status: 400 });

    const attachment: Attachment = { userId, sessionId, teamId, sessionExpires, grantId: request.headers.get('X-Verified-Grant') };
    const [client, server] = Object.values(new WebSocketPair());
    this.ctx.acceptWebSocket(server);
    server.serializeAttachment(attachment);
    server.send(JSON.stringify({ type: 'snapshot', messages: this.history() }));
    return new Response(null, { status: 101, webSocket: client });
  }

  private history() {
    const rows = this.ctx.storage.sql
      .exec('SELECT seq, user_id, text, client_id FROM messages ORDER BY seq DESC LIMIT ?', SNAPSHOT_SIZE)
      .toArray();
    return rows.reverse().map((r) => ({
      seq: r.seq as number,
      userId: r.user_id as string,
      text: r.text as string,
      ...(r.client_id ? { clientId: r.client_id as string } : {}),
    }));
  }

  private reject(ws: WebSocket, code: string, error: string, extra: Record<string, unknown> = {}) {
    try {
      ws.send(JSON.stringify({ type: 'error', code, error, ...extra }));
    } catch {
      // socket already closing
    }
  }

  // Current authority from D1: the session must be live and the membership must be the same grant
  // the socket was opened with. Returns the member's present role, or null when access is gone.
  private async authorize(att: Attachment | null): Promise<Role | null> {
    if (!att) return null;
    const nowMs = Date.now();
    if (att.sessionExpires <= nowMs) return null;
    const row = await this.env.DB.prepare(
      'SELECT m.role AS role FROM sessions s JOIN team_members m ON m.user_id = s.user_id WHERE s.id = ? AND s.user_id = ? AND s.revoked_at IS NULL AND s.expires_at > ? AND m.team_id = ? AND m.user_id = ? AND (? IS NULL OR m.grant_id = ?)',
    )
      .bind(att.sessionId, att.userId, Math.floor(nowMs / 1000), att.teamId, att.userId, att.grantId ?? null, att.grantId ?? null)
      .first<{ role: Role }>();
    return row?.role ?? null;
  }

  private revoke(ws: WebSocket) {
    try {
      ws.close(1008, 'authorization revoked');
    } catch {
      // already closed
    }
  }

  async webSocketMessage(ws: WebSocket, message: string | ArrayBuffer): Promise<void> {
    if (typeof message !== 'string') return this.reject(ws, 'invalid', 'text frames only');
    if (message.length > MAX_FRAME_BYTES || enc.encode(message).byteLength > MAX_FRAME_BYTES) return this.reject(ws, 'too_large', 'message too large');
    let parsed: unknown;
    try {
      parsed = JSON.parse(message);
    } catch {
      return this.reject(ws, 'invalid', 'invalid json');
    }
    const obj = parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? (parsed as { text?: unknown; clientId?: unknown }) : {};
    const text = obj.text;
    if (typeof text !== 'string') return this.reject(ws, 'invalid', 'text required');
    if (text.trim().length === 0) return this.reject(ws, 'invalid', 'text is blank');
    if ([...text].length > MAX_TEXT_CHARS) return this.reject(ws, 'invalid', 'text too long');
    const clientId = obj.clientId;
    if (clientId !== undefined && (typeof clientId !== 'string' || !CLIENT_ID_RE.test(clientId))) {
      return this.reject(ws, 'invalid', 'invalid clientId');
    }

    // Sends are handled one at a time: authorization awaits D1, and without this chain two sends could
    // interleave and reach peers out of seq order or race the deduplication lookup.
    const run = this.queue.then(() => this.handleSend(ws, text, clientId));
    this.queue = run.catch(() => {});
    await run;
  }

  private async handleSend(ws: WebSocket, text: string, clientId: string | undefined) {
    // Sender first: nothing below (dedup lookup, conflict, ack, commit) happens without current authority.
    const role = await this.authorize(ws.deserializeAttachment() as Attachment | null);
    if (!role) return this.revoke(ws);
    if (role === 'viewer') return this.reject(ws, 'forbidden', 'read-only membership', clientId ? { clientId } : {});
    const att = ws.deserializeAttachment() as Attachment;

    const sql = this.ctx.storage.sql;
    if (clientId) {
      const prior = sql.exec('SELECT seq, text FROM client_ids WHERE user_id = ? AND client_id = ?', att.userId, clientId).toArray()[0];
      if (prior) {
        if (prior.text === text) {
          try {
            ws.send(JSON.stringify({ type: 'ack', seq: prior.seq, clientId }));
          } catch {
            // socket closing
          }
        } else {
          this.reject(ws, 'conflict', 'clientId already used with different text', { clientId });
        }
        return;
      }
    }

    // Persist before broadcasting; message row, dedup record and pruning commit together.
    const seq = this.ctx.storage.transactionSync(() => {
      const s = sql
        .exec('INSERT INTO messages (user_id, text, created_at, client_id) VALUES (?, ?, ?, ?) RETURNING seq', att.userId, text, Date.now(), clientId ?? null)
        .one().seq as number;
      if (clientId) sql.exec('INSERT INTO client_ids (user_id, client_id, seq, text) VALUES (?, ?, ?, ?)', att.userId, clientId, s, text);
      sql.exec('DELETE FROM messages WHERE seq <= ?', s - RETAIN);
      return s;
    });
    const payload = JSON.stringify({ type: 'message', seq, userId: att.userId, text, ...(clientId ? { clientId } : {}) });

    // Every recipient is re-authorized for this send; revoked connections get nothing and are closed.
    await Promise.all(
      this.ctx.getWebSockets().map(async (peer) => {
        const recipient = await this.authorize(peer.deserializeAttachment() as Attachment | null);
        if (!recipient) return this.revoke(peer);
        try {
          peer.send(payload);
        } catch {
          // peer is closing
        }
      }),
    );
  }

  async webSocketClose(ws: WebSocket, code: number): Promise<void> {
    const reserved = code === 1005 || code === 1006 || code === 1015 || code < 1000 || code >= 5000;
    try {
      ws.close(reserved ? 1000 : code, 'closing');
    } catch {
      // already closed
    }
  }

  async webSocketError(ws: WebSocket): Promise<void> {
    try {
      ws.close(1011, 'error');
    } catch {
      // already closed
    }
  }
}
