<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Review rooms</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 0 auto; padding: 1rem; line-height: 1.4; }
  section { border: 1px solid #ccc; border-radius: 8px; padding: 1rem; margin: 1rem 0; }
  label { display: block; margin: .5rem 0; }
  input:not([type=checkbox]), select, textarea { display: block; width: 100%; box-sizing: border-box; padding: .4rem; font: inherit; }
  button { padding: .5rem 1rem; font: inherit; margin-top: .5rem; }
  #room-messages { list-style: none; padding: 0; max-height: 16rem; overflow-y: auto; border: 1px solid #eee; min-height: 3rem; margin: .5rem 0; }
  #room-messages li { padding: .2rem .4rem; border-bottom: 1px solid #f0f0f0; white-space: pre-wrap; overflow-wrap: anywhere; }
  [hidden] { display: none !important; }
</style>
</head>
<body>
<h1>Review rooms</h1>
<p><a href="/">Home</a></p>
<p id="auth-note" role="alert" hidden>You are not signed in. <a href="/">Sign in on the home page</a>, then reload.</p>
<p id="page-error" role="alert"></p>

<section>
  <h2>Teams</h2>
  <label>New team name <input data-testid="team-name" maxlength="80" autocomplete="off"></label>
  <button data-testid="team-create" type="button" disabled>Create team</button>
  <label>Team <select data-testid="team-select" disabled></select></label>
</section>

<section>
  <h2>Room</h2>
  <label>Room name <input data-testid="room-name" value="general" maxlength="40" autocomplete="off"></label>
  <button data-testid="room-connect" type="button" disabled>Connect</button>
  <p data-testid="room-status" role="status">idle</p>
  <ul data-testid="room-messages" id="room-messages"></ul>
  <label>Message <input data-testid="message-text" autocomplete="off" disabled></label>
  <button data-testid="message-send" type="button" disabled>Send</button>
</section>

<section>
  <h2>Team files</h2>
  <label>File (max 1 MiB) <input data-testid="team-upload" type="file" disabled></label>
  <p id="upload-status" role="status"></p>
  <ul data-testid="file-list" id="file-list"></ul>
</section>

<script>
const $ = (id) => document.querySelector(`[data-testid="${id}"]`);
const ROOM_RE = /^[A-Za-z0-9_-]{1,40}$/;
const MAX_TEXT = 1000;
const MAX_UPLOAD = 1024 * 1024;

let ws = null;
let generation = 0;
let ready = false;      // session loaded
let connected = false;  // snapshot received on the current socket
let busy = false;       // a create or upload request is in flight

const setStatus = (s) => { $('room-status').textContent = s; };
const setError = (s) => { document.getElementById('page-error').textContent = s || ''; };

const roles = new Map(); // team id -> role, as of the last team list load

function refresh() {
  const hasTeam = !!$('team-select').value;
  const readOnly = roles.get($('team-select').value) === 'viewer';
  $('team-name').disabled = !ready;
  $('team-create').disabled = !ready || busy;
  $('team-select').disabled = !ready || $('team-select').options.length === 0;
  $('room-connect').disabled = !ready || !hasTeam;
  $('message-text').disabled = !connected || readOnly;
  $('message-send').disabled = !connected || readOnly;
  $('team-upload').disabled = !ready || !hasTeam || busy || readOnly;
}

async function api(path, opts = {}) {
  return fetch(path, { credentials: 'same-origin', ...opts });
}

function addMessage(m) {
  const list = $('room-messages');
  if (list.querySelector(`li[data-seq="${Number(m.seq)}"]`)) return; // never render the same seq twice
  const li = document.createElement('li');
  li.dataset.seq = String(m.seq);
  li.textContent = `${m.userId}: ${m.text}`;
  list.appendChild(li);
  list.scrollTop = list.scrollHeight;
}

function disconnect(label) {
  generation++;
  if (ws) {
    const old = ws;
    ws = null;
    old.onopen = old.onmessage = old.onerror = old.onclose = null;
    try { old.close(1000, 'bye'); } catch {}
  }
  connected = false;
  if (label) setStatus(label);
  refresh();
}

function connect() {
  const team = $('team-select').value;
  const room = $('room-name').value.trim();
  if (!team) { setStatus('error: choose a team'); return; }
  if (!ROOM_RE.test(room)) { setStatus('error: invalid room name'); return; }
  disconnect();
  const gen = generation;
  setStatus('connecting');
  const scheme = location.protocol === 'https:' ? 'wss' : 'ws';
  const sock = new WebSocket(`${scheme}://${location.host}/api/teams/${encodeURIComponent(team)}/rooms/${encodeURIComponent(room)}/ws`);
  ws = sock;
  sock.onmessage = (ev) => {
    if (gen !== generation) return;
    let m;
    try { m = JSON.parse(ev.data); } catch { return; }
    if (m.type === 'snapshot') {
      const list = $('room-messages');
      list.replaceChildren();
      for (const msg of m.messages) addMessage(msg);
      connected = true;
      setStatus('connected');
      refresh();
    } else if (m.type === 'message') {
      addMessage(m);
    } else if (m.type === 'error') {
      setError(`Room error: ${m.error || m.code || 'unknown'}`);
    }
  };
  sock.onerror = () => { if (gen === generation) setStatus('error: connection failed'); };
  sock.onclose = () => {
    if (gen !== generation) return;
    ws = null;
    connected = false;
    if (!$('room-status').textContent.startsWith('error')) setStatus('closed');
    refresh();
  };
}

async function loadTeams(selectId) {
  const r = await api('/api/teams');
  if (!r.ok) throw new Error('Could not load teams');
  const { teams } = await r.json();
  const sel = $('team-select');
  const previous = selectId || sel.value;
  sel.replaceChildren();
  roles.clear();
  for (const t of teams) {
    roles.set(t.id, t.role);
    const o = document.createElement('option');
    o.value = t.id;
    o.textContent = `${t.name} (${t.role})`;
    sel.appendChild(o);
  }
  if (previous && teams.some((t) => t.id === previous)) sel.value = previous;
  refresh();
}

async function boot() {
  try {
    const s = await api('/api/session');
    if (!s.ok) { document.getElementById('auth-note').hidden = false; return; }
    await loadTeams();
    ready = true;
  } catch (e) {
    setError(e.message || 'Failed to load');
  }
  refresh();
}

$('team-create').addEventListener('click', async () => {
  const name = $('team-name').value.trim();
  if (!name || name.length > 80) { setError('Team name must be 1-80 characters'); return; }
  busy = true; setError(''); refresh();
  try {
    const r = await api('/api/teams', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
    if (!r.ok) { setError('Could not create team'); return; }
    const team = await r.json();
    $('team-name').value = '';
    await loadTeams(team.id);
    disconnect('idle');
    document.getElementById('file-list').replaceChildren();
  } catch {
    setError('Could not create team');
  } finally {
    busy = false; refresh();
  }
});

$('team-select').addEventListener('change', () => {
  disconnect('idle');
  $('room-messages').replaceChildren();
  document.getElementById('file-list').replaceChildren();
  refresh();
});

$('room-connect').addEventListener('click', connect);

function send() {
  const text = $('message-text').value;
  if (!connected || !ws || roles.get($('team-select').value) === 'viewer') return;
  if (!text.trim()) return;
  if ([...text].length > MAX_TEXT) { setError('Message must be at most 1000 characters'); return; }
  setError('');
  // The id lets the server dedupe; a failed or lost send is never resent automatically.
  ws.send(JSON.stringify({ text, clientId: crypto.randomUUID() }));
  $('message-text').value = '';
}
$('message-send').addEventListener('click', send);
$('message-text').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); send(); } });

$('team-upload').addEventListener('change', async (e) => {
  const input = e.target;
  const file = input.files[0];
  const team = $('team-select').value;
  const status = document.getElementById('upload-status');
  if (!file || !team) return;
  if (file.size > MAX_UPLOAD) { status.textContent = 'File too large (max 1 MiB)'; input.value = ''; return; }
  busy = true; status.textContent = 'Uploading'; refresh();
  try {
    const r = await api(`/api/teams/${encodeURIComponent(team)}/uploads`, { method: 'POST', headers: { 'Content-Type': 'application/octet-stream' }, body: file });
    if (!r.ok) { status.textContent = r.status === 413 ? 'File too large (max 1 MiB)' : 'Upload failed'; return; }
    const { id } = await r.json();
    const a = document.createElement('a');
    a.href = `/api/teams/${encodeURIComponent(team)}/uploads/${encodeURIComponent(id)}`;
    a.download = file.name;
    a.textContent = file.name;
    const li = document.createElement('li');
    li.appendChild(a);
    document.getElementById('file-list').appendChild(li);
    status.textContent = 'Uploaded';
  } catch {
    status.textContent = 'Upload failed';
  } finally {
    input.value = '';
    busy = false; refresh();
  }
});

boot();
</script>
</body>
</html>
