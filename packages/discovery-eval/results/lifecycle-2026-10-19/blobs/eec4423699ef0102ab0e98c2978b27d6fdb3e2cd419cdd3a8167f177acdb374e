import { describe, expect, it } from 'vitest';
import { SELF } from 'cloudflare:test';

const BASE = 'http://localhost';
const json = (path: string, method: string, body: unknown, cookie?: string) =>
  SELF.fetch(BASE + path, {
    method,
    headers: { Origin: BASE, 'Content-Type': 'application/json', ...(cookie ? { Cookie: cookie } : {}) },
    body: JSON.stringify(body),
  });
const req = (cookie: string | null, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, { ...init, headers: { Origin: BASE, ...(cookie ? { Cookie: cookie } : {}), ...(init.headers as object) } });

async function login(email: string) {
  const r = await json('/api/login', 'POST', { email, password: 'local-demo-password' });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

async function newTeam(cookie: string, name = 'Reviewers') {
  const r = await json('/api/teams', 'POST', { name }, cookie);
  expect(r.status).toBe(201);
  return ((await r.json()) as { id: string }).id;
}
const setRole = (cookie: string, team: string, role: string, user = 'user_bob') => json(`/api/teams/${team}/members/${user}`, 'PUT', { role }, cookie);

async function connect(cookie: string, team: string, room = 'general') {
  const r = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/${room}/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: cookie } });
  expect(r.status).toBe(101);
  const ws = r.webSocket!;
  const events: any[] = [];
  const waiters: (() => void)[] = [];
  ws.addEventListener('message', (e) => {
    events.push(JSON.parse(e.data as string));
    waiters.splice(0).forEach((w) => w());
  });
  ws.accept();
  const until = async (pred: () => boolean) => {
    const deadline = Date.now() + 60_000;
    while (!pred() && Date.now() < deadline) await new Promise<void>((res) => { waiters.push(res); setTimeout(res, 50); });
    expect(pred()).toBe(true);
  };
  const send = (o: unknown) => {
    try {
      ws.send(JSON.stringify(o));
    } catch {
      /* server already closed this socket */
    }
  };
  await until(() => events.length >= 1);
  expect(events[0].type).toBe('snapshot');
  return { ws, events, until, send, msgs: () => events.filter((e) => e.type === 'message') };
}
const settle = (ms = 300) => new Promise((r) => setTimeout(r, ms));

describe('viewer role', () => {
  it('lists the real role, reads but cannot write or manage', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    expect((await json(`/api/teams/${team}/members/user_bob`, 'PUT', { role: 'admin' }, a)).status).toBe(400);
    expect((await setRole(a, team, 'viewer')).status).toBe(204);
    expect(((await (await req(b, '/api/teams')).json()) as any).teams.find((t: any) => t.id === team).role).toBe('viewer');
    expect((await setRole(a, team, 'viewer', 'user_alice')).status).toBe(409);

    const bytes = new Uint8Array([9, 8, 7, 0, 255]);
    const up = await req(a, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes });
    const { id } = (await up.json()) as { id: string };
    const dl = await req(b, `/api/teams/${team}/uploads/${id}`);
    expect(dl.status).toBe(200);
    expect(new Uint8Array(await dl.arrayBuffer())).toEqual(bytes);
    expect((await req(b, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes })).status).toBe(403);
    expect((await req(b, `/api/teams/${team}/uploads/${id}`, { method: 'DELETE' })).status).toBe(403);
    expect((await setRole(b, team, 'member', 'user_alice')).status).toBe(403);
    expect((await req(b, `/api/teams/${team}/members/user_alice`, { method: 'DELETE' })).status).toBe(403);
    expect((await req(a, `/api/teams/${team}/uploads/${id}`)).status).toBe(200);

    const alice = await connect(a, team);
    const bob = await connect(b, team);
    alice.send({ text: 'hello' });
    await bob.until(() => bob.msgs().some((m) => m.text === 'hello'));
    bob.send({ text: 'viewers cannot talk' });
    await bob.until(() => bob.events.some((e) => e.type === 'error' && e.code === 'forbidden'));
    await settle();
    expect(alice.msgs().some((m) => m.text === 'viewers cannot talk')).toBe(false);
    expect((await connect(b, team)).events[0].messages.map((m: any) => m.text)).toEqual(['hello']);
    for (const s of [alice, bob]) s.ws.close(1000);
  });

  it('downgrade applies to open sockets: still receives, cannot send', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await setRole(a, team, 'member');
    const alice = await connect(a, team);
    const bob = await connect(b, team);
    bob.send({ text: 'before' });
    await alice.until(() => alice.msgs().some((m) => m.text === 'before'));
    expect((await setRole(a, team, 'viewer')).status).toBe(204);
    bob.send({ text: 'after downgrade', clientId: 'dg1' });
    await bob.until(() => bob.events.some((e) => e.type === 'error' && e.code === 'forbidden'));
    alice.send({ text: 'still listening' });
    await bob.until(() => bob.msgs().some((m) => m.text === 'still listening'));
    expect(alice.msgs().some((m) => m.text === 'after downgrade')).toBe(false);
    // The earlier success grants nothing: no ack replay for a read-only sender.
    bob.send({ text: 'before', clientId: 'dg1' });
    await settle();
    expect(bob.events.some((e) => e.type === 'ack')).toBe(false);
    for (const s of [alice, bob]) s.ws.close(1000);
  });
});

describe('revocation on open sockets', () => {
  it('removed member neither commits nor receives; re-adding needs a new login after logout', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await setRole(a, team, 'member');
    const alice = await connect(a, team);
    const bob = await connect(b, team);
    alice.send({ text: 'one', clientId: 'r1' });
    await bob.until(() => bob.msgs().length === 1);

    expect((await req(a, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' })).status).toBe(204);
    alice.send({ text: 'secret' });
    await alice.until(() => alice.msgs().some((m) => m.text === 'secret'));
    expect(bob.msgs().some((m) => m.text === 'secret')).toBe(false);
    bob.send({ text: 'ghost' });
    await settle();
    expect(alice.msgs().some((m) => m.text === 'ghost')).toBe(false);

    // Re-adding allows a new connection; the old open socket was already closed.
    await setRole(a, team, 'member');
    const again = await connect(b, team);
    expect(again.events[0].messages.map((m: any) => m.text)).toEqual(['one', 'secret']);

    // Logout kills the session even when membership returns.
    expect((await req(b, '/api/logout', { method: 'POST' })).status).toBe(204);
    alice.send({ text: 'after logout' });
    await alice.until(() => alice.msgs().some((m) => m.text === 'after logout'));
    expect(again.msgs().some((m) => m.text === 'after logout')).toBe(false);
    again.send({ text: 'zombie' });
    await settle();
    expect(alice.msgs().some((m) => m.text === 'zombie')).toBe(false);
    expect((await req(b, '/api/teams')).status).toBe(401);
    const stale = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/general/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: b } });
    expect(stale.status).toBe(401);
    const fresh = await login('bob@example.test');
    expect((await connect(fresh, team)).events[0].messages.length).toBe(3);
    alice.ws.close(1000);
  });
});

describe('clientId retries', () => {
  it('acks exact retries, conflicts on changed text, validates ids, scopes per user and room', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await newTeam(a);
    await setRole(a, team, 'member');
    const alice = await connect(a, team);
    const bob = await connect(b, team);

    alice.send({ text: 'hi', clientId: 'c-1' });
    await bob.until(() => bob.msgs().length === 1);
    const orig = bob.msgs()[0];
    expect(orig).toMatchObject({ type: 'message', text: 'hi', clientId: 'c-1', userId: 'user_alice' });

    alice.send({ text: 'hi', clientId: 'c-1' });
    await alice.until(() => alice.events.some((e) => e.type === 'ack'));
    expect(alice.events.find((e) => e.type === 'ack')).toEqual({ type: 'ack', seq: orig.seq, clientId: 'c-1' });
    alice.send({ text: 'different', clientId: 'c-1' });
    await alice.until(() => alice.events.some((e) => e.type === 'error' && e.code === 'conflict'));
    expect(alice.events.find((e) => e.code === 'conflict')).toEqual({ type: 'error', code: 'conflict', clientId: 'c-1' });
    for (const bad of ['', 'has space', 'x'.repeat(81), 5, null]) alice.send({ text: 'bad', clientId: bad });
    await alice.until(() => alice.events.filter((e) => e.type === 'error').length >= 6);

    // Same id from another user and another room is independent.
    bob.send({ text: 'hi', clientId: 'c-1' });
    await alice.until(() => alice.msgs().length === 2);
    const other = await connect(a, team, 'other');
    other.send({ text: 'hi', clientId: 'c-1' });
    await other.until(() => other.msgs().length === 1);
    // Legacy clients without ids still work.
    alice.send({ text: 'plain' });
    await bob.until(() => bob.msgs().some((m) => m.text === 'plain' && m.clientId === undefined));
    await settle();
    expect(bob.msgs().map((m) => m.text)).toEqual(['hi', 'hi', 'plain']);
    expect(bob.events.some((e) => e.type === 'ack')).toBe(false);

    const late = await connect(a, team);
    expect(late.events[0].messages[0]).toEqual({ seq: orig.seq, userId: 'user_alice', text: 'hi', clientId: 'c-1' });
    for (const s of [alice, bob, other, late]) s.ws.close(1000);
  });

  it('simultaneous retries on two sockets commit once', async () => {
    const a = await login('alice@example.test');
    const team = await newTeam(a);
    const s1 = await connect(a, team);
    const s2 = await connect(a, team);
    const s3 = await connect(a, team);
    s1.send({ text: 'race', clientId: 'race-1' });
    s2.send({ text: 'race', clientId: 'race-1' });
    await settle(500);
    const all = [s1, s2, s3];
    const acks = all.flatMap((s) => s.events.filter((e) => e.type === 'ack'));
    expect(acks).toHaveLength(1);
    for (const s of all) expect(s.msgs().filter((m) => m.text === 'race')).toHaveLength(1);
    expect(s3.events.some((e) => e.type === 'ack')).toBe(false);
    expect((await connect(a, team)).events[0].messages).toHaveLength(1);
    for (const s of all) s.ws.close(1000);
  });

  it('keeps deduplication records after pruning from history', { timeout: 120_000 }, async () => {
    const a = await login('alice@example.test');
    const team = await newTeam(a);
    const s = await connect(a, team);
    s.send({ text: 'first', clientId: 'old-1' });
    await s.until(() => s.msgs().length === 1);
    const firstSeq = s.msgs()[0].seq;
    for (let i = 0; i < 1005; i++) s.send({ text: `filler ${i}` });
    await s.until(() => s.msgs().length === 1006);
    const seqs = s.msgs().map((m) => m.seq);
    expect(seqs).toEqual([...seqs].sort((x, y) => x - y));
    s.send({ text: 'first', clientId: 'old-1' });
    await s.until(() => s.events.some((e) => e.type === 'ack'));
    expect(s.events.find((e) => e.type === 'ack').seq).toBe(firstSeq);
    s.send({ text: 'first!', clientId: 'old-1' });
    await s.until(() => s.events.some((e) => e.code === 'conflict'));
    expect(s.msgs()).toHaveLength(1006);
    s.ws.close(1000);
  });
});
