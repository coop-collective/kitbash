-- Allow the read-only 'viewer' role. SQLite cannot alter a CHECK constraint, so the table is
-- rebuilt; every existing membership row is copied unchanged.
CREATE TABLE team_members_v2 (
  team_id TEXT NOT NULL,
  user_id TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('owner', 'member', 'viewer')),
  created_at INTEGER NOT NULL,
  PRIMARY KEY (team_id, user_id)
);
INSERT INTO team_members_v2 (team_id, user_id, role, created_at)
  SELECT team_id, user_id, role, created_at FROM team_members;
DROP TABLE team_members;
ALTER TABLE team_members_v2 RENAME TO team_members;
CREATE INDEX IF NOT EXISTS team_members_user ON team_members (user_id);
CREATE UNIQUE INDEX IF NOT EXISTS team_members_one_owner ON team_members (team_id) WHERE role = 'owner';
