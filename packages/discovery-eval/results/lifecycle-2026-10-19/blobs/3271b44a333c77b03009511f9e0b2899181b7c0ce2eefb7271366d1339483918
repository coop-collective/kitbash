import { describe, expect, it } from 'vitest';
import { SELF } from 'cloudflare:test';

const BASE = 'http://localhost';

async function login(email: string) {
  const r = await SELF.fetch(BASE + '/api/login', {
    method: 'POST',
    headers: { Origin: BASE, 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, password: 'local-demo-password' }),
  });
  expect(r.status).toBe(200);
  return r.headers.get('Set-Cookie')!.split(';')[0];
}

const call = (cookie: string | null, path: string, init: RequestInit = {}) =>
  SELF.fetch(BASE + path, { ...init, headers: { Origin: BASE, ...(cookie ? { Cookie: cookie } : {}), ...(init.headers as object) } });
const json = (method: string, body: unknown): RequestInit => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });

async function createTeam(cookie: string) {
  const r = await call(cookie, '/api/teams', json('POST', { name: 'Roles' }));
  expect(r.status).toBe(201);
  return ((await r.json()) as { id: string }).id;
}
const setRole = (cookie: string, team: string, user: string, role: string) => call(cookie, `/api/teams/${team}/members/${user}`, json('PUT', { role }));

type Sock = ReturnType<typeof listen>;
async function open(cookie: string, team: string, room = 'general'): Promise<Sock> {
  const res = await SELF.fetch(`${BASE}/api/teams/${team}/rooms/${room}/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: cookie } });
  expect(res.status).toBe(101);
  const s = listen(res);
  await until(() => s.events[0]);
  return s;
}
function listen(res: Response) {
  const ws = res.webSocket!;
  ws.accept();
  const events: any[] = [];
  const state = { closed: false };
  ws.addEventListener('message', (e) => {
    events.push(JSON.parse(e.data as string));
  });
  ws.addEventListener('close', () => {
    state.closed = true;
  });
  return { ws, events, state };
}
const of = (s: Sock, type: string) => s.events.filter((e) => e.type === type);
// A revoked socket may already be closed by the server; sending on it is a legitimate no-op for these tests.
const send = (s: Sock, body: unknown) => {
  try {
    s.ws.send(JSON.stringify(body));
  } catch {
    // closed
  }
};
// Lets already-queued work settle so "nothing happened" assertions are meaningful.
const settle = (ms = 300) => new Promise((r) => setTimeout(r, ms));

async function until<T>(fn: () => T | undefined | false, ms = 5000): Promise<T> {
  const end = Date.now() + ms;
  for (;;) {
    const v = fn();
    if (v) return v;
    if (Date.now() > end) throw new Error('timed out waiting for condition');
    await new Promise((r) => setTimeout(r, 10));
  }
}
async function snapshotTexts(cookie: string, team: string, room = 'general') {
  const s = await open(cookie, team, room);
  const msgs = s.events[0].messages as any[];
  s.ws.close(1000, 'done');
  return msgs;
}

describe('viewer role', () => {
  it('reads but cannot write, upload, delete or manage', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);

    expect((await setRole(a, team, 'user_bob', 'admin')).status).toBe(400);
    expect((await setRole(a, team, 'user_alice', 'viewer')).status).toBe(409);
    expect((await setRole(a, team, 'user_bob', 'viewer')).status).toBe(204);
    expect(((await (await call(b, '/api/teams')).json()) as any).teams.find((t: any) => t.id === team).role).toBe('viewer');

    const bytes = new Uint8Array([9, 8, 7, 0, 255]);
    const up = await call(a, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes });
    const { id } = (await up.json()) as { id: string };

    const dl = await call(b, `/api/teams/${team}/uploads/${id}`);
    expect(dl.status).toBe(200);
    expect(new Uint8Array(await dl.arrayBuffer())).toEqual(bytes);
    expect((await call(b, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes })).status).toBe(403);
    expect((await call(b, `/api/teams/${team}/uploads/${id}`, { method: 'DELETE' })).status).toBe(403);
    expect((await setRole(b, team, 'user_bob', 'member')).status).toBe(403);
    expect((await call(b, `/api/teams/${team}/members/user_alice`, { method: 'DELETE' })).status).toBe(403);
    expect((await call(a, `/api/teams/${team}/uploads/${id}`)).status).toBe(200);

    // Upgrading restores write access.
    expect((await setRole(a, team, 'user_bob', 'member')).status).toBe(204);
    expect((await call(b, `/api/teams/${team}/uploads`, { method: 'POST', body: bytes })).status).toBe(201);
  });

  it('receives history and live messages but cannot send over a socket', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    await setRole(a, team, 'user_bob', 'viewer');

    const alice = await open(a, team);
    send(alice, { text: 'before' });
    await until(() => of(alice, 'message').length === 1);

    const bob = await open(b, team);
    expect(bob.events[0].messages.map((m: any) => m.text)).toEqual(['before']);
    send(alice, { text: 'live' });
    await until(() => of(bob, 'message').length === 1);

    send(bob, { text: 'forbidden', clientId: 'v1' });
    const err = await until(() => of(bob, 'error')[0]);
    expect(err.code).toBe('forbidden');
    await settle();
    expect((await snapshotTexts(a, team)).map((m) => m.text)).toEqual(['before', 'live']);
    expect(of(alice, 'message')).toHaveLength(2);
    alice.ws.close(1000, 'done');
    bob.ws.close(1000, 'done');
  });
});

describe('open sockets honor current authority', () => {
  it('stops a removed member from sending or receiving and allows a fresh connection after re-adding', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    await setRole(a, team, 'user_bob', 'member');
    const alice = await open(a, team);
    const bob = await open(b, team);

    send(bob, { text: 'prior', clientId: 'keep-1' });
    await until(() => of(alice, 'message').length === 1);

    expect((await call(a, `/api/teams/${team}/members/user_bob`, { method: 'DELETE' })).status).toBe(204);
    send(bob, { text: 'after removal' });
    send(bob, { text: 'prior', clientId: 'keep-1' }); // a previous success grants no authority for an ack
    send(alice, { text: 'for alice only' });
    await until(() => of(alice, 'message').length === 2);
    await settle();
    expect(of(alice, 'message').map((m) => m.text)).toEqual(['prior', 'for alice only']);
    expect(of(bob, 'message').map((m) => m.text)).toEqual(['prior']);
    expect(of(bob, 'ack')).toHaveLength(0);
    expect(of(bob, 'error')).toHaveLength(0);

    // Re-adding allows a new connection; the old socket's grant stays revoked.
    await setRole(a, team, 'user_bob', 'member');
    const again = await open(b, team);
    expect(again.events[0].messages.map((m: any) => m.text)).toEqual(['prior', 'for alice only']);
    send(bob, { text: 'zombie' });
    send(again, { text: 'fresh' });
    await until(() => of(alice, 'message').length === 3);
    await settle();
    expect((await snapshotTexts(a, team)).map((m) => m.text)).toEqual(['prior', 'for alice only', 'fresh']);
    for (const s of [alice, again]) s.ws.close(1000, 'done');
  });

  it('keeps a downgraded viewer receiving but not sending', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    await setRole(a, team, 'user_bob', 'member');
    const alice = await open(a, team);
    const bob = await open(b, team);

    await setRole(a, team, 'user_bob', 'viewer');
    send(bob, { text: 'nope' });
    await until(() => of(bob, 'error')[0]);
    send(alice, { text: 'still readable' });
    await until(() => of(bob, 'message').length === 1);
    expect(of(bob, 'message')[0].text).toBe('still readable');
    expect((await snapshotTexts(a, team)).map((m) => m.text)).toEqual(['still readable']);
    for (const s of [alice, bob]) s.ws.close(1000, 'done');
  });

  it('cuts off a logged-out session without revoking anyone else', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const b2 = await login('bob@example.test');
    const team = await createTeam(a);
    await setRole(a, team, 'user_bob', 'member');
    const alice = await open(a, team);
    const bob = await open(b, team);
    const bob2 = await open(b2, team);

    expect((await call(b, '/api/logout', { method: 'POST' })).status).toBe(204);
    send(bob, { text: 'ghost' });
    send(alice, { text: 'hello' });
    send(bob2, { text: 'other session' });
    await until(() => of(alice, 'message').length === 2);
    await settle();
    expect(of(bob, 'message')).toHaveLength(0);
    expect(of(bob2, 'message').map((m) => m.text)).toEqual(['hello', 'other session']);
    expect((await call(b, '/api/teams')).status).toBe(401);
    // Re-adding bob must not bring the revoked login back.
    await setRole(a, team, 'user_bob', 'member');
    expect((await SELF.fetch(`${BASE}/api/teams/${team}/rooms/general/ws`, { headers: { Upgrade: 'websocket', Origin: BASE, Cookie: b } })).status).toBe(401);
    for (const s of [alice, bob2]) s.ws.close(1000, 'done');
  });
});

describe('retry-safe messages', () => {
  it('acks exact retries only to the retrier, conflicts on changed text and scopes ids per user and room', async () => {
    const a = await login('alice@example.test');
    const b = await login('bob@example.test');
    const team = await createTeam(a);
    await setRole(a, team, 'user_bob', 'member');
    const alice = await open(a, team);
    const bob = await open(b, team);

    send(alice, { text: 'once', clientId: 'id_1' });
    const first = await until(() => of(bob, 'message')[0]);
    expect(first).toMatchObject({ userId: 'user_alice', text: 'once', clientId: 'id_1' });

    send(alice, { text: 'once', clientId: 'id_1' });
    const ack = await until(() => of(alice, 'ack')[0]);
    expect(ack).toEqual({ type: 'ack', seq: first.seq, clientId: 'id_1' });
    send(alice, { text: 'different', clientId: 'id_1' });
    const conflict = await until(() => of(alice, 'error')[0]);
    expect(conflict).toMatchObject({ type: 'error', code: 'conflict', clientId: 'id_1' });

    // Same id from another user, and from the same user in another room, is independent.
    send(bob, { text: 'bob once', clientId: 'id_1' });
    await until(() => of(alice, 'message').length === 2);
    const other = await open(a, team, 'other');
    send(other, { text: 'other room', clientId: 'id_1' });
    await until(() => of(other, 'message')[0]);
    expect(of(other, 'ack')).toHaveLength(0);

    send(alice, { text: 'bad', clientId: 'has space' });
    send(alice, { text: 'bad', clientId: 'x'.repeat(81) });
    send(alice, { text: 'bad', clientId: 5 });
    await until(() => of(alice, 'error').filter((e) => e.code === 'invalid').length === 3);
    send(alice, { text: 'legacy' });
    await until(() => of(bob, 'message').length === 3);

    expect(of(bob, 'ack')).toHaveLength(0);
    expect(of(bob, 'message').map((m) => m.text)).toEqual(['once', 'bob once', 'legacy']);
    const snap = await snapshotTexts(b, team);
    expect(snap.map((m) => m.text)).toEqual(['once', 'bob once', 'legacy']);
    expect(snap[0].clientId).toBe('id_1');
    expect('clientId' in snap[2]).toBe(false);
    for (const s of [alice, bob, other]) s.ws.close(1000, 'done');
  });

  it('commits a simultaneous retry on two sockets exactly once', async () => {
    const a = await login('alice@example.test');
    const a2 = await login('alice@example.test');
    const team = await createTeam(a);
    const s1 = await open(a, team);
    const s2 = await open(a2, team);

    send(s1, { text: 'race', clientId: 'race-1' });
    send(s2, { text: 'race', clientId: 'race-1' });
    await until(() => of(s1, 'ack').length + of(s2, 'ack').length === 1);
    await settle();
    for (const s of [s1, s2]) expect(of(s, 'message')).toHaveLength(1);
    const ack = of(s1, 'ack')[0] ?? of(s2, 'ack')[0];
    expect(ack.seq).toBe(of(s1, 'message')[0].seq);
    expect(await snapshotTexts(a, team)).toHaveLength(1);
    s1.ws.close(1000, 'done');
    s2.ws.close(1000, 'done');
  });

  it('remembers ids after they leave the history window', { timeout: 60_000 }, async () => {
    const a = await login('alice@example.test');
    const team = await createTeam(a);
    const s = await open(a, team);

    send(s, { text: 'first', clientId: 'old-id' });
    await until(() => of(s, 'message').length === 1);
    const firstSeq = of(s, 'message')[0].seq;
    for (let i = 0; i < 1005; i++) send(s, { text: `m${i}` });
    await until(() => of(s, 'message').length === 1006, 50_000);

    send(s, { text: 'first', clientId: 'old-id' });
    const ack = await until(() => of(s, 'ack')[0]);
    expect(ack.seq).toBe(firstSeq);
    send(s, { text: 'changed', clientId: 'old-id' });
    await until(() => of(s, 'error')[0]);
    await settle();
    expect(of(s, 'message')).toHaveLength(1006);
    s.ws.close(1000, 'done');
  });
});

