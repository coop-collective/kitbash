import { DurableObject } from 'cloudflare:workers';

export type RoomSession = { userId: string; teamId: string; sessionId: string; expiresAt: number };
type Connection = RoomSession & { tokens: number; updatedAt: number };
type Message = { seq: number; userId: string; text: string; clientId: string | null };
type Role = 'owner' | 'member' | 'viewer';

const MAX_CONNECTIONS = 100;
const MAX_MESSAGE_BYTES = 4096;
const MAX_TEXT_CHARS = 1000;
const HISTORY = 50;
// Token bucket sized well above the acceptance workload (60 messages at 100ms intervals).
const RATE_BURST = 100;
const RATE_PER_SECOND = 100;
const ID = /^[A-Za-z0-9_-]{1,80}$/;
const encoder = new TextEncoder();

/** Wire shape of a stored message; `clientId` is omitted for legacy / id-less messages. */
const toWire = (m: Message) => ({ seq: m.seq, userId: m.userId, text: m.text, ...(m.clientId ? { clientId: m.clientId } : {}) });

/**
 * One SQLite Durable Object per (team, room). Sockets use the hibernation API; the
 * authoritative state is SQLite (history, dedup records) and socket attachments (identity).
 * The object is only reachable through the authenticated gateway in routes/teams.ts.
 *
 * Every application send and every delivery re-checks the session and team membership in D1,
 * so logout, removal and downgrade apply to sockets that are already open.
 */
export class TeamRoom extends DurableObject<Env> {
  // Orders message handling in arrival order across the awaits on D1. Not authoritative state.
  private chain: Promise<void> = Promise.resolve();

  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    const sql = ctx.storage.sql;
    // AUTOINCREMENT keeps seq strictly increasing even after pruning deletes old rows.
    sql.exec('CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY AUTOINCREMENT, userId TEXT NOT NULL, text TEXT NOT NULL)');
    // Additive upgrade of rooms created before clientId existed.
    const columns = sql.exec<{ name: string }>('PRAGMA table_info(messages)').toArray();
    if (!columns.some((col) => col.name === 'clientId')) sql.exec('ALTER TABLE messages ADD COLUMN clientId TEXT');
    // Dedup records outlive the latest-50 history window; they are never pruned.
    sql.exec('CREATE TABLE IF NOT EXISTS dedup (userId TEXT NOT NULL, clientId TEXT NOT NULL, seq INTEGER NOT NULL, text TEXT NOT NULL, PRIMARY KEY (userId, clientId))');
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  async fetch(request: Request): Promise<Response> {
    if (request.headers.get('upgrade')?.toLowerCase() !== 'websocket') return new Response('Upgrade required', { status: 426 });
    // Only the gateway builds these headers; it discards everything the client sent.
    const userId = request.headers.get('x-room-user');
    const teamId = request.headers.get('x-room-team');
    const sessionId = request.headers.get('x-room-session');
    const expiresAt = Number(request.headers.get('x-room-expires'));
    if (
      !userId || !teamId || !sessionId || !ID.test(userId) || !ID.test(teamId) || !ID.test(sessionId) ||
      !Number.isFinite(expiresAt) || expiresAt <= Date.now()
    ) {
      return new Response('Unauthorized', { status: 401 });
    }
    let active = 0;
    for (const peer of this.ctx.getWebSockets()) {
      const attached = peer.deserializeAttachment() as Connection | null;
      if (!attached || attached.expiresAt <= Date.now()) {
        try { peer.close(1008, 'Session expired'); } catch { /* already closed */ }
      } else if (peer.readyState === WebSocket.OPEN) active++;
    }
    if (active >= MAX_CONNECTIONS) return new Response('Room full', { status: 503 });

    const pair = new WebSocketPair();
    this.ctx.acceptWebSocket(pair[1]);
    pair[1].serializeAttachment({ userId, teamId, sessionId, expiresAt, tokens: RATE_BURST, updatedAt: Date.now() } satisfies Connection);
    const latest = this.ctx.storage.sql
      .exec<Message>('SELECT seq, userId, text, clientId FROM messages ORDER BY seq DESC LIMIT ?', HISTORY)
      .toArray()
      .reverse();
    pair[1].send(JSON.stringify({ type: 'snapshot', messages: latest.map(toWire) }));
    return new Response(null, { status: 101, webSocket: pair[0] });
  }

  /** Current authority from D1 (never cached): the role if the session and membership are live. */
  private async roleFor(connection: Connection): Promise<Role | null> {
    const row = await this.env.DB.prepare(
      'SELECT m.role AS role FROM sessions s JOIN team_members m ON m.user_id = s.user_id ' +
        'WHERE s.id = ? AND s.user_id = ? AND s.revoked_at IS NULL AND s.expires_at > ? AND m.team_id = ?',
    )
      .bind(connection.sessionId, connection.userId, Math.floor(Date.now() / 1000), connection.teamId)
      .first<{ role: Role }>();
    return row?.role ?? null;
  }

  private reply(socket: WebSocket, event: Record<string, unknown>) {
    try { socket.send(JSON.stringify(event)); } catch { /* socket already closed */ }
  }

  private reject(socket: WebSocket, code: string, error: string, extra: Record<string, unknown> = {}) {
    this.reply(socket, { type: 'error', code, error, ...extra });
  }

  webSocketMessage(socket: WebSocket, input: string | ArrayBuffer): Promise<void> {
    const run = this.chain.then(() => this.handle(socket, input)).catch(() => {
      try { socket.close(1011, 'Internal error'); } catch { /* already closed */ }
    });
    this.chain = run;
    return run;
  }

  private async handle(socket: WebSocket, input: string | ArrayBuffer): Promise<void> {
    const connection = socket.deserializeAttachment() as Connection | null;
    // Sockets attached before sessions were recorded cannot be authorized; they must reconnect.
    if (!connection || !connection.sessionId || connection.expiresAt <= Date.now()) { socket.close(1008, 'Session expired'); return; }
    if (typeof input !== 'string') { socket.close(1003, 'Text frames only'); return; }
    if (encoder.encode(input).byteLength > MAX_MESSAGE_BYTES) { socket.close(1009, 'Message too large'); return; }

    type Incoming = { text?: unknown; clientId?: unknown };
    let parsed: Incoming | null = null;
    try {
      const value = JSON.parse(input) as unknown;
      if (value && typeof value === 'object' && !Array.isArray(value)) parsed = value as Incoming;
    } catch { /* handled below */ }
    if (!parsed) return this.reject(socket, 'invalid', 'invalid message');

    const now = Date.now();
    connection.tokens = Math.min(RATE_BURST, connection.tokens + (Math.max(0, now - connection.updatedAt) / 1000) * RATE_PER_SECOND);
    connection.updatedAt = now;
    if (connection.tokens < 1) { socket.close(1008, 'Rate limit'); return; }
    connection.tokens--;
    socket.serializeAttachment(connection);

    // Authority comes first: dedup lookups, conflicts and acks must not reveal anything to a
    // removed, logged-out or read-only sender.
    let role: Role | null;
    try { role = await this.roleFor(connection); } catch { return this.reject(socket, 'unavailable', 'authorization unavailable'); }
    if (!role) {
      this.reject(socket, 'forbidden', 'session or membership revoked');
      try { socket.close(1008, 'Access revoked'); } catch { /* already closed */ }
      return;
    }
    if (role === 'viewer') return this.reject(socket, 'forbidden', 'read-only role');

    const { text, clientId } = parsed;
    if (typeof text !== 'string' || !text.trim() || [...text].length > MAX_TEXT_CHARS) return this.reject(socket, 'invalid', 'invalid text');
    if (clientId !== undefined && (typeof clientId !== 'string' || !ID.test(clientId))) return this.reject(socket, 'invalid', 'invalid clientId');

    // Dedup lookup, insert and pruning are one synchronous section, so simultaneous retries
    // serialize: the first commits, the rest find its record.
    const outcome = this.ctx.storage.transactionSync(() => {
      const sql = this.ctx.storage.sql;
      if (clientId !== undefined) {
        const prior = sql.exec<{ seq: number; text: string }>('SELECT seq, text FROM dedup WHERE userId = ? AND clientId = ?', connection.userId, clientId).toArray()[0];
        if (prior) return prior.text === text ? { kind: 'ack' as const, seq: prior.seq } : { kind: 'conflict' as const };
      }
      const inserted = sql
        .exec<Message>('INSERT INTO messages (userId, text, clientId) VALUES (?, ?, ?) RETURNING seq, userId, text, clientId', connection.userId, text, clientId ?? null)
        .one();
      if (clientId !== undefined) sql.exec('INSERT INTO dedup (userId, clientId, seq, text) VALUES (?, ?, ?, ?)', connection.userId, clientId, inserted.seq, text);
      sql.exec('DELETE FROM messages WHERE seq <= ?', inserted.seq - HISTORY);
      return { kind: 'new' as const, message: inserted };
    });

    if (outcome.kind === 'ack') return this.reply(socket, { type: 'ack', seq: outcome.seq, clientId });
    if (outcome.kind === 'conflict') return this.reject(socket, 'conflict', 'clientId reused with different text', { clientId });
    await this.broadcast(JSON.stringify({ type: 'message', ...toWire(outcome.message) }));
  }

  /** Delivers one committed event, authorizing each recipient against current D1 state first. */
  private async broadcast(event: string): Promise<void> {
    const peers = this.ctx.getWebSockets().map((peer) => ({ peer, attached: peer.deserializeAttachment() as Connection | null }));
    const verdicts = new Map<string, Promise<Role | null>>();
    const authorize = (c: Connection) => {
      const key = `${c.sessionId}:${c.userId}`;
      let verdict = verdicts.get(key);
      if (!verdict) verdicts.set(key, (verdict = this.roleFor(c).catch(() => null)));
      return verdict;
    };
    await Promise.all(
      peers.map(async ({ peer, attached }) => {
        try {
          if (!attached || attached.expiresAt <= Date.now() || !(await authorize(attached))) peer.close(1008, 'Access revoked');
          else peer.send(event);
        } catch {
          try { peer.close(1011, 'Send failed'); } catch { /* already closed */ }
        }
      }),
    );
  }

  webSocketClose(socket: WebSocket, code: number, reason: string): void {
    try { socket.close(code === 1005 || code === 1006 ? 1000 : code, reason); } catch { /* already closed */ }
  }

  webSocketError(socket: WebSocket): void {
    try { socket.close(1011, 'Connection error'); } catch { /* already closed */ }
  }
}
