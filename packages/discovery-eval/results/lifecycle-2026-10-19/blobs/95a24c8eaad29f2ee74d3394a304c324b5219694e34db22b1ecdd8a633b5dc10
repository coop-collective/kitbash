import type { Context, Hono, MiddlewareHandler } from 'hono';

export type AppEnv = Env & { SESSION_SECRET?: string; DEMO_PASSWORD?: string };
export type Vars = { userId: string; email: string; sessionId: string; sessionExp: number };
type App = Hono<{ Bindings: AppEnv; Variables: Vars }>;
type C = Context<{ Bindings: AppEnv; Variables: Vars }>;

interface Deps {
  requireAuth: MiddlewareHandler<{ Bindings: AppEnv; Variables: Vars }>;
  readBounded: (req: Request, limit: number) => Promise<Uint8Array | null>;
  readJson: (c: C) => Promise<Record<string, unknown> | null>;
  knownUsers: Set<string>;
  maxUpload: number;
}

const ROOM_RE = /^[A-Za-z0-9_-]{1,40}$/;
const canWrite = (role: string | null) => role === 'owner' || role === 'member';

export function mountTeams(app: App, deps: Deps) {
  const { requireAuth, readBounded, readJson, knownUsers, maxUpload } = deps;
  const now = () => Math.floor(Date.now() / 1000);

  // Membership is always read from D1 so removals take effect immediately.
  const roleOf = async (c: C, teamId: string) =>
    (
      await c.env.DB.prepare('SELECT role FROM team_members WHERE team_id = ? AND user_id = ?')
        .bind(teamId, c.get('userId'))
        .first<{ role: string }>()
    )?.role ?? null;

  const base = '/api/teams';
  app.use(`${base}`, requireAuth);
  app.use(`${base}/*`, requireAuth);

  app.post(base, async (c) => {
    const body = await readJson(c);
    const name = typeof body?.name === 'string' ? body.name.trim() : '';
    if (name.length < 1 || name.length > 80) return c.json({ error: 'invalid name' }, 400);
    const id = crypto.randomUUID();
    const t = now();
    await c.env.DB.batch([
      c.env.DB.prepare('INSERT INTO teams (id, name, created_by, created_at) VALUES (?, ?, ?, ?)').bind(id, name, c.get('userId'), t),
      c.env.DB.prepare("INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'owner', ?)").bind(id, c.get('userId'), t),
    ]);
    c.header('Cache-Control', 'private, no-store');
    return c.json({ id, name }, 201);
  });

  app.get(base, async (c) => {
    const { results } = await c.env.DB.prepare(
      'SELECT t.id, t.name, m.role FROM team_members m JOIN teams t ON t.id = m.team_id WHERE m.user_id = ? ORDER BY t.created_at, t.id',
    )
      .bind(c.get('userId'))
      .all<{ id: string; name: string; role: string }>();
    c.header('Cache-Control', 'private, no-store');
    return c.json({ teams: results });
  });

  // ---- membership (owner only) ----

  async function manageGuard(c: C): Promise<Response | { teamId: string; target: string }> {
    const teamId = c.req.param('team')!;
    if ((await roleOf(c, teamId)) !== 'owner') return c.json({ error: 'forbidden' }, 403);
    const target = c.req.param('userId')!;
    if (!knownUsers.has(target)) return c.json({ error: 'unknown user' }, 400);
    const current = await c.env.DB.prepare('SELECT role FROM team_members WHERE team_id = ? AND user_id = ?').bind(teamId, target).first<{ role: string }>();
    if (current?.role === 'owner') return c.json({ error: 'owner is immutable' }, 409);
    return { teamId, target };
  }

  app.put(`${base}/:team/members/:userId`, async (c) => {
    const g = await manageGuard(c);
    if (g instanceof Response) return g;
    const body = await readJson(c);
    if (!body || (body.role !== 'member' && body.role !== 'viewer')) return c.json({ error: 'invalid role' }, 400);
    await c.env.DB.prepare(
      "INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, ?, ?) ON CONFLICT(team_id, user_id) DO UPDATE SET role = excluded.role WHERE role != 'owner'",
    )
      .bind(g.teamId, g.target, body.role, now())
      .run();
    return c.body(null, 204);
  });

  app.delete(`${base}/:team/members/:userId`, async (c) => {
    const g = await manageGuard(c);
    if (g instanceof Response) return g;
    await c.env.DB.prepare("DELETE FROM team_members WHERE team_id = ? AND user_id = ? AND role != 'owner'").bind(g.teamId, g.target).run();
    return c.body(null, 204);
  });

  // ---- team uploads ----

  app.post(`${base}/:team/uploads`, async (c) => {
    const teamId = c.req.param('team');
    if (!canWrite(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const data = await readBounded(c.req.raw, maxUpload);
    if (!data) return c.json({ error: 'too large' }, 413);
    const id = crypto.randomUUID();
    const key = `teams/${teamId}/${id}`;
    await c.env.UPLOADS.put(key, data, { httpMetadata: { contentType: 'application/octet-stream' } });
    // Authority may have changed while the body streamed in; re-check before publishing.
    if (!canWrite(await roleOf(c, teamId))) {
      await c.env.UPLOADS.delete(key);
      return c.json({ error: 'forbidden' }, 403);
    }
    await c.env.DB.prepare('INSERT INTO team_uploads (id, team_id, object_key, size, created_by, created_at) VALUES (?, ?, ?, ?, ?, ?)')
      .bind(id, teamId, key, data.byteLength, c.get('userId'), now())
      .run();
    return c.json({ id }, 201);
  });

  const findTeamUpload = (c: C, teamId: string) =>
    c.env.DB.prepare('SELECT object_key FROM team_uploads WHERE id = ? AND team_id = ?')
      .bind(c.req.param('id'), teamId)
      .first<{ object_key: string }>();

  app.get(`${base}/:team/uploads/:id`, async (c) => {
    const teamId = c.req.param('team');
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const row = await findTeamUpload(c, teamId);
    const obj = row ? await c.env.UPLOADS.get(row.object_key) : null;
    if (!obj) return c.json({ error: 'not found' }, 404);
    return new Response(obj.body, {
      headers: {
        'Content-Type': 'application/octet-stream',
        'Content-Length': String(obj.size),
        'Content-Disposition': 'attachment; filename="download.bin"',
        'X-Content-Type-Options': 'nosniff',
        'Cache-Control': 'private, no-store',
      },
    });
  });

  app.delete(`${base}/:team/uploads/:id`, async (c) => {
    const teamId = c.req.param('team');
    if (!canWrite(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const row = await findTeamUpload(c, teamId);
    if (!row) return c.json({ error: 'not found' }, 404);
    await c.env.DB.prepare('DELETE FROM team_uploads WHERE id = ? AND team_id = ?').bind(c.req.param('id'), teamId).run();
    await c.env.UPLOADS.delete(row.object_key);
    return c.body(null, 204);
  });

  // ---- rooms ----

  app.get(`${base}/:team/rooms/:room/ws`, async (c) => {
    const origin = c.req.header('Origin');
    if (!origin || origin !== new URL(c.req.url).origin) return c.json({ error: 'bad origin' }, 403);
    if (c.req.url.includes('?')) return c.json({ error: 'query not allowed' }, 400);
    const teamId = c.req.param('team');
    const room = c.req.param('room');
    if (!ROOM_RE.test(room)) return c.json({ error: 'invalid room' }, 400);
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    if (c.req.header('Upgrade')?.toLowerCase() !== 'websocket') return c.json({ error: 'upgrade required' }, 426);

    // Fresh header set: nothing client-supplied survives except the handshake fields.
    const headers = new Headers();
    for (const h of ['Upgrade', 'Connection', 'Sec-WebSocket-Key', 'Sec-WebSocket-Version', 'Sec-WebSocket-Protocol', 'Sec-WebSocket-Extensions']) {
      const v = c.req.header(h);
      if (v) headers.set(h, v);
    }
    headers.set('X-Verified-User', c.get('userId'));
    headers.set('X-Verified-Team', teamId);
    headers.set('X-Verified-Session', c.get('sessionId'));
    const stub = c.env.ROOMS.get(c.env.ROOMS.idFromName(`${teamId}:${room}`));
    return stub.fetch('https://room.internal/connect', { headers });
  });
}
