import { DurableObject } from 'cloudflare:workers';

const MAX_TEXT = 1000;
const MAX_FRAME_BYTES = 4096;
const SNAPSHOT_SIZE = 50;
const RETAIN = 1000;
const CLIENT_ID_RE = /^[A-Za-z0-9_-]{1,80}$/;

// Serialized per-socket (survives hibernation). Set only from the verified Worker handshake.
// Identity only: permissions are always re-read from D1 (see `authority`).
interface Attachment {
  userId: string;
  teamId: string;
  sessionId: string;
  sessionExpires: number;
  joinedSeq?: number; // newest seq already contained in this socket's snapshot
  leaseExpires?: number; // legacy (phase one); no longer consulted
}

type Commit = { kind: 'new' | 'dup'; seq: number } | { kind: 'conflict' };

const enc = new TextEncoder();
const nowS = () => Math.floor(Date.now() / 1000);

async function sha256Hex(text: string): Promise<string> {
  const d = new Uint8Array(await crypto.subtle.digest('SHA-256', enc.encode(text)));
  return Array.from(d, (b) => b.toString(16).padStart(2, '0')).join('');
}

/**
 * One instance per team/room. Reachable only through the Worker's ROOMS binding, which
 * calls it after verifying session, membership, origin and room name. Verified identity
 * is passed in x-room-* headers that the Worker replaces unconditionally.
 */
export class RoomDO extends DurableObject<Env> {
  // Serializes message handling so commit order == delivery order. Transient only;
  // all authoritative state lives in DO SQLite and socket attachments.
  private chain: Promise<unknown> = Promise.resolve();

  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    ctx.blockConcurrencyWhile(async () => {
      const sql = ctx.storage.sql;
      sql.exec('CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY, user_id TEXT NOT NULL, text TEXT NOT NULL, created_at INTEGER NOT NULL)');
      sql.exec('CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v INTEGER NOT NULL)');
      // Additive upgrade of rooms created before client ids existed.
      const cols = sql.exec("SELECT name FROM pragma_table_info('messages')").toArray();
      if (!cols.some((c) => c.name === 'client_id')) sql.exec('ALTER TABLE messages ADD COLUMN client_id TEXT');
      // Retained independently of the latest-N history window.
      sql.exec(
        'CREATE TABLE IF NOT EXISTS dedup (user_id TEXT NOT NULL, client_id TEXT NOT NULL, seq INTEGER NOT NULL, text_hash TEXT NOT NULL, PRIMARY KEY (user_id, client_id))',
      );
    });
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  async fetch(request: Request): Promise<Response> {
    if (request.headers.get('Upgrade')?.toLowerCase() !== 'websocket') return new Response('expected websocket', { status: 426 });
    const userId = request.headers.get('x-room-user');
    const teamId = request.headers.get('x-room-team');
    const sessionId = request.headers.get('x-room-session');
    const sessionExpires = Number(request.headers.get('x-room-session-expires'));
    if (!userId || !teamId || !sessionId || !Number.isFinite(sessionExpires)) return new Response('forbidden', { status: 403 });

    const pair = new WebSocketPair();
    const [client, server] = [pair[0], pair[1]];
    const messages = this.snapshot();
    const joinedSeq = messages.length ? (messages[messages.length - 1].seq as number) : 0;
    const att: Attachment = { userId, teamId, sessionId, sessionExpires, joinedSeq };
    this.ctx.acceptWebSocket(server);
    server.serializeAttachment(att);
    server.send(JSON.stringify({ type: 'snapshot', messages }));
    return new Response(null, { status: 101, webSocket: client });
  }

  private snapshot() {
    return this.ctx.storage.sql
      .exec(`SELECT seq, user_id, text, client_id FROM (SELECT * FROM messages ORDER BY seq DESC LIMIT ${SNAPSHOT_SIZE}) ORDER BY seq ASC`)
      .toArray()
      .map((r) => ({
        seq: r.seq as number,
        userId: r.user_id as string,
        text: r.text as string,
        ...(r.client_id ? { clientId: r.client_id as string } : {}),
      }));
  }

  /** Atomically dedupe + append. Must stay synchronous so concurrent retries cannot interleave. */
  private commit(userId: string, text: string, clientId: string | null, hash: string | null): Commit {
    const sql = this.ctx.storage.sql;
    return this.ctx.storage.transactionSync((): Commit => {
      if (clientId) {
        const prior = sql.exec('SELECT seq, text_hash FROM dedup WHERE user_id = ? AND client_id = ?', userId, clientId).toArray()[0];
        if (prior) return prior.text_hash === hash ? { kind: 'dup', seq: prior.seq as number } : { kind: 'conflict' };
      }
      sql.exec("INSERT INTO meta (k, v) VALUES ('seq', 1) ON CONFLICT(k) DO UPDATE SET v = v + 1");
      const seq = sql.exec("SELECT v FROM meta WHERE k = 'seq'").one().v as number;
      sql.exec('INSERT INTO messages (seq, user_id, text, created_at, client_id) VALUES (?, ?, ?, ?, ?)', seq, userId, text, Date.now(), clientId);
      if (clientId) sql.exec('INSERT INTO dedup (user_id, client_id, seq, text_hash) VALUES (?, ?, ?, ?)', userId, clientId, seq, hash);
      sql.exec('DELETE FROM messages WHERE seq <= ?', seq - RETAIN);
      return { kind: 'new', seq };
    });
  }

  /** Current authority from D1: live session AND current membership. Returns the role or null. */
  private async authority(att: Attachment): Promise<string | null> {
    const row = await this.env.DB.prepare(
      'SELECT m.role AS role FROM sessions s JOIN team_members m ON m.user_id = s.user_id WHERE s.id = ? AND s.revoked_at IS NULL AND s.expires_at > ? AND m.team_id = ? AND m.user_id = ?',
    )
      .bind(att.sessionId, nowS(), att.teamId, att.userId)
      .first<{ role: string }>();
    return row?.role ?? null;
  }

  private send(ws: WebSocket, payload: unknown, close?: { code: number; reason: string }) {
    try {
      ws.send(JSON.stringify(payload));
      if (close) ws.close(close.code, close.reason);
    } catch {
      /* socket already gone */
    }
  }

  private fail(ws: WebSocket, message: string, code = 'invalid', close = false) {
    this.send(ws, { type: 'error', code, error: message }, close ? { code: 1008, reason: message } : undefined);
  }

  webSocketMessage(ws: WebSocket, message: string | ArrayBuffer): Promise<void> {
    const run = this.chain.then(() => this.handle(ws, message));
    this.chain = run.catch(() => {});
    return run;
  }

  private async handle(ws: WebSocket, message: string | ArrayBuffer) {
    const att = ws.deserializeAttachment() as Attachment | null;
    if (!att) return ws.close(1008, 'unauthorized');
    if (typeof message !== 'string') return this.fail(ws, 'text frames only');
    if (enc.encode(message).byteLength > MAX_FRAME_BYTES) return this.fail(ws, 'message too large');

    let body: unknown;
    try {
      body = JSON.parse(message);
    } catch {
      return this.fail(ws, 'invalid json');
    }
    if (!body || typeof body !== 'object' || Array.isArray(body)) return this.fail(ws, 'invalid text');
    const { text, clientId: rawId } = body as { text?: unknown; clientId?: unknown };
    if (typeof text !== 'string' || text.trim().length === 0 || text.length > MAX_TEXT) return this.fail(ws, 'invalid text');
    let clientId: string | null = null;
    if ('clientId' in body) {
      if (typeof rawId !== 'string' || !CLIENT_ID_RE.test(rawId)) return this.fail(ws, 'invalid clientId', 'invalid_client_id');
      clientId = rawId;
    }
    const hash = clientId ? await sha256Hex(text) : null;

    // Authority first: a prior success with this clientId grants nothing.
    const role = await this.authority(att);
    if (!role) return this.fail(ws, 'unauthorized', 'unauthorized', true);
    if (role !== 'owner' && role !== 'member') return this.fail(ws, 'read-only', 'forbidden');

    const result = this.commit(att.userId, text, clientId, hash);
    if (result.kind === 'conflict') return this.send(ws, { type: 'error', code: 'conflict', clientId });
    if (result.kind === 'dup') return this.send(ws, { type: 'ack', seq: result.seq, clientId });

    const frame = JSON.stringify({ type: 'message', seq: result.seq, userId: att.userId, text, ...(clientId ? { clientId } : {}) });
    await this.broadcast(frame, result.seq);
  }

  /** Every recipient is authorized against current D1 state before this send is delivered to it. */
  private async broadcast(frame: string, seq: number) {
    const peers = this.ctx.getWebSockets().flatMap((ws) => {
      const att = ws.deserializeAttachment() as Attachment | null;
      return att ? [{ ws, att }] : [];
    });
    const verdicts = new Map<string, Promise<string | null>>();
    const check = (att: Attachment) => {
      const key = `${att.sessionId}|${att.userId}`;
      if (!verdicts.has(key)) verdicts.set(key, this.authority(att).catch(() => null));
      return verdicts.get(key)!;
    };
    const decided = await Promise.all(peers.map(async (p) => ({ ...p, role: await check(p.att) })));
    for (const { ws, att, role } of decided) {
      if (!role) {
        this.fail(ws, 'unauthorized', 'unauthorized', true);
        continue;
      }
      if (att.joinedSeq !== undefined && seq <= att.joinedSeq) continue; // already in its snapshot
      try {
        ws.send(frame);
      } catch {
        /* peer closing */
      }
    }
  }

  webSocketClose(ws: WebSocket, code: number) {
    try {
      ws.close(code === 1005 || code === 1006 ? 1000 : code);
    } catch {
      /* already closed */
    }
  }

  webSocketError(ws: WebSocket) {
    try {
      ws.close(1011, 'error');
    } catch {
      /* already closed */
    }
  }
}
