import type { Context, Hono, MiddlewareHandler } from 'hono';

type Vars = { userId: string; email: string; sessionId: string; sessionExpires: number };
type AppEnv = Env & { SESSION_SECRET?: string; DEMO_PASSWORD?: string };
type App = Hono<{ Bindings: AppEnv; Variables: Vars }>;
type C = Context<{ Bindings: AppEnv; Variables: Vars }>;

export interface TeamDeps {
  requireAuth: MiddlewareHandler<{ Bindings: AppEnv; Variables: Vars }>;
  readBounded: (req: Request, limit: number) => Promise<Uint8Array | null>;
  readJson: (c: C) => Promise<Record<string, unknown> | null>;
  knownUsers: Set<string>;
  maxUpload: number;
}

const ROOM_RE = /^[A-Za-z0-9_-]{1,40}$/;
const nowS = () => Math.floor(Date.now() / 1000);

async function roleOf(c: C, teamId: string): Promise<string | null> {
  const row = await c.env.DB.prepare('SELECT role FROM team_members WHERE team_id = ? AND user_id = ?')
    .bind(teamId, c.get('userId'))
    .first<{ role: string }>();
  return row?.role ?? null;
}

export function registerTeamRoutes(app: App, deps: TeamDeps) {
  const { requireAuth, readBounded, readJson } = deps;
  const noStore = { 'Cache-Control': 'private, no-store' };

  app.use('/api/teams/*', requireAuth);

  app.post('/api/teams', async (c) => {
    const body = await readJson(c);
    const name = body && typeof body.name === 'string' ? body.name.trim() : '';
    if (name.length < 1 || name.length > 80) return c.json({ error: 'invalid name' }, 400);
    const id = crypto.randomUUID();
    const userId = c.get('userId');
    const now = nowS();
    await c.env.DB.batch([
      c.env.DB.prepare('INSERT INTO teams (id, name, owner_id, created_at) VALUES (?, ?, ?, ?)').bind(id, name, userId, now),
      c.env.DB.prepare("INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'owner', ?)").bind(id, userId, now),
    ]);
    return c.json({ id, name }, 201, noStore);
  });

  app.get('/api/teams', async (c) => {
    const { results } = await c.env.DB.prepare(
      'SELECT t.id AS id, t.name AS name, m.role AS role FROM team_members m JOIN teams t ON t.id = m.team_id WHERE m.user_id = ? ORDER BY t.created_at, t.id',
    )
      .bind(c.get('userId'))
      .all<{ id: string; name: string; role: string }>();
    return c.json({ teams: results }, 200, noStore);
  });

  // ---- membership (owner only) ----

  const manage = async (c: C): Promise<{ res?: Response; teamId?: string; target?: string }> => {
    const teamId = c.req.param('team')!;
    const role = await roleOf(c, teamId);
    if (role !== 'owner') return { res: c.json({ error: 'forbidden' }, 403) };
    const target = c.req.param('userId')!;
    if (!deps.knownUsers.has(target)) return { res: c.json({ error: 'unknown user' }, 400) };
    const owner = await c.env.DB.prepare("SELECT 1 AS x FROM team_members WHERE team_id = ? AND user_id = ? AND role = 'owner'").bind(teamId, target).first();
    if (owner) return { res: c.json({ error: 'owner membership is fixed' }, 409) };
    return { teamId, target };
  };

  app.put('/api/teams/:team/members/:userId', async (c) => {
    const body = await readJson(c);
    if ((await roleOf(c, c.req.param('team')!)) !== 'owner') return c.json({ error: 'forbidden' }, 403);
    if (!body || body.role !== 'member') return c.json({ error: 'invalid role' }, 400);
    const m = await manage(c);
    if (!m.teamId || !m.target) return m.res!;
    await c.env.DB.prepare(
      "INSERT INTO team_members (team_id, user_id, role, created_at) VALUES (?, ?, 'member', ?) ON CONFLICT(team_id, user_id) DO UPDATE SET role = excluded.role WHERE team_members.role != 'owner'",
    )
      .bind(m.teamId, m.target, nowS())
      .run();
    return c.body(null, 204);
  });

  app.delete('/api/teams/:team/members/:userId', async (c) => {
    const m = await manage(c);
    if (!m.teamId || !m.target) return m.res!;
    await c.env.DB.prepare("DELETE FROM team_members WHERE team_id = ? AND user_id = ? AND role != 'owner'").bind(m.teamId, m.target).run();
    return c.body(null, 204);
  });

  // ---- shared uploads ----

  const keyFor = (teamId: string, id: string) => `teams/${teamId}/uploads/${id}`;

  app.post('/api/teams/:team/uploads', async (c) => {
    const teamId = c.req.param('team')!;
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const data = await readBounded(c.req.raw, deps.maxUpload);
    if (!data) return c.json({ error: 'too large' }, 413);
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const id = crypto.randomUUID();
    const key = keyFor(teamId, id);
    await c.env.UPLOADS.put(key, data, { httpMetadata: { contentType: 'application/octet-stream' } });
    try {
      await c.env.DB.prepare('INSERT INTO team_uploads (id, team_id, object_key, size, content_type, created_by, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)')
        .bind(id, teamId, key, data.byteLength, 'application/octet-stream', c.get('userId'), nowS())
        .run();
    } catch (e) {
      await c.env.UPLOADS.delete(key);
      throw e;
    }
    return c.json({ id }, 201, noStore);
  });

  const findTeamUpload = (c: C, teamId: string) =>
    c.env.DB.prepare('SELECT id FROM team_uploads WHERE id = ? AND team_id = ?').bind(c.req.param('id'), teamId).first<{ id: string }>();

  app.get('/api/teams/:team/uploads/:id', async (c) => {
    const teamId = c.req.param('team')!;
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const row = await findTeamUpload(c, teamId);
    const obj = row ? await c.env.UPLOADS.get(keyFor(teamId, row.id)) : null;
    if (!obj) return c.json({ error: 'not found' }, 404, noStore);
    return new Response(obj.body, {
      headers: {
        'Content-Type': 'application/octet-stream',
        'Content-Length': String(obj.size),
        'Content-Disposition': 'attachment; filename="download.bin"',
        'X-Content-Type-Options': 'nosniff',
        'Cache-Control': 'private, no-store',
      },
    });
  });

  app.delete('/api/teams/:team/uploads/:id', async (c) => {
    const teamId = c.req.param('team')!;
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    const row = await findTeamUpload(c, teamId);
    if (row) {
      await c.env.DB.prepare('DELETE FROM team_uploads WHERE id = ? AND team_id = ?').bind(row.id, teamId).run();
      await c.env.UPLOADS.delete(keyFor(teamId, row.id));
    }
    return c.body(null, 204);
  });

  // ---- room WebSocket ----

  app.get('/api/teams/:team/rooms/:room/ws', async (c) => {
    const url = new URL(c.req.url);
    if (c.req.header('Origin') !== url.origin) return c.json({ error: 'bad origin' }, 403);
    if (url.search !== '') return c.json({ error: 'query not allowed' }, 400);
    const room = c.req.param('room')!;
    if (!ROOM_RE.test(room)) return c.json({ error: 'invalid room' }, 400);
    const teamId = c.req.param('team')!;
    if (!(await roleOf(c, teamId))) return c.json({ error: 'forbidden' }, 403);
    if (c.req.header('Upgrade')?.toLowerCase() !== 'websocket') return c.json({ error: 'expected websocket' }, 426);

    // Forward only protocol headers; identity headers are always server-generated.
    const headers = new Headers();
    for (const h of ['Upgrade', 'Connection', 'Sec-WebSocket-Key', 'Sec-WebSocket-Version', 'Sec-WebSocket-Protocol']) {
      const v = c.req.header(h);
      if (v) headers.set(h, v);
    }
    headers.set('x-room-user', c.get('userId'));
    headers.set('x-room-team', teamId);
    headers.set('x-room-session', c.get('sessionId'));
    headers.set('x-room-session-expires', String(c.get('sessionExpires')));
    const stub = c.env.ROOMS.get(c.env.ROOMS.idFromName(`${teamId}:${room}`));
    return stub.fetch(new Request(`https://room.internal/ws`, { headers }));
  });
}
