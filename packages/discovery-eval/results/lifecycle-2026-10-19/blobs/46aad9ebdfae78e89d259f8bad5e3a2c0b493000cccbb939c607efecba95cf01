import { DurableObject } from 'cloudflare:workers';

const MAX_MESSAGE_BYTES = 4096;
const MAX_TEXT_CHARS = 1000;
const SNAPSHOT_SIZE = 50;
const RETAINED = 200;
const MAX_CONNECTIONS = 100;
const CLIENT_ID_RE = /^[A-Za-z0-9_-]{1,80}$/;

type Attachment = { userId: string; sessionId: string; teamId: string; expiresAt: number };
type Message = { seq: number; userId: string; text: string; clientId?: string };
type Role = 'owner' | 'member' | 'viewer';

/**
 * One instance per team/room. Reachable only through the authorizing gateway in teams.ts:
 * the namespace binding is not exposed on any route. SQLite is authoritative for history and
 * for client-id deduplication; each socket's identity lives in its hibernation-safe attachment
 * (no socket map). Session and membership are re-read from D1 for every send and every delivery.
 */
export class TeamRoom extends DurableObject<Env> {
  // Only orders work (so deliveries leave in seq order); all authoritative state is in SQLite.
  private tail: Promise<unknown> = Promise.resolve();

  constructor(ctx: DurableObjectState, env: Env) {
    super(ctx, env);
    const sql = ctx.storage.sql;
    // AUTOINCREMENT keeps seq strictly increasing even after old rows are pruned.
    sql.exec('CREATE TABLE IF NOT EXISTS messages (seq INTEGER PRIMARY KEY AUTOINCREMENT, userId TEXT NOT NULL, text TEXT NOT NULL)');
    // Additive upgrade of rooms that already hold history: legacy rows simply have no clientId.
    if (!sql.exec<{ name: string }>('PRAGMA table_info(messages)').toArray().some((col) => col.name === 'clientId')) {
      sql.exec('ALTER TABLE messages ADD COLUMN clientId TEXT');
    }
    // Never pruned with history, so retries stay idempotent after a message leaves the latest-50 window.
    sql.exec(
      'CREATE TABLE IF NOT EXISTS dedupe (userId TEXT NOT NULL, clientId TEXT NOT NULL, seq INTEGER NOT NULL, text TEXT NOT NULL, PRIMARY KEY (userId, clientId)) WITHOUT ROWID',
    );
    ctx.setWebSocketAutoResponse(new WebSocketRequestResponsePair('ping', 'pong'));
  }

  private enqueue<T>(work: () => Promise<T> | T): Promise<T> {
    const run = this.tail.then(work);
    this.tail = run.catch(() => {});
    return run;
  }

  /** Current role of each distinct (session, user) pair; null when the session or membership is gone. */
  private async rolesFor(whos: Attachment[]): Promise<Map<string, Role | null>> {
    const distinct = new Map<string, Attachment>();
    for (const w of whos) distinct.set(`${w.sessionId}|${w.userId}`, w);
    const keys = [...distinct.keys()];
    const now = Math.floor(Date.now() / 1000);
    const stmts = keys.map((k) => {
      const w = distinct.get(k)!;
      return this.env.DB.prepare(
        'SELECT m.role AS role FROM sessions s JOIN team_members m ON m.user_id = s.user_id AND m.team_id = ? WHERE s.id = ? AND s.user_id = ? AND s.revoked_at IS NULL AND s.expires_at > ?',
      ).bind(w.teamId, w.sessionId, w.userId, now);
    });
    const out = new Map<string, Role | null>();
    if (!stmts.length) return out;
    const results = await this.env.DB.batch<{ role: Role }>(stmts);
    keys.forEach((k, i) => out.set(k, results[i].results[0]?.role ?? null));
    return out;
  }

  private snapshot(): Message[] {
    return this.ctx.storage.sql
      .exec<{ seq: number; userId: string; text: string; clientId: string | null }>(
        'SELECT seq, userId, text, clientId FROM (SELECT seq, userId, text, clientId FROM messages ORDER BY seq DESC LIMIT ?) ORDER BY seq',
        SNAPSHOT_SIZE,
      )
      .toArray()
      .map(({ clientId, ...m }) => (clientId ? { ...m, clientId } : m));
  }

  async fetch(request: Request): Promise<Response> {
    if (request.headers.get('upgrade')?.toLowerCase() !== 'websocket') return new Response('Upgrade required', { status: 426 });
    // Created only by the gateway, which strips every client-supplied copy first.
    const userId = request.headers.get('x-room-user');
    const sessionId = request.headers.get('x-room-session');
    const teamId = request.headers.get('x-room-team');
    const expiresAt = Number(request.headers.get('x-room-expires'));
    if (!userId || !sessionId || !teamId || !Number.isFinite(expiresAt) || expiresAt <= Date.now()) return new Response('Unauthorized', { status: 401 });

    // Queued behind in-flight sends so the snapshot and later live events never overlap.
    return this.enqueue(() => {
      let active = 0;
      for (const peer of this.ctx.getWebSockets()) {
        const attached = peer.deserializeAttachment() as Attachment | null;
        if (!attached || attached.expiresAt <= Date.now()) {
          try { peer.close(1008, 'Lease expired'); } catch { /* already closed */ }
        } else active++;
      }
      if (active >= MAX_CONNECTIONS) return new Response('Room full', { status: 503 });

      const pair = new WebSocketPair();
      this.ctx.acceptWebSocket(pair[1]);
      pair[1].serializeAttachment({ userId, sessionId, teamId, expiresAt } satisfies Attachment);
      pair[1].send(JSON.stringify({ type: 'snapshot', messages: this.snapshot() }));
      return new Response(null, { status: 101, webSocket: pair[0] });
    });
  }

  webSocketMessage(socket: WebSocket, input: string | ArrayBuffer): Promise<void> {
    return this.enqueue(() => this.handle(socket, input)).catch(() => {
      try { socket.close(1011, 'Internal error'); } catch { /* already closed */ }
    });
  }

  private async handle(socket: WebSocket, input: string | ArrayBuffer): Promise<void> {
    const reply = (event: object) => { try { socket.send(JSON.stringify(event)); } catch { /* socket gone */ } };
    const who = socket.deserializeAttachment() as Attachment | null;
    if (!who || !who.sessionId || !who.teamId || who.expiresAt <= Date.now()) { socket.close(1008, 'Lease expired'); return; }
    if (typeof input !== 'string') { socket.close(1003, 'Text only'); return; }
    if (new TextEncoder().encode(input).byteLength > MAX_MESSAGE_BYTES) { socket.close(1009, 'Message too large'); return; }

    // Authority first: nothing below (validation errors, dedupe, acks, commits) is reachable without it.
    const role = (await this.rolesFor([who])).get(`${who.sessionId}|${who.userId}`) ?? null;
    if (!role) { reply({ type: 'error', code: 'forbidden', error: 'not authorized' }); socket.close(1008, 'Not authorized'); return; }
    if (role === 'viewer') { reply({ type: 'error', code: 'forbidden', error: 'read-only' }); return; }

    let text: unknown;
    let clientId: unknown;
    try {
      const parsed = JSON.parse(input) as { text?: unknown; clientId?: unknown } | null;
      if (parsed && typeof parsed === 'object') ({ text, clientId } = parsed);
    } catch { /* falls through to the error below */ }
    const invalid = (error: string) => reply({ type: 'error', code: 'invalid', error });
    if (typeof text !== 'string' || !text.trim() || text.length > MAX_TEXT_CHARS) return invalid('invalid message');
    if (clientId !== undefined && (typeof clientId !== 'string' || !CLIENT_ID_RE.test(clientId))) return invalid('invalid clientId');
    const id = clientId as string | undefined;
    const body = text;

    // Synchronous, so the dedupe lookup and the insert are atomic with respect to every other send.
    const outcome = this.ctx.storage.transactionSync(() => {
      const sql = this.ctx.storage.sql;
      if (id) {
        const prior = sql.exec<{ seq: number; text: string }>('SELECT seq, text FROM dedupe WHERE userId = ? AND clientId = ?', who.userId, id).toArray()[0];
        if (prior) return prior.text === body ? ({ kind: 'ack', seq: prior.seq } as const) : ({ kind: 'conflict' } as const);
      }
      const inserted = sql
        .exec<{ seq: number }>('INSERT INTO messages (userId, text, clientId) VALUES (?, ?, ?) RETURNING seq', who.userId, body, id ?? null)
        .one();
      if (id) sql.exec('INSERT INTO dedupe (userId, clientId, seq, text) VALUES (?, ?, ?, ?)', who.userId, id, inserted.seq, body);
      sql.exec('DELETE FROM messages WHERE seq <= ?', inserted.seq - RETAINED);
      return { kind: 'new', seq: inserted.seq } as const;
    });

    if (outcome.kind === 'ack') { reply({ type: 'ack', seq: outcome.seq, clientId: id }); return; }
    if (outcome.kind === 'conflict') { reply({ type: 'error', code: 'conflict', error: 'clientId reused with different text', clientId: id }); return; }

    const event = JSON.stringify({ type: 'message', seq: outcome.seq, userId: who.userId, text: body, ...(id ? { clientId: id } : {}) });
    await this.deliver(event);
  }

  /** Each recipient is re-authorized against current session and membership for this send. */
  private async deliver(event: string): Promise<void> {
    const peers = this.ctx.getWebSockets();
    const attached = peers.map((p) => p.deserializeAttachment() as Attachment | null);
    const roles = await this.rolesFor(attached.filter((a): a is Attachment => !!a && !!a.sessionId && !!a.teamId));
    peers.forEach((peer, i) => {
      const a = attached[i];
      const allowed = !!a && a.expiresAt > Date.now() && !!roles.get(`${a.sessionId}|${a.userId}`);
      try {
        if (allowed) peer.send(event);
        else peer.close(1008, 'Not authorized');
      } catch { try { peer.close(1011, 'Send failed'); } catch { /* already closed */ } }
    });
  }

  webSocketClose(socket: WebSocket): void {
    try { socket.close(1000, 'Closed'); } catch { /* already closed */ }
  }

  webSocketError(socket: WebSocket): void {
    try { socket.close(1011, 'Connection error'); } catch { /* already closed */ }
  }
}
