{
  "name": "@kitbash/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Kitbash UI: Styrene-themed React components for agent and AI products, with a Storybook catalog agents can borrow from.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node scripts/check-catalog.mjs && node scripts/gen-skill-catalog.mjs --check",
    "gen-skill-catalog": "node scripts/gen-skill-catalog.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "storybook": "10.6.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
