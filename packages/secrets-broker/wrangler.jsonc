{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitbash-secrets-broker",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Explicitly preserve remote secrets on normal deploys; declared vars still override their old values.
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "BROKER_STATE", "class_name": "BrokerState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrokerState"] }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    // Request URLs can contain one-time GitHub codes. Record only explicit metadata logs.
    "traces": { "enabled": false }
  }
}
