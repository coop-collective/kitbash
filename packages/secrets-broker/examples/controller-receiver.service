# Replace ubuntu, example-runners and /opt/w3bstack with the enrolled identity and paths.
[Unit]
Description=w3bstack encrypted credential receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
ExecStart=/usr/local/bin/node /opt/w3bstack/runtime/scripts/controller-receiver.mjs receive /opt/w3bstack/example-runners
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/w3bstack/example-runners
