{
  "$schema": "https://kitbash.dev/schema/block.v1.json",
  "name": "email-code-auth-fixture",
  "type": "registry:block",
  "title": "Email code sign-in with hashed bearer tokens (fixture)",
  "description": "A small stand-in for BLOCK-SPEC §10's email-code-auth: six-digit email codes, single-use and attempt-limited, opaque bearer tokens stored as HMAC, and a Hono middleware that resolves the caller.",
  "author": "Coop <coop@xavalabs.com>",
  "version": "1.3.0",
  "license": "MIT",
  "categories": ["auth", "email"],
  "meta": { "maturity": "experimental", "origin": "original", "est_hours_saved": 6 },
  "stack": { "runtime": "cloudflare-workers", "framework": "hono", "db": "d1", "ui": "none", "lang": "ts", "test": "vitest-workerd" },
  "compat": { "hono": ">=4.6", "wrangler": ">=4", "node": ">=20", "typescript": ">=5.4" },
  "variants": [
    { "id": "hono-d1", "default": true, "root": "variants/hono-d1", "stack": { "framework": "hono" } }
  ],
  "params": [
    { "name": "appSlug", "type": "identifier", "default": "my-app", "description": "Short name used for resources (D1 name)." },
    { "name": "tokenPrefix", "type": "identifier", "default": "app_", "pattern": "^[a-z]{2,6}_$", "description": "Bearer token prefix; makes tokens greppable." },
    { "name": "tablePrefix", "type": "identifier", "default": "", "pattern": "^([a-z]+_)?$", "description": "Prefix for the block's tables; set when the project already has a members table." },
    { "name": "routePrefix", "type": "path", "default": "/auth", "description": "Mount point for the public routes." },
    { "name": "appDomain", "type": "string", "default": "example.com", "description": "Used for the MAIL_FROM default." },
    { "name": "codeTtlMin", "type": "integer", "default": 10, "min": 2, "max": 60 },
    { "name": "mailer", "type": "enum", "default": "email-service", "values": ["email-service", "console"], "description": "Which sender the mail module uses." }
  ],
  "files": [
    { "path": "migrations/0001_auth.sql", "type": "registry:file", "target": "{{paths.migrations}}/0001_auth.sql", "role": "migration", "variant": "hono-d1" },
    { "path": "src/auth/types.ts", "type": "registry:lib", "target": "{{paths.lib}}/auth/types.ts", "role": "lib", "variant": "hono-d1" },
    { "path": "src/auth/crypto.ts", "type": "registry:lib", "target": "{{paths.lib}}/auth/crypto.ts", "role": "lib", "variant": "hono-d1" },
    { "path": "src/auth/mail.ts", "type": "registry:lib", "target": "{{paths.lib}}/auth/mail.ts", "role": "service", "variant": "hono-d1" },
    { "path": "src/auth/codes.ts", "type": "registry:lib", "target": "{{paths.lib}}/auth/codes.ts", "role": "service", "variant": "hono-d1" },
    { "path": "src/auth/tokens.ts", "type": "registry:lib", "target": "{{paths.lib}}/auth/tokens.ts", "role": "service", "variant": "hono-d1" },
    { "path": "src/auth/middleware.ts", "type": "registry:lib", "target": "{{paths.lib}}/auth/middleware.ts", "role": "lib", "variant": "hono-d1" },
    { "path": "src/auth/routes.ts", "type": "registry:lib", "target": "{{paths.routes}}/auth.ts", "role": "route", "variant": "hono-d1" },
    { "path": "test/auth.test.ts", "type": "registry:file", "target": "{{paths.tests}}/auth.test.ts", "role": "test", "variant": "hono-d1" },
    { "path": "config/wrangler.patch.jsonc", "type": "registry:file", "target": "wrangler.jsonc", "role": "config-patch", "variant": "hono-d1", "merge": "jsonc-deep" },
    { "path": "config/dev.vars.example", "type": "registry:file", "target": ".dev.vars.example", "role": "config-patch", "variant": "hono-d1", "merge": "append-missing-lines" },
    { "path": "SKILL.md", "type": "registry:file", "target": ".kit/blocks/email-code-auth-fixture/SKILL.md", "role": "doc" }
  ],
  "dependencies": ["hono@^4.6"],
  "devDependencies": ["@cloudflare/vitest-pool-workers@>=0.8"],
  "registryDependencies": [],
  "envVars": { "MAIL_FROM": "login@example.com" },
  "env": [
    { "name": "MAIL_FROM", "secret": false, "default": "login@{{kit.appDomain}}", "description": "Sender address; the domain must be verified in Email Service." }
  ],
  "secrets": [
    { "name": "TOKEN_PEPPER", "description": "32+ random bytes; HMAC pepper for code and token hashes.", "obtain": "openssl rand -hex 32", "required": true }
  ],
  "bindings": [
    { "type": "d1", "name": "DB", "required": true, "create": "wrangler d1 create {{kit.appSlug}}" },
    { "type": "send_email", "name": "EMAIL", "required": false, "note": "Without it the code is printed in dev and sign-in is refused in production." }
  ],
  "migrations": [
    { "file": "migrations/0001_auth.sql", "name": "auth", "creates": ["{{kit.tablePrefix}}members", "{{kit.tablePrefix}}member_tokens", "{{kit.tablePrefix}}login_codes"], "idempotent": false }
  ],
  "tables": ["{{kit.tablePrefix}}members", "{{kit.tablePrefix}}member_tokens", "{{kit.tablePrefix}}login_codes"],
  "routes": [
    { "method": "POST", "path": "{{kit.routePrefix}}/email/start", "auth": "public", "description": "Send a code (5 per address per hour, 200 per 10 minutes overall)." },
    { "method": "POST", "path": "{{kit.routePrefix}}/email/verify", "auth": "public", "description": "Verify a code; returns a bearer token." },
    { "method": "GET", "path": "/api/me", "auth": "bearer", "description": "Who am I." }
  ],
  "exports": [
    { "symbol": "requireBearer", "from": "src/auth/middleware.ts", "kind": "hono-middleware" },
    { "symbol": "authenticate", "from": "src/auth/tokens.ts", "kind": "function" },
    { "symbol": "authRoutes", "from": "src/auth/routes.ts", "kind": "hono-app" }
  ],
  "ui": [],
  "tests": [
    { "file": "test/auth.test.ts", "runner": "vitest-workerd", "covers": ["codes", "tokens", "middleware"] }
  ],
  "verify": {
    "commands": ["npx vitest run {{paths.tests}}/auth.test.ts", "npx tsc --noEmit"],
    "expect": "all pass"
  },
  "docs": "docs/README.md",
  "skill": "SKILL.md",
  "agent": {
    "summary": "Adds email-code sign-in and bearer tokens to a Hono Worker. Three tables, three routes, one middleware. Needs a D1 binding and, in production, an Email Service binding.",
    "when_to_use": ["The app needs accounts without passwords or OAuth.", "A CLI or MCP server needs opaque bearer tokens."],
    "when_not_to_use": ["You need OAuth providers.", "Sessions must be cookie-based for a browser app."],
    "adapt": [
      { "id": "mount-routes", "required": true, "title": "Mount the auth routes", "where": "{{paths.app}}/index.ts", "do": "import { authRoutes } from './routes/auth'; app.route('{{kit.routePrefix}}', authRoutes);", "check": "POST {{kit.routePrefix}}/email/start answers 200." },
      { "id": "wire-middleware", "required": true, "title": "Protect your routes with requireBearer", "where": "{{paths.app}}/index.ts", "do": "import { requireBearer } from './lib/auth/middleware'; app.use('/api/*', requireBearer);", "check": "GET /api/me without a token returns 401." },
      { "id": "set-secrets", "required": true, "title": "Set TOKEN_PEPPER", "do": "Add TOKEN_PEPPER=<32 random bytes, hex> to .dev.vars; in production use wrangler secret put TOKEN_PEPPER.", "check": "The test suite passes; a token verifies." },
      { "id": "mail-domain", "required": false, "title": "Verify the sending domain in Email Service", "do": "Add {{kit.appDomain}} in Cloudflare Email Service and set MAIL_FROM.", "check": "{{kit.routePrefix}}/email/start delivers a mail in staging." }
    ],
    "author_notes": "Keep the global 200 per 10 minutes cap; it is what stops a code-spray attack."
  },
  "provenance": {
    "source": { "repo": "github.com/Disturbing/ideator", "commit": "6dbd04b", "paths": ["packages/api/src/auth.ts"] },
    "origin": "original",
    "harvested_by": "agent"
  }
}
