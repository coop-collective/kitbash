+  TOKEN_PEPPER?: string;
+  MAIL_FROM?: string;
+  ENVIRONMENT?: string;
+  EMAIL?: { send(message: { from: string; to: string; subject: string; text: string }): Promise<unknown> };
+}
+
+export interface Member {
