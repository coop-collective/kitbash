{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitbash.dev/schema/block.v1.json",
  "title": "Kitbash block manifest (block.json) v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "type": {
      "type": "string",
      "const": "registry:block"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{1,64}$"
    },
    "categories": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "maturity": {
          "type": "string",
          "enum": [
            "experimental",
            "beta",
            "production"
          ]
        },
        "origin": {
          "type": "string",
          "maxLength": 64
        },
        "network_hosts": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253
          }
        },
        "est_hours_saved": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": {}
    },
    "stack": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "framework": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "db": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "ui": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "test": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "compat": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[@a-z0-9][a-z0-9@/._-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 64
      }
    },
    "variants": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "default": {
            "type": "boolean"
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "stack": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "framework": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "db": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "ui": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "lang": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "test": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              }
            },
            "additionalProperties": false
          },
          "compat": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[@a-z0-9][a-z0-9@/._-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "id",
          "root"
        ],
        "additionalProperties": false
      }
    },
    "params": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "identifier",
              "path",
              "integer",
              "boolean",
              "enum"
            ]
          },
          "default": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "pattern": {
            "type": "string",
            "maxLength": 200
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "values": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "type": {
            "type": "string",
            "pattern": "^registry:[a-z-]+$"
          },
          "target": {
            "type": "string",
            "maxLength": 512
          },
          "role": {
            "type": "string",
            "enum": [
              "migration",
              "route",
              "service",
              "ui",
              "lib",
              "test",
              "doc",
              "config-patch",
              "fixture"
            ]
          },
          "variant": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "merge": {
            "type": "string",
            "enum": [
              "jsonc-deep",
              "append-missing-lines",
              "json-merge-patch"
            ]
          },
          "template": {
            "type": "boolean"
          },
          "when": {
            "type": "string",
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "maxLength": 65536
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "type",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 214
      }
    },
    "devDependencies": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 214
      }
    },
    "registryDependencies": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 214
      }
    },
    "envVars": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    },
    "env": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "secret": {
            "type": "boolean"
          },
          "default": {
            "type": "string",
            "maxLength": 500
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "secrets": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "obtain": {
            "type": "string",
            "maxLength": 300
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "bindings": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "d1",
              "kv",
              "r2",
              "send_email",
              "queue",
              "durable_object",
              "service",
              "ai",
              "vectorize",
              "analytics_engine",
              "hyperdrive",
              "rate_limit",
              "browser",
              "workflow",
              "images",
              "assets",
              "version_metadata",
              "secrets_store"
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
              },
              {
                "type": "string",
                "pattern": "^\\{\\{kit\\.[A-Za-z_][A-Za-z0-9_]{0,63}\\}\\}$"
              }
            ]
          },
          "required": {
            "type": "boolean"
          },
          "create": {
            "type": "string",
            "maxLength": 300
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "migrations": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,64}$"
          },
          "creates": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "idempotent": {
            "type": "boolean"
          }
        },
        "required": [
          "file",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "tables": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "routes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS",
              "ALL"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 256
          },
          "auth": {
            "type": "string",
            "enum": [
              "public",
              "bearer",
              "session",
              "admin"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "method",
          "path",
          "auth"
        ],
        "additionalProperties": false
      }
    },
    "exports": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,127}$"
              },
              {
                "type": "string",
                "pattern": "^\\{\\{kit\\.[A-Za-z_][A-Za-z0-9_]{0,63}\\}\\}$"
              }
            ]
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "symbol",
          "from"
        ],
        "additionalProperties": false
      }
    },
    "ui": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "tests": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "runner": {
            "type": "string",
            "maxLength": 64
          },
          "covers": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "file",
          "runner"
        ],
        "additionalProperties": false
      }
    },
    "verify": {
      "type": "object",
      "properties": {
        "commands": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "expect": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    },
    "docs": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "agent": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "when_to_use": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "when_not_to_use": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "adapt": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "required": {
                "type": "boolean"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "where": {
                "type": "string",
                "maxLength": 500
              },
              "do": {
                "type": "string",
                "maxLength": 1500
              },
              "check": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "required",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "author_notes": {
          "type": "string",
          "maxLength": 1500
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "maxLength": 300
            },
            "commit": {
              "type": "string",
              "maxLength": 64
            },
            "paths": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 512
              }
            }
          },
          "required": [
            "repo"
          ],
          "additionalProperties": false
        },
        "origin": {
          "type": "string",
          "enum": [
            "original",
            "harvested-own",
            "packaged-oss"
          ]
        },
        "harvested_by": {
          "type": "string",
          "enum": [
            "agent",
            "person"
          ]
        },
        "harvested_at": {
          "type": "string",
          "maxLength": 40
        },
        "publisher": {
          "type": "object",
          "properties": {
            "org": {
              "type": "string",
              "maxLength": 64
            },
            "member": {
              "type": "string",
              "maxLength": 64
            },
            "key_id": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "org"
          ],
          "additionalProperties": false
        },
        "contributors": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "member": {
                "type": "string",
                "maxLength": 64
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "proposals": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            },
            "required": [
              "member"
            ],
            "additionalProperties": false
          }
        },
        "signature": {
          "type": "string",
          "maxLength": 200
        },
        "registry_signature": {
          "type": "string",
          "maxLength": 200
        },
        "scan": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "sandbox": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "forked_from": {
          "type": "object",
          "properties": {
            "block": {
              "type": "string",
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
            }
          },
          "required": [
            "block",
            "version"
          ],
          "additionalProperties": false
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "fork",
            "mirror",
            "inspired"
          ]
        }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "summary_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "files",
        "lines"
      ],
      "additionalProperties": false
    },
    "cssVars": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "css": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "tailwind": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "name",
    "type",
    "title",
    "description",
    "version",
    "license",
    "stack",
    "variants",
    "files"
  ],
  "additionalProperties": false
}
