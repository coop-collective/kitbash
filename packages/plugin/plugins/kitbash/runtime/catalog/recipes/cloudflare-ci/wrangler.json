{
  "name": "kitbash-ci-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "env": {
    "staging": {
      "name": "kitbash-ci-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kitbash-ci-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "kitbash-ci-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kitbash-ci-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
