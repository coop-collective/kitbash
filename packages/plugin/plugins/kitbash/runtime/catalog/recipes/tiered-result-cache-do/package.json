{
  "name": "@kitbash/recipe-tiered-result-cache-do",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare:cache": "node prepare.mjs",
