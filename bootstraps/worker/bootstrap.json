{
  "id": "worker",
  "title": "Cloudflare Worker",
  "description": "Hono API with D1 migrations and workerd integration tests.",
  "defaultHost": "127.0.0.1",
  "defaultPort": 8787,
  "profile": {
    "stack": {
      "runtime": "cloudflare-workers",
      "framework": "hono",
      "db": "d1",
      "ui": "none",
      "lang": "ts",
      "test": "vitest-workerd"
    },
    "paths": {
      "app": "src",
      "routes": "src/routes",
      "lib": "src/lib",
      "ui": "src/components",
      "migrations": "migrations",
      "tests": "test"
    },
    "migrations": {
      "pattern": "NNNN_name.sql",
      "width": 4
    },
    "package_manager": "pnpm",
    "config": {
      "env_example": ".dev.vars.example",
      "wrangler": "wrangler.jsonc"
    }
  },
  "compatibleBlocks": [
    "crypto-utils",
    "session-cookie",
    "jwt-session-cookie",
    "api-keys",
    "email-code-auth",
    "cli-oauth-login",
    "d1-rate-limit",
    "member-profiles",
    "orgs-roles-invites",
    "r2-private-uploads",
    "cf-email-sender",
    "cf-analytics",
    "public-edge-cache",
    "tiered-result-cache",
    "hibernating-websocket",
    "cloudflare-container"
  ],
  "compatibilityDate": "2026-08-22"
}
